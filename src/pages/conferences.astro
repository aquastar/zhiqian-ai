---
import Layout from '../layouts/Layout.astro';
import { ranked, others, notable } from '../data/conferences.js';
import { topicRates } from '../data/topics.js';
import { destinations } from '../data/destinations.js';

const SOCIETY = 'Society meetings';
const AREAS = ['AI / ML / Data Mining', 'Security & Medicine', SOCIETY];
const AREA_SHORT = {
  'AI / ML / Data Mining': 'AI · ML · Data Mining',
  'Security & Medicine': 'Other',
  [SOCIETY]: 'Society meetings',
};
const slug = (a) => a.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');
// Each field gets one icon and one hue, used identically in the filter and in
// every row, so the two can be matched at a glance instead of by reading.
const AREA_ICON = {
  'AI / ML / Data Mining': 'fa-brain',
  'Security & Medicine': 'fa-layer-group',
  [SOCIETY]: 'fa-people-group',
};
const DEFAULT_AREA = 'AI / ML / Data Mining';
const AR_REPO = 'https://github.com/lixin4ever/Conference-Acceptance-Rate';
// Fixed 0-45% scale: the point of the bars is to compare venues to each other,
// which a per-row scale would destroy.
const RATE_MAX = 45;
// Wide on purpose. At 180 the chart used a little over half its column and
// the rest of the cell was empty, which is most of what made this table look
// padded. The geometry itself grows rather than the drawing being stretched,
// so the line keeps its weight and the dot stays round.
const CHART = { w: 300, h: 38 };
// A line over the whole published history, on a fixed axis so two venues can
// be compared by eye. The three most recent numbers are printed underneath,
// because that is what anyone actually wants off this cell.
const chart = (rates) => {
  if (!rates || rates.length < 2) return null;
  const xs = rates.map((p, i) => (i / (rates.length - 1)) * CHART.w);
  const y = (r) => CHART.h - (Math.min(r, RATE_MAX) / RATE_MAX) * CHART.h;
  const pts = rates.map((p, i) => [xs[i], y(p.r)]);
  // Path and its length, both needed by the draw-on animation: the dash
  // trick needs the length, and the dot rides the same path.
  const d = pts.map(([px, py], i) => `${i ? 'L' : 'M'}${px.toFixed(1)},${py.toFixed(1)}`).join(' ');
  const len = pts.slice(1).reduce(
    (a, [px, py], i) => a + Math.hypot(px - pts[i][0], py - pts[i][1]), 0);
  return {
    d, len: Math.ceil(len),
    last: { x: xs[xs.length - 1], y: y(rates[rates.length - 1].r) },
    grid: [10, 20, 30, 40].map((v) => ({ v, y: y(v) })),
    span: `${rates[0].y}\u2013${rates[rates.length - 1].y}`,
  };
};
const AR_REPO_OLD = 'https://github.com/lixin4ever/Conference-Acceptance-Rate';
const CSC = 'https://csconfstats.xoveexu.com/conferences';
const DBLP = 'https://dblp.org/db/conf';
const BEST = 'https://jeffhuang.com/best_paper_awards/conferences.html';
const MAX_ROUNDS = 3;

// Per-topic acceptance, newest edition, with the change against the one
// before it. Scaled to the spread rather than to zero, because every topic
// sits between about 25 and 50 percent and a zero baseline flattens them.
const SPARK = { w: 34, h: 13 };
const RATE_CEIL = 100;   // a rate is read against 100, not against the table's max
const hiOf = () => RATE_CEIL;
const topicBlocks = Object.entries(topicRates).map(([venue, eds]) => {
  const now = eds[0];
  const prev = eds[1];
  const years = eds.map((e) => e.year).reverse();
  const rates = now.topics.map((t) => t.rate);
  const lo = 0;
  const hi = RATE_CEIL;
  return {
    venue, year: now.year, overall: now.overall, decided: now.decided,
    selected: (now.selected || []).map((x) => ({ ...x, pct: Math.min(x.rate / hiOf(now), 1) * 100 })),
    headline: now.headline, submitted: now.submitted,
    accepted: now.accepted, withdrawn: now.withdrawn,
    prevYear: prev ? prev.year : null, lo, hi,
    rows: now.topics.map((t) => {
      const before = prev ? prev.topics.find((x) => x.area === t.area) : undefined;
      const d = (now_, then_) => (then_ === undefined ? null : Math.round((now_ - then_) * 10) / 10);
      // One point per edition the topic existed in. ICLR added three areas in
      // 2025, so those series are shorter and start where the topic does.
      const series = years
        .map((y) => {
          const ed = eds.find((e) => e.year === y);
          const row = ed && ed.topics.find((x) => x.area === t.area);
          return row ? { y, rate: row.rate } : null;
        })
        .filter(Boolean);
      // The sparkline keeps a zoomed vertical scale so a two point move is
      // visible. It is a shape, not a length anyone compares to a number.
      const slo = Math.floor(Math.min(...series.map((pt) => pt.rate)) - 2);
      const shi = Math.ceil(Math.max(...series.map((pt) => pt.rate)) + 2);
      const sp = series.length > 1
        ? series.map((pt, i) => `${((i / (series.length - 1)) * SPARK.w).toFixed(1)},${(SPARK.h - ((pt.rate - slo) / (shi - slo || 1)) * SPARK.h).toFixed(1)}`)
        : null;
      return { ...t, delta: d(t.rate, before && before.rate),
               shareDelta: d(t.share, before && before.share),
               series, spark: sp ? sp.join(' ') : null,
               sparkLast: sp ? sp[sp.length - 1].split(',') : null,
               pct: ((t.rate - lo) / (hi - lo)) * 100 };
    }),
  };
});
const CSR = 'https://csrankings.org/';
// Google Scholar Metrics has no API, so the h5-index itself is not pulled in.
// What is linkable is the category page, which is the field-native ranking.
// Every slug below was opened and confirmed to resolve. Society meetings get
// no link: they publish no papers, so Scholar Metrics does not index them.
const GSM = 'https://scholar.google.com/citations?view_op=top_venues&hl=en&vq=';
const SCHOLAR = {
  'AI / ML / Data Mining': GSM + 'eng_artificialintelligence',
  'Security & Medicine': GSM + 'eng_computersecuritycryptography',
  'Society meetings': '',
};
const TIER = { 1: 'Top', 2: 'Strong', 3: 'Listed' };

const coreLabel = { 'A*': 'A*', A: 'A', B: 'B', C: 'C', TBR: 'TBR', JP: 'jrnl', N: 'n/a' };
const coreClass = (c) => `core-${c === 'A*' ? 'as' : c.toLowerCase()}`;

// Acceptance rates are only as fresh as the upstream table; anything before
// this is shown with the year called out rather than quietly passed off as current.
const FRESH_FROM = 2024;

// One list, ordered by the date a reader can still act on.
//
// Not the first date in the file: by the time anyone reads this page some of
// those have passed. Within a venue the rule is the one a submitter actually
// follows. While a round's abstract deadline is open, that is the date that
// counts, because missing it shuts the round. Once it closes, the full paper
// date takes over. A venue with nothing ahead of it has finished its cycle,
// so it rolls a year forward and sorts to the end, out of the way of
// everything still live. The page is static and rebuilt weekly, so the same
// rule runs again in the browser against the reader's own today.
const ymd = (d) => d.toISOString().slice(0, 10);
const TODAY = ymd(new Date());
const rollYear = (iso) => {
  if (!iso) return '';
  const [y, m, d] = iso.split('-').map(Number);
  const nd = new Date(Date.UTC(y + 1, m - 1, d));
  if (nd.getUTCMonth() !== m - 1) nd.setUTCDate(0);   // Feb 29 lands on Feb 28
  return ymd(nd);
};
const roundsOf = (c) => (c.rounds && c.rounds.length
  ? c.rounds
  : c.nextDeadline ? [{ d: c.nextDeadline, abs: c.nextAbstract || '' }] : []);
// A commitment round is not a date you can submit new work to. The ARR
// venues run one submission deadline and then a commitment deadline months
// later, open only to papers that already have ARR reviews. Counting that as
// the venue's next deadline kept NAACL near the top of the table on a date
// nobody can act on. Only submission rounds decide whether a venue is still
// open; the commitment date stays on the page, it just does not sort.
const isSubmission = (r) => !/commitment/i.test(r.label || '');
const liveDate = (c) => {
  const rs = roundsOf(c);
  // Nothing on record is not the same as everything having passed. A society
  // meeting that publishes no call has no cycle to roll forward, so it sorts
  // last without an estimate it cannot support.
  if (!rs.length) return { key: '', expired: false };
  const subs = rs.filter(isSubmission);
  const pool = subs.length ? subs : rs;
  for (const r of pool) {
    if (r.abs && r.abs >= TODAY) return { key: r.abs, expired: false };
    if (r.d && r.d >= TODAY) return { key: r.d, expired: false };
  }
  return { key: rollYear(pool[0].d), expired: true };
};

// Society meetings are a different kind of thing and no longer share the
// table. A table's columns are acceptance rate, rank and deadline, and all
// three are blank for a meeting that reviews nothing and ranks nowhere, so
// the row said almost nothing while looking like it should. They are cards
// now, led by what the meeting is and why it matters, which is the part a
// visitor from another field actually needs.
const society = notable
  .map((c) => ({ ...c, society: true, live: liveDate(c) }))
  .sort((a, b) => (a.live.key || '9999').localeCompare(b.live.key || '9999'));
const all = ranked.map((c) => ({ ...c, live: liveDate(c) }));
// One date order, no buckets. A venue that has finished its cycle sinks on
// its own merits, because a date rolled a year forward is a year away. It
// does not need a separate block to put it there, and a block would split it
// from the venues whose next call is genuinely that far out anyway.
const dated = all.filter((c) => c.live.key).sort((a, b) => a.live.key.localeCompare(b.live.key));
const undated = all.filter((c) => !c.live.key).sort((a, b) => a.title.localeCompare(b.title));
const rows = [...dated, ...undated].map((c) => ({ ...c, chart: chart(c.rates) }));

// Society meetings are no longer table rows, so their chip has to be counted
// from the card list instead, or the field would vanish from the filter.
const counts = AREAS.map((a) => ({
  area: a,
  n: a === SOCIETY ? society.length : rows.filter((c) => c.area === a).length,
})).filter((x) => x.n);
const totalRated = rows.filter((c) => c.rates.length).length;
const freshRated = rows.filter((c) => c.rates.length && c.rates[c.rates.length - 1].y >= FRESH_FROM).length;

---
<Layout title="Conferences | Zhiqian Chen">
  <main class="container">
    <nav class="top-nav" aria-label="Sections">
      <a href="/">Home</a>
      <a href="/research">Research</a>
      <a href="/agenda">Agenda</a>
      <a href="/people">People</a>
      <a href="/teach">Talk &amp; Teach</a>
      <a href="https://scholar.google.com/citations?user=NC3-O6UAAAAJ&hl=en&oi=ao" target="_blank" rel="noopener">Paper <i class="ai ai-google-scholar-square ai-sm nav-ghost"></i> <i class="fas fa-arrow-up-right-from-square nav-ghost"></i></a>
      <a href="https://substack.com/@zhiqianchen1" target="_blank" rel="noopener">Zhiqian's Note <svg class="nav-ghost nav-substack" viewBox="0 0 24 24" fill="currentColor" width="11" height="11" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg> <i class="fas fa-arrow-up-right-from-square nav-ghost"></i></a>
      <a class="nav-right-start" href="/conferences" aria-current="page">Conferences</a>
      <a href="/funding">Funding</a>
    </nav>

    <section class="head">
      <div class="filter" role="group" aria-label="Filter by field">
        {counts.map((c) => (
          <button class={`fbtn area-${slug(c.area)}${c.area === DEFAULT_AREA ? ' is-on' : ''}`} data-area={slug(c.area)} type="button" data-scholar={SCHOLAR[c.area] || ''}>
            <i class={`fas ${AREA_ICON[c.area]}`} aria-hidden="true"></i>{AREA_SHORT[c.area]}<span class="fcount">{c.n}</span>
          </button>
        ))}
        <button class="fbtn fbtn-dest" data-area="destinations" type="button">
          <i class="fas fa-plane-departure" aria-hidden="true"></i>By destination<span class="fcount">{destinations.items.length}</span>
        </button>
        <a class="scholar-link" id="scholar-link" href={SCHOLAR[DEFAULT_AREA]} target="_blank" rel="noopener"
           title="This field's h5-index ranking on Google Scholar Metrics, journals and conferences together">
          h5-index <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
        </a>
      </div>

      <ul class="legend" id="legend">
        <li><span class="tier-tag tt-1">Top</span> CCF A or CORE A*</li>
        <li><span class="tier-tag tt-2">Strong</span> CCF B or CORE A</li>
        <li><span class="tier-tag tt-3">Listed</span> unranked, importance stated</li>
        <li class="legend-gap"><span class="chip band-urgent"></span>&lt;30d</li>
        <li><span class="chip band-soon"></span>30&ndash;90</li>
        <li><span class="chip band-far"></span>90+</li>
        <li><span class="rounds-tag">2&times;</span>cycles / year</li>
        <li><span class="est-tag">est.<i class="fas fa-circle-question" aria-hidden="true"></i></span>estimated from last year</li>
        <li><span class="abs-line"><b>abstract</b></span>abstract due before the paper</li>
      </ul>
    </section>

    {topicBlocks.map((b) => (
      <section class="section topic-section" data-topic-area={slug(DEFAULT_AREA)}>
        <details class="rest topics lead" open>
          <summary>
            <h2>Which topics get in</h2>
            <span class="rest-count">{b.venue} {b.year}</span>
            <span class="rest-note">
            {b.submitted.toLocaleString()} submitted, {b.accepted.toLocaleString()} accepted, {b.headline}% overall
          </span>
          </summary>
          <div class="topic-head">
            <span class="th-rate" title={`Of the ${b.decided.toLocaleString()} submissions that reached a decision. The ${b.withdrawn.toLocaleString()} withdrawn before one are excluded, which is why these read higher than the ${b.headline}% headline.`}>acceptance rate</span>
            <span class="th-topic">topic</span>
            <span class="th-share th-mute">% of submissions</span>
            <span class="th-trend">trend</span>
          </div>
          <ul class="topic-list">
            {b.rows.map((t) => (
              <li class={t.papers ? 'has-papers' : ''}>
                <span class="t-rate">{t.rate}%</span>
                <span class={`t-drate ${(t.delta || 0) > 0 ? 't-up' : (t.delta || 0) < 0 ? 't-down' : 't-flat'}`}
                      title={t.delta === null ? '' : `${b.prevYear}: ${Math.round((t.rate - t.delta) * 10) / 10}%`}>{t.delta === null ? '' : <>{(t.delta > 0 ? '+' : '') + t.delta}<i>%</i></>}</span>
                <span class="t-bar"><span class="t-fill" style={`width:${t.pct.toFixed(1)}%`}></span></span>
                <span class="t-name">{t.area}{t.papers && <span class="t-open">{t.papers.length} papers <i class="fas fa-angle-down" aria-hidden="true"></i></span>}</span>
                <span class="t-share" title={`${t.n} decided submissions`}>{t.share}%</span>
                <span class="t-dshare" title={t.shareDelta === null ? '' : `${b.prevYear}: ${Math.round((t.share - t.shareDelta) * 10) / 10}%`}>{t.shareDelta === null ? '' : <>{(t.shareDelta > 0 ? '+' : '') + t.shareDelta}<i>%</i></>}</span>
                {t.spark
                  ? <svg class="t-spark" viewBox={`-1 -2 ${SPARK.w + 2} ${SPARK.h + 4}`} width={SPARK.w + 2} height={SPARK.h + 4}
                         role="img" aria-label={t.series.map((pt) => `${pt.y} ${pt.rate}%`).join(', ')}>
                      <title>{t.series.map((pt) => `${pt.y}: ${pt.rate}%`).join('\n')}</title>
                      <polyline points={t.spark} />
                      <circle cx={t.sparkLast[0]} cy={t.sparkLast[1]} r="1.8" />
                    </svg>
                  : <span class="t-dshare">new</span>}
                {t.papers && (
                  <ol class="t-papers">
                    {t.papers.map((pp) => (
                      <li>
                        <span class="pp-n"></span>
                        <span class="pp-c" title="Google Scholar citations">{pp.c}</span>
                        <span class={`pp-k pp-${pp.k.toLowerCase()}`}>{pp.k}</span>
                        <span class="pp-y">{pp.y}</span>
                        {pp.u ? <a href={pp.u} target="_blank" rel="noopener">{pp.t}</a> : <span>{pp.t}</span>}
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ))}
          </ul>
          {b.selected.length > 0 && (
            <details class="sel-block">
              <summary class="sel-head">
                Selected topics <span class="sel-count">{b.selected.length}</span>
                <em>matched on author keywords, so they cut across the areas above</em>
                <i class="fas fa-angle-down sel-arrow" aria-hidden="true"></i>
              </summary>
              <ul class="topic-list sel-list">
                {b.selected.map((x) => (
                  <li class={x.papers ? 'has-papers' : ''}>
                    <span class="t-rate">{x.rate}%</span>
                    <span class={`t-drate ${(x.delta || 0) > 0 ? 't-up' : (x.delta || 0) < 0 ? 't-down' : 't-flat'}`}
                          title={x.delta === null
                            ? `No change shown: only ${x.prevN} matching papers in ${b.prevYear}, too few for the rate to mean anything`
                            : `${b.prevYear}: ${Math.round((x.rate - x.delta) * 10) / 10}%`}>{x.delta === null ? <span class="t-flat">&middot;</span> : <>{(x.delta > 0 ? '+' : '') + x.delta}<i>%</i></>}</span>
                    <span class="t-bar"><span class="t-fill" style={`width:${x.pct.toFixed(1)}%`}></span></span>
                    <span class="t-name">{x.label}{x.papers && <span class="t-open">{x.papers.length} papers <i class="fas fa-angle-down" aria-hidden="true"></i></span>}<span class="sel-home">most of them in {x.area} ({x.concentration}%)</span></span>
                    <span class="t-share" title="decided submissions matching this term">{x.n}</span>
                    <span class="t-dshare"></span>
                    <span class="t-dshare"></span>
                    {x.papers && (
                      <ol class="t-papers">
                        {x.papers.map((pp) => (
                          <li>
                            <span class="pp-n"></span>
                            <span class="pp-c" title="Google Scholar citations">{pp.c}</span>
                            <span class={`pp-k pp-${pp.k.toLowerCase()}`}>{pp.k}</span>
                            <span class="pp-y">{pp.y}</span>
                            {pp.u ? <a href={pp.u} target="_blank" rel="noopener">{pp.t}</a> : <span>{pp.t}</span>}
                          </li>
                        ))}
                      </ol>
                    )}
                  </li>
                ))}
              </ul>
            </details>
          )}
        </details>
      </section>
    ))}

    <section class="section dest-section" id="destinations" hidden>
      <div class="dest-pick">
        {destinations.places.map((d, i) => (
          <button class={`dbtn${i === 0 ? ' is-on' : ''}`} data-dest={d.name} type="button">
            <i class={`fas fa-${d.icon}`} aria-hidden="true"></i>{d.name}<span class="fcount">{d.n}</span>
          </button>
        ))}
      </div>
      <div class="table-wrap">
        <table class="confs dest-table">
          <thead>
            <tr>
              <th class="c-name">Conference</th>
              <th class="c-date">Deadline</th>
              <th class="c-when">When and where</th>
              <th class="c-rank">Ranking</th>
            </tr>
          </thead>
          <tbody>
            {destinations.items.map((it) => (
              <tr data-dest={it.dest} data-place={it.q} hidden>
                <td class="c-name">
                  <span class="name-line">
                    <a class="conf-name" href={it.link} target="_blank" rel="noopener">{it.title}</a>
                    <span class="ed-ord">{it.year}</span>
                  </span>
                  <span class="conf-desc">{it.desc}</span>
                </td>
                <td class="c-date" data-label="Deadline">
                  <span class="dl">{it.deadline || 'not published'}</span>
                  {it.deadline && <span class={it.open ? 'dl-days' : 'dl-days band-past'} data-deadline={it.open ? it.deadline : ''}>{it.open ? '' : 'closed'}</span>}
                </td>
                <td class="c-when" data-label="When and where">
                  <span class="when">{it.date}</span>
                  <span class="where">{it.place}</span>
                </td>
                <td class="c-rank" data-label="Ranking">
                  <span class={`pill ccf-${it.ccf.toLowerCase()}`}>CCF {it.ccf === 'N' ? 'n/a' : it.ccf}</span>
                  <span class={`pill ${coreClass(it.core)}`}>CORE {coreLabel[it.core] || 'n/a'}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="dest-none" hidden>Nothing announced there yet.</p>
      <p class="area-note">
        {destinations.items.length} upcoming editions across {destinations.places.length} destinations, each one a
        place rather than a category, so cities, countries and regions sit side by side. Only venues at CCF A or B,
        or CORE A* or A, plus a handful added by hand because they belong here whatever the tables say. A call
        marked open still has a deadline ahead of today.
      </p>
    </section>

    <section class="section society-section" id="society" hidden>
      <p class="society-lede">
        These are not conferences in the reviewing sense, which is why they have no acceptance
        rate and no rank. You send a short abstract, not a paper, and the normal outcome is a
        slot: a talk if the committee picks yours out, a poster otherwise. The selection that
        happens is mostly between those two, not between in and out. Nothing is archived as a
        publication either, so presenting here does not spend your paper. Each card says what
        the meeting is, how large it is, and what it would be for.
      </p>
      <div class="society-grid">
        {society.map((c) => (
          <article class="soc-card">
            <header class="soc-head">
              <h3>
                {c.link ? <a href={c.link} target="_blank" rel="noopener">{c.title}</a> : c.title}
              </h3>
              <span class={`proc proc-${c.proceedings}`}>
                {c.proceedings === 'optin' ? 'opt-in proceedings' : 'no proceedings'}
              </span>
            </header>
            <p class="soc-desc">{c.desc}</p>
            {c.note && <p class="soc-note">{c.note}</p>}
            <dl class="soc-facts">
              <div>
                <dt>Abstract due</dt>
                <dd>
                  {c.live.key
                    ? <span class="soc-when">
                        <span class={`dl ${c.estimated ? 'is-est' : ''}`}>{c.live.key}</span>
                        <span class="dl-days" data-deadline={c.live.key}></span>
                      </span>
                    : <span class="none">not announced</span>}
                </dd>
              </div>
              <div>
                <dt>Meeting</dt>
                <dd>{c.date || <span class="none">not scheduled</span>}</dd>
              </div>
              <div>
                <dt>Where</dt>
                <dd>{c.place
                  ? <span class="soc-place">{c.cc && <span class={`fi fi-${c.cc}`} aria-hidden="true"></span>}{c.place}</span>
                  : <span class="none">not announced</span>}</dd>
              </div>
            </dl>
          </article>
        ))}
      </div>
      <p class="area-note">
        {society.length} meetings, chosen because a computing researcher might realistically
        present at one. Attendance figures and review practice come from each society's own
        pages, read at the time of writing rather than taken from a ranking table, since no
        ranking table covers them.
      </p>
    </section>

    <section class="section">
      <div class="table-wrap">
        <table class="confs">
          <thead>
            <tr>
              <th class="c-name">Conference and edition</th>
              <th class="c-date">Next deadline</th>
              <th class="c-rate">Acceptance</th>
              <th class="c-rank">Ranking</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((c, i) => {
              const last = c.rates.length ? c.rates[c.rates.length - 1] : null;
              const stale = last && last.y < FRESH_FROM;
              return (
              <tr class={`tier-${c.tier}${c.live.expired ? ' is-spent' : ''}`} data-area={slug(c.area)}>
                <td class="c-name">
                  <span class={`tier-tag tt-${c.tier}`}>{TIER[c.tier]}</span>
                  <span class="name-line">
                    {c.link
                      ? <a class="conf-name" href={c.link} target="_blank" rel="noopener">{c.title}</a>
                      : <span class="conf-name">{c.title}</span>}
                    {c.cycles > 1 && <span class="rounds-tag" title={c.roundLabels.join(' · ')}>{c.cycles}&times;</span>}
                    {c.notable && !c.society && <span class="new-tag">emerging</span>}
                    {c.society && <span class={`proc proc-${c.proceedings}`}>{c.proceedings === 'optin' ? 'opt-in proceedings' : 'no proceedings'}</span>}
                  </span>
                  <span class="conf-desc">{c.desc}</span>
                  {(c.dblp || c.best) && (
                    <span class="links">
                      {c.dblp && <a href={`${DBLP}/${c.dblp}/index.html`} target="_blank" rel="noopener" title="Every past edition's proceedings, on DBLP">past proceedings</a>}
                      {c.best && <a href={`${BEST}#${c.best}`} target="_blank" rel="noopener" title="Best-paper awards since 1996, Jeff Huang's compilation">best papers</a>}
                    </span>
                  )}
                  {c.note && <p class="why">{c.note}</p>}
                  <span class="ed-line">
                    {c.edition && <span class="ed-ord" title="Edition number, projected from the last one on record">{c.edition}</span>}
                    {c.nextYear && !(c.date || '').includes(String(c.nextYear)) ? <span class="ed">{c.nextYear}</span> : null}
                    {c.date ? <span class="when">{c.date}</span> : <span class="none">not yet scheduled</span>}
                    {c.place && <span class="where">{c.cc && <span class={`fi fi-${c.cc}`} aria-hidden="true"></span>}{c.place}</span>}
                  </span>
                  {c.city && (
                    <ul class="city">
                      {c.city.split(', ').map((bit) => <li>{bit}</li>)}
                    </ul>
                  )}
                </td>
                <td class="c-date" data-label="Next deadline">
                  {/* Every cycle here has closed. The next one is a year on
                      from the last call, which is an estimate and is drawn as
                      one. Rendered on the server even when the row is still
                      live, so the browser can reveal it later in the week
                      without losing the scoped styles. */}
                  {c.live.key && (
                  <div class="round rolled" hidden={!c.live.expired}>
                    <span class="dl is-est">{c.live.key}</span>
                    <span class="dl-days" data-deadline={c.live.key}></span>
                    <span class="est-tag" title="This cycle has closed. Estimated by rolling the last call a year forward.">est.<i class="fas fa-circle-question" aria-hidden="true"></i></span>
                    <span class="round-label">next cycle, a year on from the last call</span>
                  </div>
                  )}
                  {c.rounds && c.rounds.length
                    ? <>
                        {c.rounds.slice(0, MAX_ROUNDS).map((r) => (
                          <div class="round">
                            {r.abs && (
                              <span class="abs-line" data-abs={r.abs}
                                    title={`Abstract due ${r.abs}, ${Math.round((Date.parse(r.d) - Date.parse(r.abs)) / 86400000)} days before the paper`}>
                                <b>abstract</b>{r.abs}<span class="abs-days"></span>
                              </span>
                            )}
                            <span class={`dl ${r.est ? 'is-est' : ''}`}>{r.d}</span>
                            <span class="dl-days" data-deadline={r.d}></span>
                            {r.est && <span class="est-tag" title={`Not announced yet. Estimated by rolling last year's deadline (${r.from}) forward.`}>est.<i class="fas fa-circle-question" aria-hidden="true"></i></span>}
                            {r.label && <span class="round-label">{r.label}</span>}
                          </div>
                        ))}
                        {c.rounds.length > MAX_ROUNDS && (
                          <span class="round-more" title={c.rounds.slice(MAX_ROUNDS).map((r) => r.d).join(', ')}>
                            +{c.rounds.length - MAX_ROUNDS} more rounds
                          </span>
                        )}
                      </>
                    : c.nextDeadline
                    ? <div class="round">
                        <span class={`dl ${c.estimated ? 'is-est' : ''}`}>{c.nextDeadline}</span>
                        <span class="dl-days" data-deadline={c.nextDeadline}></span>
                        {c.estimated && <span class="est-tag" title={`Not announced yet. Estimated by rolling last year's deadline (${c.estFrom}) forward.`}>est.<i class="fas fa-circle-question" aria-hidden="true"></i></span>}
                      </div>
                    : <span class="none">date unavailable</span>}
                </td>
                <td class="c-rate" data-label="Acceptance">
                  {last
                    ? <div class={`rate ${stale ? 'is-stale' : ''}`}>
                        <div class="rate-side">
                          <a class="rate-more" href={c.rateSrc === 'csc' ? `${CSC}/${c.rateSlug}/` : `${AR_REPO_OLD}#${c.rateSection}`} target="_blank" rel="noopener" title="Full year-by-year history at the source">
                            {c.rates.length} yrs <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                          </a>
                          {stale && <span class="rate-stale-note">ends {last.y}</span>}
                        </div>
                        {c.chart && (
                          <svg class="spark" viewBox={`-2 -6 ${CHART.w + 34} ${CHART.h + 12}`} role="img" aria-label={`Acceptance rate ${c.chart.span}`}>
                            {c.chart.grid.map((g) => (
                              <>
                                <line x1="0" x2={CHART.w} y1={g.y} y2={g.y} class="grid" />
                                <text x={CHART.w + 3} y={g.y + 3} class="glab">{g.v}</text>
                              </>
                            ))}
                            <path class="line" d={c.chart.d}
                                  style={`--len:${c.chart.len}; --delay:${(i % 7) * 0.45}s`} />
                            <circle class="dot" r="2.6"
                                    style={`offset-path:path('${c.chart.d}'); --delay:${(i % 7) * 0.45}s`} />
                            <circle class="dot-end" cx={c.chart.last.x} cy={c.chart.last.y} r="2.6" />
                          </svg>
                        )}
                        <div class="rate-nums">
                          {c.rates.slice(-3).reverse().map((p) => (
                            <span class="rn"><b>{p.r}%</b><i>'{String(p.y).slice(2)}</i></span>
                          ))}
                        </div>

                      </div>
                    : <span class="none">no published rate</span>}
                </td>
                <td class="c-rank" data-label="Ranking">
                  {c.society
                    ? <span class="eqv eqv-none">{c.proceedings === 'optin' ? 'not rankable, proceedings are opt-in and not peer reviewed' : 'not rankable, no archival proceedings'}</span>
                    : c.notable
                    ? <span class="none">not ranked</span>
                    : <span class="ranks">
                        <span class={`pill ccf-${c.ccf.toLowerCase()}`} title="CCF catalogue">CCF {c.ccf === 'N' ? 'n/a' : c.ccf}</span>
                        <span class={`pill ${coreClass(c.core)}`} title={c.coreVerified ? 'Confirmed against the official CORE2023 export' : 'Not found in the official CORE2023 export'}>CORE {coreLabel[c.core]}</span>
                        {c.csr
                          ? <a class="pill csr-yes" href={CSR} target="_blank" rel="noopener" title={`Counted by CSRankings, under ${c.csr}`}>CSRanking</a>
                          : <span class="pill csr-no" title="Not on the CSRankings venue list">no CSRanking</span>}
                      </span>}
                </td>
              </tr>
            );})}
          </tbody>
        </table>
      </div>
      <p class="empty-note" hidden>No conference in this field.</p>
      <p class="area-note">
        Acceptance rates: {totalRated} of {rows.length} venues publish one, and {freshRated} of those are {FRESH_FROM} or later.
        The rest are labeled with the year they stop. The upstream compilation simply stopped updating them.
        Main track only, with Findings and workshops excluded.
      </p>
    </section>

    <section class="section">
      <details class="rest">
        <summary>
          <h2>Others</h2>
          <span class="rest-count">{others.length}</span>
        </summary>
        <ul class="rest-list">
          {others.map((c) => (
            <li>
              <a href={c.link} target="_blank" rel="noopener">{c.title}</a>
              <span class={`pill ccf-${c.ccf.toLowerCase()}`}>CCF {c.ccf === 'N' ? 'n/a' : c.ccf}</span>
              <span class={`pill ${coreClass(c.core)}`}>CORE {coreLabel[c.core]}</span>
              <span class="rest-desc">{c.desc}</span>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <section class="section sources">
      <h2 class="area-head">Where all of this comes from</h2>
      <ul class="src-list">
        <li>
          <a href="https://github.com/ccfddl/ccf-deadlines" target="_blank" rel="noopener">ccf-deadlines</a>
          <span>CCF ranks, deadlines, rounds, dates, cities</span>
        </li>
        <li>
          <a href="https://portal.core.edu.au/conf-ranks/" target="_blank" rel="noopener">CORE Portal</a>
          <span>CORE ranks, from the official CORE2023 export</span>
        </li>
        <li>
          <a href="https://csconfstats.xoveexu.com/conferences/" target="_blank" rel="noopener">CS Conf Stats</a>
          <span>Acceptance rates, accepted and submitted counts</span>
        </li>
        <li>
          <a href="https://github.com/papercopilot/paperlists" target="_blank" rel="noopener">paperlists</a>
          <span>Per-topic acceptance, from every ICLR submission</span>
        </li>
        <li>
          <a href="https://csrankings.org/" target="_blank" rel="noopener">CSRankings</a>
          <span>Which venues it counts, and under which area</span>
        </li>
        <li>
          <a href="https://jeffhuang.com/best_paper_awards/" target="_blank" rel="noopener">Best Paper Awards</a>
          <span>Award winners since 1996, for 16 of these venues</span>
        </li>
        <li>
          <a href="https://dblp.org/" target="_blank" rel="noopener">DBLP</a>
          <span>Every past edition's proceedings</span>
        </li>
        <li>
          <a href="https://scholar.google.com/citations?view_op=top_venues&hl=en" target="_blank" rel="noopener">Scholar Metrics</a>
          <span>h5-index per field, linked not imported</span>
        </li>
        <li>
          <a href="https://github.com/lixin4ever/Conference-Acceptance-Rate" target="_blank" rel="noopener">Conference-Acceptance-Rate</a>
          <span>Older rates, fallback only</span>
        </li>
        <li>
          <span class="src-plain">Official conference sites</span>
          <span>The venues neither ranking table covers, kept by hand</span>
        </li>
      </ul>
      <p class="src-note">
        <b>Updated automatically every Monday at 06:17 UTC.</b> A GitHub Action re-fetches all of the above,
        rebuilds the ranks, deadlines, rounds, acceptance rates and per-topic numbers from scratch, and commits
        only when something actually changed, which redeploys the site. Nothing on this page is typed in by hand
        except the society meetings and the venues neither ranking table covers.
      </p>
    </section>
  </main>
</Layout>

<style>
