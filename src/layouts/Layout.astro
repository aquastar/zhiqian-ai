---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
	title?: string;
}

const { title = 'Zhiqian Chen | Homepage Prototype' } = Astro.props;
const GA_ID = import.meta.env.PUBLIC_GA_ID;
const CLARITY_ID = import.meta.env.PUBLIC_CLARITY_ID;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/7.2.3/css/flag-icons.min.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons@1.9.4/css/academicons.min.css" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=et-book:wght@400;700&display=swap" />
		<title>{title}</title>
		{/* Owner opt-out. Opening any page with ?me=1 marks this browser as the
		   owner's, ?me=0 undoes it. A marked browser is not counted by Google
		   Analytics, Clarity or Vercel Analytics, so the site statistics show
		   visitors only. It is per browser, so do it once on each device. */}
		<script is:inline>
			(function () {
				var q = null;
				try {
					q = new URLSearchParams(location.search).get('me');
					if (q === '1') localStorage.setItem('zq-self', '1');
					if (q === '0') localStorage.removeItem('zq-self');
					window.__zqSelf = localStorage.getItem('zq-self') === '1';
				} catch (e) { window.__zqSelf = false; }
				window.webAnalyticsBeforeSend = function (ev) { return window.__zqSelf ? null : ev; };
				if (q === '1' || q === '0') {
					document.addEventListener('DOMContentLoaded', function () {
						var n = document.createElement('div');
						n.textContent = q === '1' ? 'This browser is now excluded from site statistics.' : 'This browser is counted in site statistics again.';
						n.style.cssText = 'position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:9999;padding:8px 14px;border-radius:6px;background:#16202B;color:#F7F9FC;font-size:14px';
						document.body.appendChild(n);
						setTimeout(function () { n.remove(); }, 5000);
					});
				}
			})();
		</script>
		{GA_ID && (
			<Fragment>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
				<script is:inline define:vars={{ GA_ID }}>
					if (window.__zqSelf) window['ga-disable-' + GA_ID] = true;
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', GA_ID, { anonymize_ip: true });
				</script>
			</Fragment>
		)}
		{CLARITY_ID && (
			<script is:inline define:vars={{ CLARITY_ID }}>
				if (!window.__zqSelf) (function(c,l,a,r,i,t,y){
					c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
					t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
					y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
				})(window, document, "clarity", "script", CLARITY_ID);
			</script>
		)}
	</head>
	<body>
		<slot />
		<footer class="site-footer">
			<span>&copy; 2026 Zhiqian Chen</span>
			<span class="sep">·</span>
			<span>Designed by Zhiqian Chen</span>
			{/* Only the owner's marked browser sees this, on every page, so the
			   opt-out can be checked at a glance after the ?me=1 link is gone. */}
			<span class="self-mark" id="self-mark" hidden><span class="sep">·</span><a href="?me=0" title="Click to be counted again">not counted in this browser</a></span>
			<script is:inline>if (window.__zqSelf) document.getElementById('self-mark').hidden = false;</script>
		</footer>
		<Analytics />
		<SpeedInsights />
	</body>
</html>

<style is:global>
	/* Preview: slide house style v2. ET Book, warm neutrals, RIT orange as the one accent. */
	@font-face { font-family:'et-book'; src:url('/fonts/et-book/et-book-roman-line-figures.woff') format('woff'); font-weight:400; font-style:normal; font-display:swap; }
	@font-face { font-family:'et-book'; src:url('/fonts/et-book/et-book-display-italic-old-style-figures.woff') format('woff'); font-weight:400; font-style:italic; font-display:swap; }
	@font-face { font-family:'et-book'; src:url('/fonts/et-book/et-book-bold-line-figures.woff') format('woff'); font-weight:600 800; font-style:normal; font-display:swap; }
	body { -webkit-font-smoothing:antialiased; }
	h1, h2 { font-weight:400 !important; letter-spacing:0 !important; }
</style>
<style>
	html {
		/* Reserve the scrollbar gutter on every page: without it, short pages
		   (Teach, People) center their container 7px further right than pages
		   that scroll, and the nav visibly jumps between them. */
		scrollbar-gutter: stable;
	}
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		font-family: 'et-book', Palatino, 'Palatino Linotype', Georgia, serif;
		/* ET Book has a small x-height, so it reads a size smaller than its
		   number. Every rem on the site scales from here. */
		font-size: 19.5px;
		background: #F7F9FC;
		color: #16202B;
		line-height: 1.6;
		text-align: left;
	}
	.site-footer {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
		padding: 24px 20px 28px;
		margin-top: 32px;
		border-top: 1px solid rgba(148,163,184, 0.18);
		color: #4E5C6A;
		font-size: 0.78rem;
		text-align: center;
	}
	.site-footer .sep { opacity: 0.55; }
	.self-mark a { color: #A84600; text-decoration: none; border-bottom: 1px dotted #C45200; }
	.self-mark[hidden] { display: none; }
</style>
