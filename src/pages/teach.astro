---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

const talks = [
  {
    tag: 'Talk', year: '2026',
    title: 'From Networks to Neural Networks: What Internal Structure Tells Us About Generative Models',
    desc: 'A tutorial-style talk on the ways a trained model gets changed after release (editing, stitching, merging, pruning, steering, unlearning, fine-tuning), why exams miss what breaks inside, and how reading the model as a graph helps.',
    events: [{ label: 'PhD Colloquium · Fall 2026 · Rochester Institute of Technology, Rochester, NY' }],
    links: [
      { label: 'Slides (online)', href: 'https://aquastar.github.io/neural-networks-to-networks/', kind: 'slides' },
      { label: 'Source', href: 'https://github.com/aquastar/neural-networks-to-networks', kind: 'code' },
    ],
  },
  {
    tag: 'Tutorial', year: '2026',
    title: 'Uncertainty Quantification for Dynamical Networks',
    desc: 'Uncertainty quantification and state estimation for graph dynamics.',
    events: [
      { label: 'IEEE BigData 2026 · upcoming' },
      { label: 'WSDM 2026 · Feb 22 to 26 · Boise, ID', href: 'https://wsdm-conference.org/2026/index.php/tutorials/' },
    ],
    links: [
      { label: 'Slides (online)', href: 'https://aquastar.github.io/uq-dynamical-networks/', kind: 'slides' },
      { label: 'PDF', href: 'https://github.com/aquastar/uq-dynamical-networks/blob/master/State%20Estimation%20for%20Dynamical%20Networks.pdf', kind: 'pdf' },
    ],
  },
  {
    tag: 'Tutorial series', year: '2024–2025',
    title: 'Unifying Spectral and Spatial Graph Neural Networks',
    desc: 'An operator-level view that connects spectral and spatial GNNs.',
    events: [
      { label: 'CVPR 2024 · Jun 18 · Seattle, WA', href: 'https://cvpr.thecvf.com/virtual/2024/tutorial/23726' },
      { label: 'CIKM 2024 · Oct 21 · Boise, ID', href: 'https://cikm2024.org/tutorials/' },
      { label: 'SIAM MDS 2024 · Oct 23 · Atlanta, GA', href: 'https://meetings.siam.org/sess/dsp_programsess.cfm?SESSIONCODE=80791' },
      { label: 'SIAM SDM 2025 · May 3 · Washington, DC', href: 'https://meetings.siam.org/sess/dsp_programsess.cfm?SESSIONCODE=84896' },
      { label: '机器之心 (Synced) online talk · 2024' },
    ],
    links: [
      { label: 'Slides', href: 'https://drive.google.com/file/d/1gbe9xxNHPHHHN5DKRu3fC8f_G9TPcayt/view?usp=sharing', kind: 'slides' },
      { label: 'Awesome Spectral GNN', href: 'https://github.com/XGraph-Team/Spectral-Graph-Survey/tree/master', kind: 'code' },
    ],
  },
  {
    tag: 'Paper talk', year: '2023',
    title: 'Understanding Influence Maximization via Higher-Order Decomposition',
    desc: 'With Zonghan Zhang. Sobol indices separate a seed\'s own effect from its interactions with other seeds.',
    events: [{ label: 'SIAM SDM 2023 · Apr 27 to 29 · Minneapolis, MN', href: 'https://epubs.siam.org/doi/abs/10.1137/1.9781611977653.ch86' }],
    links: [
      { label: 'Slides (PDF)', href: 'https://aquastar.github.io/influence-max-higher-order/slides.pdf', kind: 'slides' },
    ],
  },
  {
    tag: 'Paper talk', year: '2022',
    title: 'Early Forecasting of the Impact of Traffic Accidents Using a Single Shot Observation',
    desc: '',
    events: [{ label: 'SIAM SDM 2022 · Minneapolis, MN' }],
    links: [],
  },
  {
    tag: 'Tutorial', year: '2021',
    title: 'Studying Spread Patterns of COVID-19 Based on Spatiotemporal Data',
    desc: 'With Beiyu Lin and Xiaowei Jia. Spreading models for epidemics (GNN, RNN, SIR, PDE).',
    events: [{ label: 'SIAM SDM 2021 · April · online' }],
    links: [],
  },
];

const courses = [
  { tag: 'Undergraduate', title: 'CSCI 431.02 Intro to Computer Vision', desc: 'Introductory computer vision for undergraduates.', school: 'Rochester Institute of Technology', current: true },
  {
    tag: 'Split-level', title: 'CSE 4693/6693 Intro to Machine Learning',
    desc: 'Foundations of machine learning for undergraduate and graduate students.',
    school: 'Mississippi State University',
    project: {
      title: 'LEGO Color Sorter',
      award: 'Ottilie Schillig Special Teaching Award, 2025',
      desc: 'A hands-on build that puts a classifier on a conveyor belt. A camera reads each brick as it travels, the predicted color and its confidence appear live over the video, and the LEGO hub turns the sorting table to the matching bin. A wrong call shows up immediately, as a brick in the wrong box, rather than as a number in a confusion matrix.',
      video: '/lego-sorter.mp4',
      poster: '/lego-sorter-poster.jpg',
    },
  },
  { tag: 'Split-level', title: 'CSE 4633/6633 Artificial Intelligence', desc: 'Introductory AI course spanning core concepts and methods.', school: 'Mississippi State University' },
  { tag: 'Graduate', title: 'CSE 8673 Machine Learning', desc: 'Graduate-level machine learning with emphasis on principles and applications.', school: 'Mississippi State University' },
  { tag: 'Graduate', title: 'CSE 8990 Graph Machine Learning', desc: 'Advanced topics in graph machine learning and networked intelligence.', school: 'Mississippi State University' },
];
const featured = courses.find((c) => c.project);
---
<Layout title="Talk &amp; Teach | Zhiqian Chen">
  <main class="container">
    <Nav current="teach" />
    <section class="hero">
      <h1>Talk &amp; Teach</h1>
      <p>Slides and tutorial materials, kept online for collaborators and students.</p>
    </section>
    <div class="teach-grid">
    <section class="section talks-col">
      <h2>Talks &amp; tutorials</h2>
      <ol class="talks">
        {talks.map((t) => (
          <li class="talk">
            <div class="talk-year">{t.year}</div>
            <div class="talk-body">
              <div class="talk-title">{t.title} <span class="talk-kind">{t.tag}</span></div>
              <div class="talk-events">
                {t.events.map((e) => (
                  <span class="talk-event">{e.href ? <a href={e.href} target="_blank" rel="noopener">{e.label}</a> : e.label}</span>
                ))}
              </div>
              {t.desc && <div class="talk-desc">{t.desc}</div>}
              {t.links.length > 0 && (
                <div class="talk-links">
                  {t.links.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener">[{l.label}]</a>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>
    <aside class="teach-side">
      {featured && (
        <section class="section award">
          <h2><i class="fas fa-award" aria-hidden="true"></i> Teaching award</h2>
          <div class="course-project">
            <figure class="project-media">
              <video
                class="project-video"
                src={featured.project.video}
                poster={featured.project.poster}
                preload="none"
                muted
                loop
                controls
                playsinline
                aria-label={`${featured.project.title} demonstration`}
              ></video>
            </figure>
            <div class="project-head">
              <span class="project-award">{featured.project.award}</span>
              <span class="project-title">{featured.project.title}</span>
              <span class="project-course">{featured.title} · {featured.school}</span>
            </div>
            <p class="project-desc">{featured.project.desc}</p>
          </div>
        </section>
      )}
      <section class="section">
        <h2>Courses</h2>
        <ol class="courses">
          {courses.map((c) => (
            <li class="course">
              <div class="talk-title">{c.title} <span class="talk-kind">{c.tag}</span>{c.current && <span class="talk-kind is-current">Current</span>}{c.project && <i class="fas fa-award course-star" title={c.project.award}></i>}</div>
              <div class="talk-event">{c.school}</div>
            </li>
          ))}
        </ol>
      </section>
    </aside>
    </div>
  </main>
  <script>
    // Hold the fetch back until the clip is actually on screen, then loop it
    // muted. preload="none" means nothing moves for a visitor who never
    // scrolls this far. Controls stay on throughout: the clip carries readable
    // terminal text, so being able to pause it matters. Reduced-motion and
    // Save-Data visitors are left with the poster and the play button.
    const clips = document.querySelectorAll('.project-video');
    const wantsQuiet = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      || navigator.connection?.saveData === true;
    if (clips.length && (!wantsQuiet && 'IntersectionObserver' in window)) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const video = entry.target;
          if (entry.isIntersecting) {
            // A rejected play() just leaves the poster and the control bar.
            video.play()?.catch(() => {});
          } else if (!video.paused) {
            video.pause();
          }
        });
      }, { threshold: 0.4 });
      clips.forEach((v) => observer.observe(v));
    }
  </script>
</Layout>
<style>
  :root { --accent:#2563eb; --ink:#0f172a; --muted:#475569; }
  .container { max-width: min(95vw, 1600px); margin: 0 auto; padding: 20px; box-sizing: border-box; }
  .hero { margin: 10px 0 18px; }
  .hero h1 { font-family:'Montserrat',sans-serif; font-size:2rem; margin:0 0 8px; }
  .hero p { margin:0; color:var(--muted); max-width:780px; }
  .section { padding-top:18px; margin-top:26px; border-top:none; }
  .section h2 { font-family:'Montserrat',sans-serif; font-size:1.1rem; margin:0 0 14px; }
  .cards { display:grid; gap:14px; }
  .cards.two { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .card { border:1px solid rgba(148,163,184,.16); border-radius:16px; background:#fff; padding:16px; }
  .card h3, .card p { text-align:left; }
  .card h3 { font-family:'Montserrat',sans-serif; font-size:1rem; margin:0 0 8px; }
  .card p { margin:0; color:#334155; font-size:.95rem; }
  .tags { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:8px; }
  .tag { display:inline-block; font-size:.72rem; color:var(--accent); background:#dbeafe; padding:3px 8px; border-radius:999px; }
  .tag-current { color:#166534; background:#dcfce7; font-weight:700; }
  .tag-past { color:#64748b; background:#f1f5f9; }
  .card.is-current { border-color:rgba(22,101,52,.28); }
  .school { margin:0 0 6px !important; font-size:.8rem; color:#64748b; }
  .schedule-box { border:1px dashed rgba(37,99,235,.28); border-radius:14px; padding:14px; background:#f8fbff; color:#334155; }
  /* Talks on the left, the award and the course list in a sticky column on the right. */
  .teach-grid { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(320px,1fr); gap:40px; align-items:start; }
  .teach-grid > .section, .teach-side > .section { margin-top:0; padding-top:0; }
  .teach-side { position:sticky; top:16px; display:flex; flex-direction:column; gap:22px; }
  .talks, .courses { list-style:none; margin:0; padding:0; border-top:1px solid #e2e8f0; }
  .talk { display:grid; grid-template-columns:72px 1fr; gap:12px; padding:10px 0; border-bottom:1px solid #e2e8f0; }
  .talk-year { font-family:'Montserrat',sans-serif; font-size:.78rem; color:#64748b; padding-top:2px; }
  .talk-title { text-align:left; font-family:'Montserrat',sans-serif; font-size:.9rem; font-weight:600; color:#0f172a; line-height:1.35; }
  .talk-kind { font-family:inherit; font-weight:400; font-size:.66rem; color:#64748b; border:1px solid #cbd5e1; border-radius:4px; padding:0 5px; margin-left:6px; vertical-align:2px; white-space:nowrap; }
  .talk-kind.is-current { color:#166534; border-color:#86efac; background:#f0fdf4; }
  .talk-events { display:flex; flex-wrap:wrap; gap:4px 6px; margin-top:4px; }
  .talk-events .talk-event { margin:0; padding:1px 8px; border-radius:999px; background:#f1f5f9; font-style:normal; }
  .talk-event { font-size:.78rem; color:#334155; font-style:italic; margin-top:2px; line-height:1.4; }
  .talk-event a { color:inherit; text-decoration:none; }
  .talk-event a:hover { text-decoration:underline; }
  .talk-desc { font-size:.8rem; color:#475569; margin-top:4px; line-height:1.45; text-align:left; }
  .talk-links { margin-top:3px; font-size:.78rem; display:flex; flex-wrap:wrap; gap:10px; }
  .talk-links a { color:#1d4ed8; text-decoration:none; }
  .talk-links a:hover { text-decoration:underline; }
  .course { padding:7px 0; border-bottom:1px solid #e2e8f0; }
  .course-star { color:#b45309; font-size:.75rem; margin-left:6px; }
  .award h2 i { color:#b45309; }
  .course-project { padding:12px; border:1px solid #fcd34d; border-radius:12px; background:#fffbeb; }
  .project-head { display:flex; flex-wrap:wrap; align-items:baseline; gap:4px 8px; margin:10px 0 5px; }
  .project-award { flex:0 0 100%; font-family:'Montserrat',sans-serif; font-size:.82rem; font-weight:700; color:#92400e; }
  .project-title { font-family:'Montserrat',sans-serif; font-weight:700; font-size:.9rem; color:#0f172a; }
  .project-course { text-align:left; font-size:.75rem; color:#64748b; }
  .project-desc { margin:0; font-size:.8rem; color:#475569; line-height:1.45; text-align:left; }
  .project-media { margin:0; }
  /* preload="none": the 4.8MB file is only fetched once the clip is on screen. */
  .project-video { display:block; width:100%; height:auto; border-radius:8px; background:#0f172a; }

  @media (max-width: 1000px) {
    .teach-grid { grid-template-columns:1fr; gap:26px; }
    .teach-side { position:static; order:-1; }
  }
  @media (max-width: 700px) { .talk { grid-template-columns:1fr; gap:2px; } }
  @media (max-width: 900px) { .cards.two { grid-template-columns:1fr; } }
</style>
