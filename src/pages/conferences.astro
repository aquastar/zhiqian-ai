  .open-tag { font-size:.62rem; font-weight:800; letter-spacing:.04em; text-transform:uppercase;
    color:#15803d; background:#dcfce7; border:1px solid #bbf7d0; border-radius:4px; padding:1px 6px; }
  .rounds-tag { font-size:.64rem; font-weight:800; color:#0369a1; background:#e0f2fe; border-radius:4px; padding:1px 5px; }
