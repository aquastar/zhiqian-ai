---
import Layout from '../layouts/Layout.astro';
import { ranked, others, notable } from '../data/conferences.js';
import { topicRates } from '../data/topics.js';

const SOCIETY = 'Society meetings';
const AREAS = ['AI / ML / Data Mining', 'Security & Privacy', 'Medicine, Biology & Genetics', 'Science & Interdisciplinary', SOCIETY];
const AREA_SHORT = {
  'AI / ML / Data Mining': 'AI · ML · Data Mining',
  'Security & Privacy': 'Security & Privacy',
  'Medicine, Biology & Genetics': 'Medicine · Biology · Genetics',
  'Science & Interdisciplinary': 'Science & Interdisciplinary',
  [SOCIETY]: 'Society meetings',
};
const slug = (a) => a.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');
// Each field gets one icon and one hue, used identically in the filter and in
// every row, so the two can be matched at a glance instead of by reading.
const AREA_ICON = {
  'AI / ML / Data Mining': 'fa-brain',
  'Security & Privacy': 'fa-shield-halved',
  'Medicine, Biology & Genetics': 'fa-dna',
  'Science & Interdisciplinary': 'fa-flask',
  [SOCIETY]: 'fa-people-group',
};
const DEFAULT_AREA = 'AI / ML / Data Mining';
const AR_REPO = 'https://github.com/lixin4ever/Conference-Acceptance-Rate';
// Fixed 0-45% scale: the point of the bars is to compare venues to each other,
// which a per-row scale would destroy.
const RATE_MAX = 45;
const CHART = { w: 180, h: 40 };
// A line over the whole published history, on a fixed axis so two venues can
// be compared by eye. The three most recent numbers are printed underneath,
// because that is what anyone actually wants off this cell.
const chart = (rates) => {
  if (!rates || rates.length < 2) return null;
  const xs = rates.map((p, i) => (i / (rates.length - 1)) * CHART.w);
  const y = (r) => CHART.h - (Math.min(r, RATE_MAX) / RATE_MAX) * CHART.h;
  return {
    pts: rates.map((p, i) => `${xs[i].toFixed(1)},${y(p.r).toFixed(1)}`).join(' '),
    last: { x: xs[xs.length - 1], y: y(rates[rates.length - 1].r) },
    grid: [10, 20, 30, 40].map((v) => ({ v, y: y(v) })),
    span: `${rates[0].y}–${rates[rates.length - 1].y}`,
  };
};
const AR_REPO_OLD = 'https://github.com/lixin4ever/Conference-Acceptance-Rate';
const CSC = 'https://csconfstats.xoveexu.com/conferences';
const DBLP = 'https://dblp.org/db/conf';
const BEST = 'https://jeffhuang.com/best_paper_awards/conferences.html';
const MAX_ROUNDS = 3;

// Per-topic acceptance, newest edition, with the change against the one
// before it. Scaled to the spread rather than to zero, because every topic
// sits between about 25 and 50 percent and a zero baseline flattens them.
const SPARK = { w: 34, h: 13 };
const topicBlocks = Object.entries(topicRates).map(([venue, eds]) => {
  const now = eds[0];
  const prev = eds[1];
  const years = eds.map((e) => e.year).reverse();
  const rates = now.topics.map((t) => t.rate);
  const lo = Math.floor(Math.min(...rates) - 2);
  const hi = Math.ceil(Math.max(...rates) + 2);
  return {
    venue, year: now.year, overall: now.overall, decided: now.decided,
    headline: now.headline, submitted: now.submitted,
    accepted: now.accepted, withdrawn: now.withdrawn,
    prevYear: prev ? prev.year : null, lo, hi,
    rows: now.topics.map((t) => {
      const before = prev ? prev.topics.find((x) => x.area === t.area) : undefined;
      const d = (now_, then_) => (then_ === undefined ? null : Math.round((now_ - then_) * 10) / 10);
      // One point per edition the topic existed in. ICLR added three areas in
      // 2025, so those series are shorter and start where the topic does.
      const series = years
        .map((y) => {
          const ed = eds.find((e) => e.year === y);
          const row = ed && ed.topics.find((x) => x.area === t.area);
          return row ? { y, rate: row.rate } : null;
        })
        .filter(Boolean);
      const sp = series.length > 1
        ? series.map((pt, i) => `${((i / (series.length - 1)) * SPARK.w).toFixed(1)},${(SPARK.h - ((pt.rate - lo) / (hi - lo)) * SPARK.h).toFixed(1)}`)
        : null;
      return { ...t, delta: d(t.rate, before && before.rate),
               shareDelta: d(t.share, before && before.share),
               series, spark: sp ? sp.join(' ') : null,
               sparkLast: sp ? sp[sp.length - 1].split(',') : null,
               pct: ((t.rate - lo) / (hi - lo)) * 100 };
    }),
  };
});
const CSR = 'https://csrankings.org/';
// Google Scholar Metrics has no API, so the h5-index itself is not pulled in.
// What is linkable is the category page, which is the field-native ranking.
// Every slug below was opened and confirmed to resolve. Society meetings get
// no link: they publish no papers, so Scholar Metrics does not index them.
const GSM = 'https://scholar.google.com/citations?view_op=top_venues&hl=en&vq=';
const SCHOLAR = {
  'AI / ML / Data Mining': GSM + 'eng_artificialintelligence',
  'Security & Privacy': GSM + 'eng_computersecuritycryptography',
  'Medicine, Biology & Genetics': GSM + 'bio_bioinformatics',
  'Science & Interdisciplinary': GSM + 'eng',
  'Society meetings': '',
};
const TIER = { 1: 'Top', 2: 'Strong', 3: 'Listed' };

const coreLabel = { 'A*': 'A*', A: 'A', B: 'B', C: 'C', TBR: 'TBR', JP: 'jrnl', N: 'n/a' };
const coreClass = (c) => `core-${c === 'A*' ? 'as' : c.toLowerCase()}`;

// Acceptance rates are only as fresh as the upstream table; anything before
// this is shown with the year called out rather than quietly passed off as current.
const FRESH_FROM = 2024;

// One list, date order. Venues with no announced date sit at the end rather
// than pretending to a position in the calendar.
const society = notable.map((c) => ({ ...c, society: true }));
const all = [...ranked, ...society];
const dated = all.filter((c) => c.nextDeadline).sort((a, b) => a.nextDeadline.localeCompare(b.nextDeadline));
const undated = all.filter((c) => !c.nextDeadline).sort((a, b) => a.title.localeCompare(b.title));
const rows = [...dated, ...undated].map((c) => ({ ...c, chart: chart(c.rates) }));

const counts = AREAS.map((a) => ({ area: a, n: rows.filter((c) => c.area === a).length })).filter((x) => x.n);
const totalRated = rows.filter((c) => c.rates.length).length;
const freshRated = rows.filter((c) => c.rates.length && c.rates[c.rates.length - 1].y >= FRESH_FROM).length;

---
<Layout title="Conferences | Zhiqian Chen">
  <main class="container">
    <nav class="top-nav" aria-label="Sections">
      <a href="/">Home</a>
      <a href="/research">Research</a>
      <a href="/agenda">Agenda</a>
      <a href="/people">People</a>
      <a href="/teach">Talk &amp; Teach</a>
      <a href="https://scholar.google.com/citations?user=NC3-O6UAAAAJ&hl=en&oi=ao" target="_blank" rel="noopener">Paper <i class="ai ai-google-scholar-square ai-sm nav-ghost"></i> <i class="fas fa-arrow-up-right-from-square nav-ghost"></i></a>
      <a href="https://substack.com/@zhiqianchen1" target="_blank" rel="noopener">Zhiqian's Note <svg class="nav-ghost nav-substack" viewBox="0 0 24 24" fill="currentColor" width="11" height="11" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg> <i class="fas fa-arrow-up-right-from-square nav-ghost"></i></a>
      <a class="nav-right-start" href="/conferences" aria-current="page">Conferences</a>
    </nav>

    <section class="head">
      <div class="filter" role="group" aria-label="Filter by field">
        {counts.map((c) => (
          <button class={`fbtn area-${slug(c.area)}${c.area === DEFAULT_AREA ? ' is-on' : ''}`} data-area={slug(c.area)} type="button" data-scholar={SCHOLAR[c.area] || ''}>
            <i class={`fas ${AREA_ICON[c.area]}`} aria-hidden="true"></i>{AREA_SHORT[c.area]}<span class="fcount">{c.n}</span>
          </button>
        ))}
        <a class="scholar-link" id="scholar-link" href={SCHOLAR[DEFAULT_AREA]} target="_blank" rel="noopener"
           title="This field's h5-index ranking on Google Scholar Metrics, journals and conferences together">
          h5-index <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
        </a>
      </div>

      <ul class="legend">
        <li><span class="tier-tag tt-1">Top</span> CCF A or CORE A*</li>
        <li><span class="tier-tag tt-2">Strong</span> CCF B or CORE A</li>
        <li><span class="tier-tag tt-3">Listed</span> unranked, importance stated</li>
        <li class="legend-gap"><span class="chip band-urgent"></span>&lt;30d</li>
        <li><span class="chip band-soon"></span>30&ndash;90</li>
        <li><span class="chip band-far"></span>90+</li>
        <li><span class="rounds-tag">2&times;</span>cycles / year</li>
        <li><span class="est-tag">est.<i class="fas fa-circle-question" aria-hidden="true"></i></span>estimated from last year</li>
      </ul>
    </section>

    {topicBlocks.map((b) => (
      <section class="section">
        <details class="rest topics lead" open>
          <summary>
            <h2>Which topics get in</h2>
            <span class="rest-count">{b.venue} {b.year}</span>
            <span class="rest-note">
            {b.submitted.toLocaleString()} submitted, {b.accepted.toLocaleString()} accepted, {b.headline}% overall
          </span>
          </summary>
          <div class="topic-head">
            <span title={`Of the ${b.decided.toLocaleString()} submissions that reached a decision. The ${b.withdrawn.toLocaleString()} withdrawn before one are excluded, which is why these read higher than the ${b.headline}% headline.`}>accept rate</span><span>vs {b.prevYear}</span><span></span>
            <span>topic <i class="fas fa-angle-down hint" aria-hidden="true"></i> click for its most cited papers</span><span class="th-mute">% of all<br/>subs</span><span class="th-mute">vs {b.prevYear}</span><span>rate<br/>trend</span>
          </div>
          <ul class="topic-list">
            {b.rows.map((t) => (
              <li class={t.papers ? 'has-papers' : ''}>
                <span class="t-rate">{t.rate}%</span>
                <span class={`t-drate ${(t.delta || 0) > 0 ? 't-up' : (t.delta || 0) < 0 ? 't-down' : 't-flat'}`}
                      title={`acceptance rate against ${b.prevYear}`}>{t.delta === null ? '' : (t.delta > 0 ? '+' : '') + t.delta}</span>
                <span class="t-bar"><span class="t-fill" style={`width:${t.pct.toFixed(1)}%`}></span></span>
                <span class="t-name">{t.area}</span>
                <span class="t-share" title={`${t.n} decided submissions`}>{t.share}%</span>
                <span class="t-dshare" title={`share of submissions against ${b.prevYear}`}>{t.shareDelta === null ? '' : (t.shareDelta > 0 ? '+' : '') + t.shareDelta}</span>
                {t.spark
                  ? <svg class="t-spark" viewBox={`-1 -2 ${SPARK.w + 2} ${SPARK.h + 4}`} width={SPARK.w + 2} height={SPARK.h + 4}
                         role="img" aria-label={t.series.map((pt) => `${pt.y} ${pt.rate}%`).join(', ')}>
                      <title>{t.series.map((pt) => `${pt.y}: ${pt.rate}%`).join('\n')}</title>
                      <polyline points={t.spark} />
                      <circle cx={t.sparkLast[0]} cy={t.sparkLast[1]} r="1.8" />
                    </svg>
                  : <span class="t-dshare">new</span>}
                {t.papers && (
                  <ol class="t-papers">
                    {t.papers.map((pp) => (
                      <li>
                        <span class="pp-c" title="Google Scholar citations">{pp.c}</span>
                        <span class={`pp-k pp-${pp.k.toLowerCase()}`}>{pp.k}</span>
                        <span class="pp-y">{pp.y}</span>
                        {pp.u ? <a href={pp.u} target="_blank" rel="noopener">{pp.t}</a> : <span>{pp.t}</span>}
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ))}
          </ul>
        </details>
      </section>
    ))}

    <section class="section">
      <div class="table-wrap">
        <table class="confs">
          <thead>
            <tr>
              <th class="c-name">Conference</th>
              <th class="c-date">Next deadline</th>
              <th class="c-when">Edition</th>
              <th class="c-rate">Acceptance</th>
              <th class="c-rank">Ranking</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((c) => {
              const last = c.rates.length ? c.rates[c.rates.length - 1] : null;
              const stale = last && last.y < FRESH_FROM;
              return (
              <tr class={`tier-${c.tier}`} data-area={slug(c.area)}>
                <td class="c-name">
                  <span class={`tier-tag tt-${c.tier}`}>{TIER[c.tier]}</span>
                  <span class="name-line">
                    {c.link
                      ? <a class="conf-name" href={c.link} target="_blank" rel="noopener">{c.title}</a>
                      : <span class="conf-name">{c.title}</span>}
                    {c.cycles > 1 && <span class="rounds-tag" title={c.roundLabels.join(' · ')}>{c.cycles}&times;</span>}
                    {c.notable && !c.society && <span class="new-tag">emerging</span>}
                    {c.society && <span class={`proc proc-${c.proceedings}`}>{c.proceedings === 'optin' ? 'opt-in proceedings' : 'no proceedings'}</span>}
                  </span>
                  <span class="conf-desc">{c.desc}</span>
                  {(c.dblp || c.best) && (
                    <span class="links">
                      {c.dblp && <a href={`${DBLP}/${c.dblp}/index.html`} target="_blank" rel="noopener" title="Every past edition's proceedings, on DBLP">past proceedings</a>}
                      {c.best && <a href={`${BEST}#${c.best}`} target="_blank" rel="noopener" title="Best-paper awards since 1996, Jeff Huang's compilation">best papers</a>}
                    </span>
                  )}
                  {c.note && <p class="why">{c.note}</p>}
                </td>
                <td class="c-date">
                  {c.rounds && c.rounds.length
                    ? <>
                        {c.rounds.slice(0, MAX_ROUNDS).map((r) => (
                          <div class="round">
                            <span class={`dl ${r.est ? 'is-est' : ''}`}>{r.d}</span>
                            <span class="dl-days" data-deadline={r.d}></span>
                            {r.est && <span class="est-tag" title={`Not announced yet. Estimated by rolling last year's deadline (${r.from}) forward.`}>est.<i class="fas fa-circle-question" aria-hidden="true"></i></span>}
                            {r.label && <span class="round-label">{r.label}</span>}
                          </div>
                        ))}
                        {c.rounds.length > MAX_ROUNDS && (
                          <span class="round-more" title={c.rounds.slice(MAX_ROUNDS).map((r) => r.d).join(', ')}>
                            +{c.rounds.length - MAX_ROUNDS} more rounds
                          </span>
                        )}
                      </>
                    : c.nextDeadline
                    ? <>
                        <span class={`dl ${c.estimated ? 'is-est' : ''}`}>{c.nextDeadline}</span>
                        <span class="dl-days" data-deadline={c.nextDeadline}></span>
                        {c.estimated && <span class="est-tag" title={`Not announced yet. Estimated by rolling last year's deadline (${c.estFrom}) forward.`}>est.<i class="fas fa-circle-question" aria-hidden="true"></i></span>}
                      </>
                    : <span class="none">date unavailable</span>}
                </td>
                <td class="c-when">
                  {c.edition && <span class="ed-ord" title="Edition number, projected from the last one on record">{c.edition}</span>}
                  {c.nextYear && !(c.date || '').includes(String(c.nextYear)) ? <span class="ed">{c.nextYear}</span> : null}
                  {c.date ? <span class="when">{c.date}</span> : <span class="none">not yet scheduled</span>}
                  {c.place && <span class="where">{c.cc && <span class={`fi fi-${c.cc}`} aria-hidden="true"></span>}{c.place}</span>}
                  {c.city && <span class="city"><i class="fas fa-camera" aria-hidden="true"></i>{c.city}</span>}
                </td>
                <td class="c-rate">
                  {last
                    ? <div class={`rate ${stale ? 'is-stale' : ''}`}>
                        <div class="rate-side">
                          <a class="rate-more" href={c.rateSrc === 'csc' ? `${CSC}/${c.rateSlug}/` : `${AR_REPO_OLD}#${c.rateSection}`} target="_blank" rel="noopener" title="Full year-by-year history at the source">
                            {c.rates.length} yrs <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                          </a>
                          {stale && <span class="rate-stale-note">ends {last.y}</span>}
                        </div>
                        {c.chart && (
                          <svg class="spark" viewBox={`-2 -6 ${CHART.w + 34} ${CHART.h + 12}`} width={CHART.w + 34} height={CHART.h + 12} role="img" aria-label={`Acceptance rate ${c.chart.span}`}>
                            {c.chart.grid.map((g) => (
                              <>
                                <line x1="0" x2={CHART.w} y1={g.y} y2={g.y} class="grid" />
                                <text x={CHART.w + 3} y={g.y + 3} class="glab">{g.v}</text>
                              </>
                            ))}
                            <polyline points={c.chart.pts} class="line" />
                            <circle cx={c.chart.last.x} cy={c.chart.last.y} r="2.6" class="dot" />
                          </svg>
                        )}
                        <div class="rate-nums">
                          {c.rates.slice(-3).reverse().map((p) => (
                            <span class="rn"><b>{p.r}%</b><i>'{String(p.y).slice(2)}</i></span>
                          ))}
                        </div>

                      </div>
                    : <span class="none">no published rate</span>}
                </td>
                <td class="c-rank">
                  {c.society
                    ? <span class="eqv eqv-none">{c.proceedings === 'optin' ? 'not rankable, proceedings are opt-in and not peer reviewed' : 'not rankable, no archival proceedings'}</span>
                    : c.notable
                    ? <span class="none">not ranked</span>
                    : <span class="ranks">
                        <span class={`pill ccf-${c.ccf.toLowerCase()}`} title="CCF catalogue">CCF {c.ccf === 'N' ? 'n/a' : c.ccf}</span>
                        <span class={`pill ${coreClass(c.core)}`} title={c.coreVerified ? 'Confirmed against the official CORE2023 export' : 'Not found in the official CORE2023 export'}>CORE {coreLabel[c.core]}</span>
                        {c.csr
                          ? <a class="pill csr-yes" href={CSR} target="_blank" rel="noopener" title={`Counted by CSRankings, under ${c.csr}`}>CSRanking</a>
                          : <span class="pill csr-no" title="Not on the CSRankings venue list">no CSRanking</span>}
                      </span>}
                </td>
              </tr>
            );})}
          </tbody>
        </table>
      </div>
      <p class="empty-note" hidden>No conference in this field.</p>
      <p class="area-note">
        Acceptance rates: {totalRated} of {rows.length} venues publish one, and {freshRated} of those are {FRESH_FROM} or later.
        The rest are labeled with the year they stop &mdash; the upstream compilation simply stopped updating them.
        Main track only; Findings and workshops are excluded.
      </p>
    </section>

    <section class="section">
      <details class="rest">
        <summary>
          <h2>Others</h2>
          <span class="rest-count">{others.length}</span>
          <span class="rest-note">CORE B or lower and CCF C or lower</span>
        </summary>
        <ul class="rest-list">
          {others.map((c) => (
            <li>
              <a href={c.link} target="_blank" rel="noopener">{c.title}</a>
              <span class={`pill ccf-${c.ccf.toLowerCase()}`}>CCF {c.ccf === 'N' ? 'n/a' : c.ccf}</span>
              <span class={`pill ${coreClass(c.core)}`}>CORE {coreLabel[c.core]}</span>
              <span class="rest-desc">{c.desc}</span>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <section class="section sources">
      <h2 class="area-head">Where all of this comes from</h2>
      <ul class="src-list">
        <li>
          <a href="https://github.com/ccfddl/ccf-deadlines" target="_blank" rel="noopener">ccfddl/ccf-deadlines</a>
          <span>CCF ranks, every edition's deadlines and round structure, and the DBLP key each venue links out with. Mirrors the CCF catalogue.</span>
        </li>
        <li>
          <a href="https://portal.core.edu.au/conf-ranks/" target="_blank" rel="noopener">CORE Conference Portal</a>
          <span>CORE ranks, taken from the official CORE2023 CSV export rather than a copy of it. Every CORE rank here is matched against that file.</span>
        </li>
        <li>
          <a href="https://csconfstats.xoveexu.com/conferences/" target="_blank" rel="noopener">CS Conf Stats</a>
          <span>Acceptance rates, primary source. Publishes accepted and submitted counts per year from proceedings, current to 2026. Code at <a href="https://github.com/Xovee/cs-conf-stats" target="_blank" rel="noopener">Xovee/cs-conf-stats</a>.</span>
        </li>
        <li>
          <a href="https://github.com/lixin4ever/Conference-Acceptance-Rate" target="_blank" rel="noopener">Conference-Acceptance-Rate</a>
          <span>Acceptance rates, fallback only, for venues the source above does not cover. Several of its rows stopped being updated after 2023.</span>
        </li>
        <li>
          <a href="https://jeffhuang.com/best_paper_awards/" target="_blank" rel="noopener">Best Paper Awards in Computer Science</a>
          <span>Best-paper awards since 1996 for 32 conferences, compiled by Jeff Huang. Sixteen of them appear on this page.</span>
        </li>
        <li>
          <a href="https://csrankings.org/" target="_blank" rel="noopener">CSRankings</a>
          <span>Whether a venue is on the fixed list CSRankings counts, matched on DBLP key. It ranks institutions, not conferences, but that list is the closest thing the field has to a statement of which venues count. Thirty-two of the venues here are on it.</span>
        </li>
        <li>
          <a href="https://scholar.google.com/citations?view_op=top_venues&hl=en" target="_blank" rel="noopener">Google Scholar Metrics</a>
          <span>Not pulled in, because there is no API. It ranks journals and conferences together by h5-index per field, which is the only ranking biology and medicine actually use, so each field's category is linked from the filter above.</span>
        </li>
        <li>
          <a href="https://github.com/papercopilot/paperlists" target="_blank" rel="noopener">papercopilot/paperlists</a>
          <span>Per-topic acceptance, the block at the top of this page. Mirrors OpenReview into one JSON per venue-year, carrying each submission's author-declared topic and final status. The first two columns there are the acceptance rate and its change against the previous edition; the grey pair is the topic's share of the submission pool and its change, which says whether a topic is getting crowded rather than harder. Rates divide by submissions that reached a decision, since a withdrawal is not a rejection, which is why they read higher than the conference's own headline figure over all submissions. Both are printed. Topics under 40 decided submissions are dropped, bars are scaled to the observed range rather than to zero, and ICLR renamed four areas in 2025, which are joined back across the series. All thirty venues it covers were checked: ICLR is the only one whose file is a full submission pool, at 61% rejections. Every other list, NeurIPS and ICML included, is accepted papers only, because those conferences keep rejected submissions private unless the authors opt in. The build script refuses to compute a rate from a list with under 15% rejections.</span>
        </li>
        <li>
          <a href="https://dblp.org/" target="_blank" rel="noopener">DBLP</a>
          <span>The full proceedings history every venue's "past proceedings" link points at.</span>
        </li>
        <li>
          <a href="https://www.siam.org/conferences-events/" target="_blank" rel="noopener">SIAM</a>,
          <a href="https://meetings.informs.org/" target="_blank" rel="noopener">INFORMS</a>,
          <a href="https://mlsys.org/" target="_blank" rel="noopener">MLSys</a>,
