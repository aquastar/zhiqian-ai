---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/funding.json';

// Deadlines arrive as free text and stay that way, because most of them are
// genuinely not a single date: "white paper 2026-11-20, full 2026-12-04",
// "rolling to 2027-09-30", "LOI 2026-10-30". The date is pulled out for
// sorting and for the countdown, and the words around it are kept, since
// knowing a date is an LOI rather than the proposal is the whole point.
const ISO = /\d{4}-\d{2}-\d{2}/g;
const TODAY = new Date().toISOString().slice(0, 10);

const readDeadline = (text) => {
  const raw = (text || '').trim();
  const dates = (raw.match(ISO) || []).sort();
  const next = dates.find((d) => d >= TODAY) || '';
  const qualifier = raw
    .replace(ISO, '')
    .replace(/[,，]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  return {
    raw,
    dates,
    next,
    qualifier,
    // Three states, same idea as the conferences table: something ahead of
    // you, nothing on record, or a door that has shut.
    status: next ? 'open' : dates.length ? 'closed' : 'rolling',
  };
};

const rows = data.registry.map((r) => ({ ...r, dl: readDeadline(r.deadline) }));

// Open first, soonest at the top. Rolling and undated next, because they are
// still actionable. Closed last, most recently closed first.
const ORDER = { open: 0, rolling: 1, closed: 2 };
rows.sort((a, b) => {
  const o = ORDER[a.dl.status] - ORDER[b.dl.status];
  if (o) return o;
  if (a.dl.status === 'open') return a.dl.next.localeCompare(b.dl.next);
  if (a.dl.status === 'closed') return (b.dl.dates.at(-1) || '').localeCompare(a.dl.dates.at(-1) || '');
  return a.sponsor.localeCompare(b.sponsor);
});

const counts = {
  all: rows.length,
  pick: rows.filter((r) => r.pick).length,
  open: rows.filter((r) => r.dl.status === 'open').length,
  rolling: rows.filter((r) => r.dl.status === 'rolling').length,
  closed: rows.filter((r) => r.dl.status === 'closed').length,
};

// Fallback mark for the funders whose site offers no icon.
const initials = (name) =>
  (name || '?')
    .replace(/[^A-Za-z0-9 ]/g, ' ')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => (/^[A-Z0-9]{2,}$/.test(w) ? w.slice(0, 3) : w[0].toUpperCase()))
    .join('')
    .slice(0, 3);

const unverified = data.watchlist.filter((w) => (w.url_verified || '').toUpperCase() !== 'Y').length;

const FILTERS = [
  { key: 'all', label: 'Everything tracked', icon: 'fa-layer-group', n: counts.all },
  { key: 'pick', label: 'This week', icon: 'fa-star', n: counts.pick },
  { key: 'open', label: 'Deadline ahead', icon: 'fa-hourglass-half', n: counts.open },
  { key: 'rolling', label: 'Rolling or undated', icon: 'fa-infinity', n: counts.rolling },
];

// The brief grades how crowded a call looks. The build script translates the
// grade, so match on the English it produces: "low to medium" counts as low,
// "medium to high" as high, because the warning is the useful half.
const compClass = (c) => {
  const v = (c || '').toLowerCase();
  if (v.includes('high')) return 'comp-high';
  if (v.includes('low')) return 'comp-low';
  return 'comp-mid';
};
---

<Layout title="Funding | Zhiqian Chen">
  <main class="container">
    <nav class="top-nav" aria-label="Sections">
      <a href="/">Home</a>
      <a href="/research">Research</a>
      <a href="/agenda">Agenda</a>
      <a href="/people">People</a>
      <a href="/teach">Talk &amp; Teach</a>
      <a href="https://scholar.google.com/citations?user=NC3-O6UAAAAJ&hl=en&oi=ao" target="_blank" rel="noopener">Paper <i class="ai ai-google-scholar-square ai-sm nav-ghost"></i> <i class="fas fa-arrow-up-right-from-square nav-ghost"></i></a>
      <a href="https://substack.com/@zhiqianchen1" target="_blank" rel="noopener">Zhiqian's Note <svg class="nav-ghost nav-substack" viewBox="0 0 24 24" fill="currentColor" width="11" height="11" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg> <i class="fas fa-arrow-up-right-from-square nav-ghost"></i></a>
      <a class="nav-right-start" href="/conferences">Conferences</a>
      <a href="/funding" aria-current="page">Funding</a>
    </nav>

    <section class="brief">
      <div class="brief-main">
        <h1>AI funding, tracked weekly</h1>
        <p class="sub">
          A standing scan of federal, foundation, industry and philanthropic calls in AI and
          adjacent computing. Rebuilt every Friday morning from the week's sweep. Dates and
          amounts are copied from the call as written, so treat the sponsor's own page as the
          authority and this as the index that gets you there.
        </p>
        <p class="window">
          {data.window.new_since && (
            <>Newly posted since <b>{data.window.new_since}</b>, or closing before <b>{data.window.deadline_before}</b>.</>
          )}
        </p>
      </div>
      <div class="brief-side">
        <div class="stamp">
          <span class="stamp-label">Latest sweep</span>
          <span class="stamp-date">{data.date}</span>
        </div>
        <ul class="tally">
          <li><b>{counts.all}</b><span>tracked</span></li>
          <li><b>{counts.pick}</b><span>this week</span></li>
          <li><b>{counts.open}</b><span>still open</span></li>
          <li><b>{data.counts.watchlist}</b><span>on watch</span></li>
        </ul>
        <div class="grabs">
          <a href="/funding/data.json" title="Everything on this page as one JSON file: the week's opportunities, the full registry, the watchlist and the early signals, with the counts and the collection window. Written by the Friday job from the three sources below it.">data.json</a>
          <a href="/funding/registry.csv" title={`The ledger of every call the weekly sweep has reported, ${data.counts.registry} rows so far, one line each with the date it was first seen, the funder, the programme, the deadline and the link. The sweep reads it back each week to work out what is genuinely new.`}>registry.csv</a>
          <a href="/funding/watchlist.csv" title={`The standing scan list, ${data.counts.watchlist} funders checked every run rather than found by one: category, typical cycle, who may apply, and a note on why the funder is on the list. Hand maintained, and ${unverified} of its links are not yet confirmed.`}>watchlist.csv</a>
        </div>
      </div>
    </section>

    <div class="filter">
      {FILTERS.map((f, i) => (
        <button type="button" class={`fbtn f-${f.key}${i === 0 ? ' is-on' : ''}`} data-filter={f.key}>
          <i class={`fas ${f.icon}`} aria-hidden="true"></i>{f.label}<span class="fcount">{f.n}</span>
        </button>
      ))}
      <span class="closed-note">{counts.closed} closed, kept for the record</span>
    </div>

    <div class="table-wrap">
      <table class="fund">
        <thead>
          <tr>
            <th class="c-who">Funder and program</th>
            <th class="c-when">Next date</th>
            <th class="c-terms">Terms</th>
            <th class="c-rate">Funding rate</th>
            <th class="c-seen">First seen</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr data-status={r.dl.status} data-pick={r.pick ? '1' : '0'}>
              <td class="c-who">
                <div class="who">
                  <span class="mark" aria-hidden="true">
                    {r.logo
                      ? <img src={r.logo} alt="" loading="lazy" width="22" height="22" />
                      : <span class="mark-text">{initials(r.sponsor)}</span>}
                  </span>
                  <div class="who-body">
                    <span class="who-line">
                      <span class="sponsor">{r.sponsor}</span>
                      {r.pick && <span class="pick-tag" title="Picked out in this week's brief">this week</span>}
                      {r.source_tier && <span class="tier-tag" title="How the call was found: L1 a primary source, L2 an aggregator, L3 a secondary mention">{r.source_tier}</span>}
                    </span>
                    {r.url
                      ? <a class="program" href={r.url} target="_blank" rel="noopener">{r.program}<i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
                      : <span class="program">{r.program}</span>}
                    {r.eligibility && <span class="elig">{r.eligibility}</span>}
                  </div>
                </div>
              </td>
              <td class="c-when" data-label="Next date">
                {r.dl.next
                  ? <span class="when-line">
                      {r.dl.qualifier && <span class="qual">{r.dl.qualifier}</span>}
                      <span class="date">{r.dl.next}</span>
                      <span class="days" data-deadline={r.dl.next}></span>
                    </span>
                  : r.dl.status === 'closed'
                  ? <span class="when-line"><span class="date is-gone">{r.dl.raw}</span><span class="days band-past">closed</span></span>
                  : <span class="when-line"><span class="rolling">{r.dl.raw || 'not stated'}</span></span>}
                {r.dl.dates.length > 1 && (
                  <span class="also">also {r.dl.dates.filter((d) => d !== r.dl.next).join(', ')}</span>
                )}
              </td>
              <td class="c-terms" data-label="Terms">
                {r.budget && <span class="budget">{r.budget}</span>}
                {r.competition && <span class={`comp ${compClass(r.competition)}`} title="How crowded the call looks, as graded in the weekly brief">{r.competition} competition</span>}
                {!r.budget && !r.competition && <span class="none">not summarized</span>}
              </td>
              <td class="c-rate" data-label="Funding rate">
                {r.rate
                  ? <a class="rate" href={r.rate_source} target="_blank" rel="noopener" title={`${r.rate_basis} Source: ${r.rate_source_name}.`}>
                      {r.rate}<i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                    </a>
                  : <span class="none" title="This funder does not publish a funding rate. An empty cell here is missing data, not good odds.">not published</span>}
              </td>
              <td class="c-seen" data-label="First seen">{r.first_seen_date}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="empty-note" hidden>Nothing in that slice.</p>

    {data.early_signals.length > 0 && (
      <section class="signals">
        <h2>Early signals</h2>
        <p class="sub">Programs and consultations that have not opened yet, worth a note now.</p>
        <ul>
          {data.early_signals.map((s) => (
            <li>
              {s.url ? <a href={s.url} target="_blank" rel="noopener">{s.note}<i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i></a> : s.note}
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="foot">
      {data.caveat} Built from the weekly sweep by
      <a href="https://github.com/aquastar/zhiqian-ai/blob/main/.github/workflows/funding-sync.yml" target="_blank" rel="noopener">a scheduled job</a>
      that runs every Friday, 13:37 UTC.
    </p>
  </main>
</Layout>

<style>
  .container { max-width: min(95vw, 1600px); margin: 0 auto; padding: 20px; box-sizing: border-box; }
  .top-nav { margin-bottom: 14px; padding: 10px 0 14px; display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
  .top-nav a { text-decoration:none; color:var(--ink); font-family:'Montserrat',sans-serif; font-size:.9rem; padding:7px 10px; border-radius:999px; background:transparent; }
  .top-nav a:hover { background:#f1f5f9; color:#0f172a; }
  .top-nav a[aria-current="page"] { background:#e2e8f0; color:#0f172a; box-shadow:inset 0 1px 2px rgba(15,23,42,.10); }
  .nav-right-start { margin-left:auto; }
  .nav-ghost { opacity:.55; font-size:.72em; }
  .nav-substack { vertical-align:-1px; opacity:.85; }

  /* The brief, which is the standing explanation of what this page is, with
     the week's numbers beside it rather than under it. */
  .brief { display:flex; flex-wrap:wrap; gap:26px; align-items:flex-start;
    justify-content:space-between; padding:16px 18px; margin-bottom:14px;
    border:1px solid rgba(148,163,184,.3); border-radius:14px;
    background:linear-gradient(180deg,#fbfdff,#f8fafc); }
  .brief-main { flex:1 1 460px; min-width:0; }
  /* The site justifies body text. That is fine for a paragraph and wrong for
     a heading or a table cell, where it opens rivers between two or three
     words. Both are set back to left here. */
  .brief h1 { font-size:1.5rem; margin:0 0 6px; letter-spacing:-.02em; text-align:left; }
  .sub { margin:0; color:#475569; font-size:.86rem; line-height:1.6; max-width:70ch; }
  .window { margin:8px 0 0; font-size:.8rem; color:#475569; }
  .window b { color:#0f172a; font-variant-numeric:tabular-nums; }
  .brief-side { flex:0 0 auto; display:flex; flex-direction:column; gap:9px; align-items:flex-end; }
  .stamp { display:flex; flex-direction:column; align-items:flex-end; line-height:1.1; }
  .stamp-label { font-size:.6rem; font-weight:800; letter-spacing:.09em; text-transform:uppercase; color:#94a3b8; }
  .stamp-date { font-size:1.05rem; font-weight:800; color:#0f172a; font-variant-numeric:tabular-nums; }
  .tally { list-style:none; display:flex; gap:7px; margin:0; padding:0; }
  .tally li { display:flex; flex-direction:column; align-items:center; min-width:62px;
    padding:5px 8px; border-radius:9px; background:#fff; border:1px solid rgba(148,163,184,.3); }
  .tally b { font-size:1rem; color:#0f172a; font-variant-numeric:tabular-nums; }
  .tally span { font-size:.58rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:#94a3b8; }
  .grabs { display:flex; gap:7px; }
  .grabs a { font-size:.66rem; font-weight:700; color:#475569; text-decoration:none;
    border:1px solid rgba(148,163,184,.45); border-radius:999px; padding:2px 9px; background:#fff; }
  .grabs a:hover { color:var(--accent); border-color:rgba(37,99,235,.5); }

  .filter { display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin-bottom:10px; }
  .fbtn { display:inline-flex; align-items:center; gap:6px; padding:5px 11px; border-radius:999px;
    cursor:pointer; border:1px solid rgba(148,163,184,.4); background:#fff; color:#475569;
    font:inherit; font-size:.76rem; font-weight:600; white-space:nowrap; }
  .fbtn i { font-size:.8rem; }
  .fbtn:hover { border-color:rgba(37,99,235,.45); color:var(--accent); }
  .fbtn.is-on { background:#1e293b; border-color:#1e293b; color:#fff; }
  .fcount { font-size:.68rem; font-weight:700; opacity:.6; }
  .fbtn.f-pick:not(.is-on) { color:#a16207; border-color:#fde68a; }
  .fbtn.f-open:not(.is-on) { color:#b91c1c; border-color:#fecaca; }
  .closed-note { margin-left:auto; font-size:.68rem; color:#94a3b8; }

  .table-wrap { overflow-x:auto; border:1px solid rgba(148,163,184,.3); border-radius:12px; background:#fff; }
  table.fund { width:100%; min-width:1000px; table-layout:fixed; border-collapse:collapse; font-size:.84rem; }
  .fund thead th { position:sticky; top:0; z-index:2; background:#f8fafc; text-align:left;
    font-size:.64rem; letter-spacing:.08em; text-transform:uppercase; color:#64748b; font-weight:700;
    padding:7px 9px; border-bottom:1px solid rgba(148,163,184,.3); white-space:nowrap; }
  .fund td { padding:8px 9px; border-bottom:1px solid rgba(148,163,184,.17); vertical-align:top;
    text-align:left; }
  .fund tbody tr:last-child td { border-bottom:0; }
  .fund tbody tr:hover { background:#f8fafc; }
  .fund tbody tr[data-status="closed"] { opacity:.5; }
  .fund tbody tr[data-pick="1"] { background:#fffdf5; }
  .fund tbody tr[data-pick="1"]:hover { background:#fef9e7; }

  .c-who { width:36%; }
  .c-when { width:22%; }
  .c-terms { width:21%; }
  .c-rate { width:12%; }
  .c-seen { width:9%; font-variant-numeric:tabular-nums; color:#94a3b8; font-size:.74rem; white-space:nowrap; }
  .rate { display:inline-flex; align-items:baseline; gap:4px; font-size:.86rem; font-weight:800;
    color:#0f172a; text-decoration:none; font-variant-numeric:tabular-nums;
    border-bottom:1px solid rgba(148,163,184,.5); }
  .rate:hover { color:var(--accent); border-color:currentColor; }
  .rate i { font-size:.55rem; opacity:.45; }

  /* Funder and programme were two bold lines a shade apart, which is not a
     difference you can see while scanning. They are now plainly different
     kinds of thing: the funder is a small grey label beside its mark, the
     programme is the dark serif-weight line you actually read. */
  .who { display:flex; align-items:flex-start; gap:9px; }
  .mark { flex:0 0 auto; display:grid; place-items:center; width:26px; height:26px; margin-top:1px;
    border-radius:7px; background:#f8fafc; border:1px solid rgba(148,163,184,.3); overflow:hidden; }
  .mark img { width:16px; height:16px; object-fit:contain; }
  .mark-text { font-size:.58rem; font-weight:800; letter-spacing:.02em; color:#94a3b8; }
  .who-body { min-width:0; }
  .who-line { display:flex; flex-wrap:wrap; align-items:center; gap:6px; margin-bottom:1px; }
  .sponsor { font-size:.64rem; font-weight:600; letter-spacing:.07em; text-transform:uppercase; color:#94a3b8; }
  .pick-tag { font-size:.58rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase;
    color:#a16207; background:#fef3c7; border:1px solid #fde68a; border-radius:4px; padding:1px 6px; }
  .tier-tag { font-size:.58rem; font-weight:800; color:#0369a1; background:#e0f2fe;
    border-radius:4px; padding:1px 5px; cursor:help; }
  .program { display:inline-flex; align-items:baseline; gap:5px; font-weight:700; color:#0f172a;
    text-decoration:none; font-size:.9rem; line-height:1.3; overflow-wrap:anywhere;
    letter-spacing:-.005em; }
  a.program:hover { color:var(--accent); text-decoration:underline; }
  .program i { font-size:.6rem; opacity:.45; flex:0 0 auto; }
  .elig { display:block; margin-top:2px; font-size:.71rem; color:#64748b; line-height:1.35; }

  .when-line { display:flex; flex-wrap:wrap; align-items:center; gap:6px; }
  .qual { font-size:.6rem; font-weight:800; letter-spacing:.05em; text-transform:uppercase;
    color:#92400e; background:#fef3c7; border:1px solid #fde68a; border-radius:4px; padding:1px 5px; }
  .date { font-variant-numeric:tabular-nums; font-weight:600; color:#1e293b; }
  .date.is-gone { font-weight:500; color:#64748b; }
  .rolling { font-size:.78rem; color:#475569; }
  .days { display:inline-block; font-size:.66rem; font-weight:800; color:#fff;
    border-radius:999px; padding:2px 8px; background:#64748b; }
  .days.band-urgent { background:#dc2626; }
  .days.band-soon { background:#1d4ed8; }
  .days.band-far { background:#64748b; }
  .days.band-past { background:#e2e8f0; color:#64748b; }
  .also { display:block; margin-top:3px; font-size:.65rem; color:#94a3b8; font-variant-numeric:tabular-nums; }

  .budget { display:block; font-size:.76rem; color:#0f172a; font-weight:600; line-height:1.35; }
  .comp { display:inline-block; margin-top:3px; font-size:.62rem; font-weight:800;
    border-radius:4px; padding:1px 6px; }
  .comp-low { color:#15803d; background:#dcfce7; }
  .comp-mid { color:#1d4ed8; background:#dbeafe; }
  .comp-high { color:#b91c1c; background:#fee2e2; }
  .none { color:#cbd5e1; font-size:.74rem; }

  .empty-note { margin:14px 0 0; color:#94a3b8; font-size:.84rem; }
  .empty-note[hidden] { display:none; }

  .signals { margin-top:18px; padding:14px 18px; border:1px solid rgba(148,163,184,.3);
    border-radius:12px; background:#fff; }
  .signals h2 { font-size:1rem; margin:0 0 4px; }
  .signals ul { margin:10px 0 0; padding-left:18px; }
  .signals li { font-size:.8rem; color:#475569; line-height:1.5; margin-bottom:5px; }
  .signals a { color:#1e293b; text-decoration:none; border-bottom:1px solid rgba(148,163,184,.5); }
  .signals a:hover { color:var(--accent); border-color:currentColor; }
  .signals a i { font-size:.58rem; opacity:.45; margin-left:4px; }

  .foot { margin:16px 0 0; font-size:.74rem; color:#94a3b8; line-height:1.6; }
  .foot a { color:#64748b; }

  /* Narrow screens: the table stops being a table, same as the conferences
     page, so nothing hides behind a sideways scrollbar. */
  @media (max-width: 1150px) {
    .table-wrap { overflow-x:visible; border:0; background:transparent; }
    table.fund { min-width:0; table-layout:auto; display:block; }
    .fund thead { display:none; }
    .fund tbody { display:block; }
    .fund tbody tr { display:block; margin-bottom:10px; padding:10px 12px;
      border:1px solid rgba(148,163,184,.3); border-radius:12px; background:#fff; }
    .fund tbody td { display:block; width:auto !important; padding:0; border:0; }
    .fund tbody td + td { margin-top:8px; padding-top:8px; border-top:1px dashed rgba(148,163,184,.3); }
    .fund tbody td[data-label]::before { content:attr(data-label); display:block; margin-bottom:3px;
      font-size:.6rem; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:#94a3b8; }
    .c-seen, .c-rate { white-space:normal; }
    .brief-side { align-items:flex-start; }
    .closed-note { margin-left:0; flex:0 0 100%; }
  }
</style>

<script>
  const DAY = 86400000;
  const today = new Date(); today.setHours(0, 0, 0, 0);

  // Countdown badges, computed in the reader's today rather than baked in at
  // build time, because this page is static and a week old by Thursday.
  document.querySelectorAll('.days[data-deadline]').forEach((el) => {
    const raw = el.getAttribute('data-deadline');
    if (!raw) return;
    const [y, m, d] = raw.split('-').map(Number);
    const days = Math.round((new Date(y, m - 1, d).getTime() - today.getTime()) / DAY);
    const band = days < 0 ? 'past' : days < 30 ? 'urgent' : days < 90 ? 'soon' : 'far';
    el.classList.add('band-' + band);
    el.textContent = days < 0 ? `closed ${-days}d ago` : days === 0 ? 'today' : `${days}d`;
    if (days < 0) {
      const tr = el.closest('tr');
      if (tr) tr.dataset.status = 'closed';
    }
  });

  const rows = Array.from(document.querySelectorAll('table.fund tbody tr'));
  const empty = document.querySelector('.empty-note');

  const apply = (key) => {
    let shown = 0;
    rows.forEach((tr) => {
      const ok =
        key === 'all' ? true :
        key === 'pick' ? tr.dataset.pick === '1' :
        tr.dataset.status === key;
      tr.style.display = ok ? '' : 'none';
      if (ok) shown += 1;
    });
    if (empty) empty.hidden = shown > 0;
  };

  document.querySelectorAll('.fbtn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.fbtn').forEach((b) => b.classList.toggle('is-on', b === btn));
      apply(btn.dataset.filter);
    });
  });
</script>
