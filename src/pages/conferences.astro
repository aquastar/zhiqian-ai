  .kind-head { font-family:'Montserrat',sans-serif; font-size:.74rem; font-weight:700; letter-spacing:.1em;
    text-transform:uppercase; color:#64748b; margin:0 0 8px; }
  .field-note { margin:0 0 14px; padding:10px 14px; border-left:3px solid #cbd5e1; background:#f8fafc; border-radius:0 10px 10px 0; }
