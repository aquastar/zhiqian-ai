  { name: 'Xinyuan Chen', role: 'Ph.D.' },
  { name: 'Zijian Zhang', role: 'Ph.D.' },
  { name: 'Jiashan Wu', role: 'Ph.D.' },
  { name: "Rocker D'Antonio", role: 'Ph.D.' },
  { name: 'Matthew Rester', role: 'M.S.' },
  { name: 'Henry Smith', role: 'M.S.' },
  { name: 'Samuel Prabhakar', role: 'M.S.' },
  { name: 'Rajeev Jogi', role: 'M.S.' },
  { name: 'Piero Bracamonte', role: 'M.S.' },
  { name: 'Suman Adhikari', role: 'M.S.' },
  { name: 'Ramyasri Veerapaneni', role: 'M.S.' },
  { name: 'Aymane Jouhari', role: 'M.S.' },
  { name: 'Sai Harika Gade', role: 'M.S.' },
  { name: 'Pavan Dharma Adapa', role: 'M.S.' },
  { name: 'Rayane Goghrod', role: 'M.S.' },
  { name: 'Kevin Ho', role: 'Undergrad' },
  { name: 'Jason Weeks', role: 'Undergrad' },
  { name: 'Ben Moore', role: 'Undergrad' },
  { name: 'Jack Maloney', role: 'Undergrad' },
  { name: 'Ethan Rogers', role: 'Undergrad' },
  { name: 'Prathyusha Mustiyala', role: 'Undergrad' },
  { name: 'Andrew McBride', role: 'Undergrad' },
