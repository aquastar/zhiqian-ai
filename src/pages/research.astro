  .card-mark { position:absolute; top:14px; right:16px; font-family:'Montserrat',sans-serif; font-size:.8rem; font-weight:700; color:#cbd5e1; }
  .topics { list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:6px; }
  .topics li { font-size:.78rem; color:#334155; background:#f1f5f9; border:1px solid rgba(148,163,184,.2); border-radius:999px; padding:3px 9px; }

  .projects { list-style:none; margin:0; padding:0; display:grid; gap:12px; counter-reset:proj; }
  .project { padding:12px 14px; border:1px solid rgba(148,163,184,.16); border-radius:14px; background:#fff; }
  .project-head { display:flex; flex-wrap:wrap; align-items:baseline; gap:8px; margin-bottom:5px; }
