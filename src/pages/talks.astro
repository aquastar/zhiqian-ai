---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

const talks = [
  {
    tag: 'Talk', year: '2026',
    title: 'Is There a Graph Inside Generative Models? Evidence from Language and Music',
    desc: 'Reading what a model knows as a graph shows what steering vectors miss, in language and music.',
    thumb: '/talks-thumbs/graph-inside.webp',
    events: [
      { label: 'CS Department Colloquium · Nov 19, 2026 · Rochester Institute of Technology, Rochester, NY', href: 'https://aquastar.github.io/talks/graph-inside/2026-11-19-cs-colloquium/' },
      { label: 'GCCIS PhD Colloquium Series, as From Networks to Neural Networks · Oct 2, 2026 · Rochester Institute of Technology', href: 'https://aquastar.github.io/talks/graph-inside/2026-10-02-gccis-phd/' },
    ],
    links: [
      { label: 'Slides (latest)', href: 'https://aquastar.github.io/talks/graph-inside/', kind: 'slides' },
      { label: 'Source', href: 'https://github.com/aquastar/talks/tree/main/graph-inside', kind: 'code' },
    ],
  },
  {
    tag: 'Talk', year: '2026',
    title: 'AI Literacy for CS Faculty',
    desc: 'How today\'s AI works, from next token prediction to agents, and how fast it is changing.',
    thumb: '/talks-thumbs/ai-literacy.webp',
    events: [{ label: 'CS Faculty Meeting · Nov 3, 2026 · Rochester Institute of Technology, Rochester, NY', href: 'https://aquastar.github.io/talks/ai-literacy/2026-11-03-faculty-meeting/' }],
    links: [
      { label: 'Slides (online)', href: 'https://aquastar.github.io/talks/ai-literacy/', kind: 'slides' },
      { label: 'Source', href: 'https://github.com/aquastar/talks/tree/main/ai-literacy', kind: 'code' },
    ],
  },
  {
    tag: 'Tutorial', year: '2026',
    title: 'Uncertainty Quantification for Dynamical Networks',
    desc: 'Uncertainty quantification and state estimation for graph dynamics.',
    thumb: '/talks-thumbs/uq-dynamical.webp',
    events: [
      { label: 'IEEE BigData 2026 · upcoming' },
      { label: 'WSDM 2026 · Feb 22 to 26 · Boise, ID', href: 'https://wsdm-conference.org/2026/index.php/tutorials/' },
    ],
    links: [
      { label: 'Slides (online)', href: 'https://aquastar.github.io/uq-dynamical-networks/', kind: 'slides' },
      { label: 'PDF', href: 'https://github.com/aquastar/uq-dynamical-networks/blob/master/State%20Estimation%20for%20Dynamical%20Networks.pdf', kind: 'pdf' },
    ],
  },
  {
    tag: 'Tutorial series', year: '2024–2025',
    title: 'Unifying Spectral and Spatial Graph Neural Networks',
    desc: 'An operator-level view that connects spectral and spatial GNNs.',
    thumb: '/talks-thumbs/spectral-gnn.webp',
    events: [
      { label: 'CVPR 2024 · Jun 18 · Seattle, WA', href: 'https://cvpr.thecvf.com/virtual/2024/tutorial/23726' },
      { label: 'CIKM 2024 · Oct 21 · Boise, ID', href: 'https://cikm2024.org/tutorials/' },
      { label: 'SIAM MDS 2024 · Oct 23 · Atlanta, GA', href: 'https://meetings.siam.org/sess/dsp_programsess.cfm?SESSIONCODE=80791' },
      { label: 'SIAM SDM 2025 · May 3 · Washington, DC', href: 'https://meetings.siam.org/sess/dsp_programsess.cfm?SESSIONCODE=84896' },
      { label: '机器之心 (Synced) online talk · 2024' },
    ],
    links: [
      { label: 'Slides', href: 'https://drive.google.com/file/d/1gbe9xxNHPHHHN5DKRu3fC8f_G9TPcayt/view?usp=sharing', kind: 'slides' },
      { label: 'Awesome Spectral GNN', href: 'https://github.com/XGraph-Team/Spectral-Graph-Survey/tree/master', kind: 'code' },
    ],
  },
  {
    tag: 'Paper talk', year: '2023',
    title: 'Understanding Influence Maximization via Higher-Order Decomposition',
    desc: 'With Zonghan Zhang. Sobol indices split a seed\'s own effect from its interactions.',
    thumb: '/talks-thumbs/influence-max.webp',
    events: [{ label: 'SIAM SDM 2023 · Apr 27 to 29 · Minneapolis, MN', href: 'https://epubs.siam.org/doi/abs/10.1137/1.9781611977653.ch86' }],
    links: [
      { label: 'Slides (PDF)', href: 'https://aquastar.github.io/influence-max-higher-order/slides.pdf', kind: 'slides' },
    ],
  },
  {
    tag: 'Paper talk', year: '2022',
    title: 'Early Forecasting of the Impact of Traffic Accidents Using a Single Shot Observation',
    desc: '',
    events: [{ label: 'SIAM SDM 2022 · Minneapolis, MN' }],
    links: [],
  },
  {
    tag: 'Tutorial', year: '2021',
    title: 'Studying Spread Patterns of COVID-19 Based on Spatiotemporal Data',
    desc: 'With Beiyu Lin and Xiaowei Jia. Epidemic spreading models: GNN, RNN, SIR and PDE.',
    events: [{ label: 'SIAM SDM 2021 · April · online' }],
    links: [],
  },
];
---
<Layout title="Talks | Zhiqian Chen">
  <main class="container">
    <Nav current="talks" />
    <section class="hero">
      <h1>Talks</h1>
      <p>Talks and tutorials, with slides kept online for collaborators and students. Courses and the teaching award are on the <a href="/teaching">Teaching</a> page.</p>
    </section>
    <section class="section talks-col only">
            <ol class="talks">
        {talks.map((t) => (
          <li class="talk">
            <div class="talk-year">{t.year}</div>
            <div class="talk-body">
              <div class="talk-title">{t.title} <span class="talk-kind">{t.tag}</span></div>
              <div class="talk-events">
                {t.events.map((e) => (
                  <span class="talk-event">{e.href ? <a href={e.href} target="_blank" rel="noopener">{e.label}</a> : e.label}</span>
                ))}
              </div>
              {t.desc && <div class="talk-desc">{t.desc}</div>}
              {t.links.length > 0 && (
                <div class="talk-links">
                  {t.links.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener">[{l.label}]</a>
                  ))}
                </div>
              )}
            </div>
            <div class="talk-thumb">
              {t.thumb && (
                <a href={t.links[0].href} target="_blank" rel="noopener" aria-label={`Open the slides for ${t.title}`}>
                  <img src={t.thumb} alt={`Title slide of ${t.title}`} loading="lazy" width="640" height="360" />
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Layout>
<style>
  :root { --accent:#C45200; --ink:#16202B; --muted:#4E5C6A; }
  .container { max-width: min(95vw, 1600px); margin: 0 auto; padding: 20px; box-sizing: border-box; }
  .hero { margin: 10px 0 18px; }
  .hero h1 { font-family:'et-book',Palatino,serif; font-size:2rem; margin:0 0 8px; }
  .hero p a { color:#A84600; }
  .hero p { margin:0; color:var(--muted); max-width:780px; }
  .section { padding-top:18px; margin-top:26px; border-top:none; }
  .section h2 { font-family:'et-book',Palatino,serif; font-size:1.1rem; margin:0 0 14px; }
  .cards { display:grid; gap:14px; }
  .cards.two { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .card { border:1px solid rgba(148,163,184,.16); border-radius:6px; background:#F7F9FC; padding:16px; }
  .card h3, .card p { text-align:left; }
  .card h3 { font-family:'et-book',Palatino,serif; font-size:1rem; margin:0 0 8px; }
  .card p { margin:0; color:#2E3A47; font-size:.95rem; }
  .tags { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:8px; }
  .tag { display:inline-block; font-size:.72rem; color:var(--accent); background:#FAD6BA; padding:3px 8px; border-radius:999px; }
  .tag-current { color:#007A94; background:#dcfce7; font-weight:700; }
  .tag-past { color:#4E5C6A; background:#EAF0F6; }
  .card.is-current { border-color:rgba(22,101,52,.28); }
  .school { margin:0 0 6px !important; font-size:.8rem; color:#4E5C6A; }
  .schedule-box { border:1px dashed rgba(247,105,2,.28); border-radius:6px; padding:14px; background:#f8fbff; color:#2E3A47; }
  /* Talks on the left, the award and the course list in a sticky column on the right. */
  .teach-grid { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(320px,1fr); gap:40px; align-items:start; }
  .talks-col.only { margin-top:0; padding-top:0; max-width:1240px; }
  .talks-col.only .talk { grid-template-columns:72px minmax(0,1fr) 220px; gap:18px; padding:14px 0; align-items:start; }
  .talks-col.only .talk-desc { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .talk-thumb a { display:block; border-radius:6px; overflow:hidden; border:1px solid #DCE5EE; background:#fff; aspect-ratio:16/9; }
  .talk-thumb img { display:block; width:100%; height:100%; object-fit:cover; transition:transform .2s; }
  .talk-thumb a:hover img { transform:scale(1.03); }
  .teach-grid > .section, .teach-side > .section { margin-top:0; padding-top:0; }
  .teach-side { position:sticky; top:16px; display:flex; flex-direction:column; gap:22px; }
  .talks, .courses { list-style:none; margin:0; padding:0; border-top:1px solid #DCE5EE; }
  .talk { display:grid; grid-template-columns:72px 1fr; gap:12px; padding:10px 0; border-bottom:1px solid #DCE5EE; }
  .talk-year { font-family:'et-book',Palatino,serif; font-size:.78rem; color:#4E5C6A; padding-top:2px; }
  .talk-title { text-align:left; font-family:'et-book',Palatino,serif; font-size:.9rem; font-weight:600; color:#16202B; line-height:1.35; }
  .talk-kind { font-family:inherit; font-weight:400; font-size:.66rem; color:#4E5C6A; border:1px solid #C9D4DF; border-radius:4px; padding:0 5px; margin-left:6px; vertical-align:2px; white-space:nowrap; }
  .talk-kind.is-current { color:#007A94; border-color:#86efac; background:#E8F4F6; }
  .talk-events { display:flex; flex-wrap:wrap; gap:4px 6px; margin-top:4px; }
  .talk-events .talk-event { margin:0; padding:1px 8px; border-radius:999px; background:#EAF0F6; font-style:normal; }
  .talk-event { font-size:.78rem; color:#2E3A47; font-style:italic; margin-top:2px; line-height:1.4; }
  .talk-event a { color:inherit; text-decoration:none; }
  .talk-event a:hover { text-decoration:underline; }
  .talk-desc { font-size:.82rem; color:#2E3A47; margin-top:4px; line-height:1.55; text-align:left; }
  .talk-links { margin-top:3px; font-size:.78rem; display:flex; flex-wrap:wrap; gap:10px; }
  .talk-links a { color:#A84600; text-decoration:none; }
  .talk-links a:hover { text-decoration:underline; }
  .course { padding:7px 0; border-bottom:1px solid #DCE5EE; }
  .course-star { color:#A84600; font-size:.75rem; margin-left:6px; }
  .award h2 i { color:#A84600; }
  .course-project { padding:12px; border:1px solid #fcd34d; border-radius:6px; background:#FDF1E7; }
  .project-head { display:flex; flex-wrap:wrap; align-items:baseline; gap:4px 8px; margin:10px 0 5px; }
  .project-award { flex:0 0 100%; font-family:'et-book',Palatino,serif; font-size:.82rem; font-weight:700; color:#92400e; }
  .project-title { font-family:'et-book',Palatino,serif; font-weight:700; font-size:.9rem; color:#16202B; }
  .project-course { text-align:left; font-size:.75rem; color:#4E5C6A; }
  .project-desc { margin:0; font-size:.82rem; color:#2E3A47; line-height:1.55; text-align:left; }
  .project-media { margin:0; }
  /* preload="none": the 4.8MB file is only fetched once the clip is on screen. */
  .project-video { display:block; width:100%; height:auto; border-radius:8px; background:#16202B; }

  @media (max-width: 1000px) {
    .teach-grid { grid-template-columns:1fr; gap:26px; }
    .teach-side { position:static; order:-1; }
  }
  @media (max-width: 700px) {
    .talk, .talks-col.only .talk { grid-template-columns:1fr; gap:4px; }
    .talks-col.only .talk-desc { white-space:normal; }
    .talk-thumb { max-width:300px; margin-top:6px; }
    .talk-thumb:empty { display:none; }
  }
  @media (max-width: 900px) { .cards.two { grid-template-columns:1fr; } }
</style>
