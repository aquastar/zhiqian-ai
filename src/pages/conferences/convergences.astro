---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { DOMAINS } from '../../data/domains.js';
import { convergences as C } from '../../data/convergences.js';

// Research directions made by joining two fields the conference pages
// already track. Pairs were proposed, screened against OpenAlex for papers
// mentioning both sides, the survivors checked by hand against the web, and
// the rest scored for novelty. The data and the reasoning live in
// src/data/convergences.js; this page only lays them out.
const FIELD = Object.fromEntries(DOMAINS.map((d) => [d.id, d]));
const field = (id) => FIELD[id] || { label: id, icon: 'fa-circle', hue: '#64748b' };

const PARTS = [
  ['gap', 'Gap', 'How clearly the search came up empty: no paper joining the two, versus a few near misses.'],
  ['distance', 'Distance', 'How far apart the two fields are: neighbours within computing score low, computing with theology high.'],
  ['depth', 'Depth', 'Whether the link is a working mechanism, a method or a model carried across, rather than a metaphor or "apply ML to X".'],
  ['payoff', 'Payoff', 'What either field would gain if it worked: a new measurement, a guarantee, a cheaper method.'],
];

const OUTCOME = {
  top: ['Top 20', 'o-top'],
  open: ['Open, ranked lower', 'o-open'],
  done: ['Already done', 'o-done'],
  dropped: ['Dropped at screening', 'o-drop'],
};
const ORDER = { top: 0, open: 1, done: 2, dropped: 3 };
const pool = [...C.pool].sort((a, b) => ORDER[a.outcome] - ORDER[b.outcome] || a.joint - b.joint);
const n = (k) => C.pool.filter((p) => p.outcome === k).length;
---

<Layout title="Convergences | Zhiqian Chen">
  <main class="container">
    <Nav current="convergences" />

    <section class="head">
      <h1>Convergences</h1>
      <p class="lede">
        One way new research starts is by connecting two things nobody has connected yet. These are the 20
        most novel connections between the fields on the <a href="/conferences">conference pages</a>, each a
        specific idea from one field put to work on a specific problem in another, and each checked to see
        that nobody has done it yet.
      </p>
      <ol class="funnel" aria-label="How the list was made">
        <li><b>{C.pool.length}</b><span>pairs proposed from the fields' most published topics</span></li>
        <li><b>{C.screenedOpen}</b><span>with three or fewer papers mentioning both, in Semantic Scholar and Europe PMC</span></li>
        <li><b>{C.verified}</b><span>checked by hand against the web for the closest prior work</span></li>
        <li><b>20</b><span>kept, ranked by a novelty score out of 10</span></li>
      </ol>
    </section>

    <ol class="list">
      {C.top.map((t) => {
        const a = field(t.fa), b = field(t.fb);
        return (
          <li class="card" id={t.id}>
            <div class="rank">
              <span class="rank-n">{t.rank}</span>
              <span class="score" title="Novelty score out of 10, the mean of the four parts below">{t.score.toFixed(1)}</span>
            </div>
            <div class="body">
              <div class="pair">
                <a class="fchip" href={`/conferences#${t.fa}`} style={`--hue:${a.hue}`}><i class={`fas ${a.icon}`} aria-hidden="true"></i>{a.label}</a>
                <span class="x" aria-label="meets">×</span>
                <a class="fchip" href={`/conferences#${t.fb}`} style={`--hue:${b.hue}`}><i class={`fas ${b.icon}`} aria-hidden="true"></i>{b.label}</a>
              </div>
              <h2>{t.title}</h2>
              <p class="gap"><b>Not yet done.</b> {t.gap}</p>
              <p class="why"><b>Why it could work.</b> {t.bridge}</p>
              <div class="prior">
                <b>Closest work found.</b>
                {t.nearest.length
                  ? <ul>{t.nearest.map((p) => <li>{p.u ? <a href={p.u} target="_blank" rel="noopener">{p.t}</a> : p.t}{p.note && <span class="pnote"> · {p.note}</span>}</li>)}</ul>
                  : <span> nothing that joins the two.</span>}
              </div>
              <div class="meta">
                <span class="hits" title={`OpenAlex works whose title or abstract contains both "${t.qa}" and "${t.qb}"`}>
                  <i class="fas fa-magnifying-glass" aria-hidden="true"></i>{t.joint} {t.joint === 1 ? 'paper mentions' : 'papers mention'} both key phrases · {t.verdict === 'OPEN' ? 'nothing joins them' : 'adjacent work only'}
                </span>
                <span class="parts">
                  {PARTS.map(([k, label, tip]) => (
                    <span class="part" title={tip}><span class="plabel">{label}</span><span class="bar"><i style={`width:${t.parts[k] * 10}%`}></i></span><span class="pval">{t.parts[k]}</span></span>
                  ))}
                </span>
              </div>
            </div>
          </li>
        );
      })}
    </ol>

    <details class="pool">
      <summary>All {C.pool.length} pairs screened <span class="sum-note">{n('top')} in the top 20 · {n('open')} open but ranked lower · {n('done')} already done · {n('dropped')} dropped at screening</span></summary>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Pair</th><th>Fields</th><th title="OpenAlex works whose title or abstract contains both search phrases">Both</th><th>Outcome</th></tr></thead>
          <tbody>
            {pool.map((p) => (
              <tr>
                <td>{p.title}{p.note && <span class="pnote"> · {p.note}</span>}</td>
                <td class="fields">{field(p.fa).label} × {field(p.fb).label}</td>
                <td class="num">{p.joint ?? '?'}</td>
                <td><span class={`outcome ${OUTCOME[p.outcome][1]}`}>{OUTCOME[p.outcome][0]}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>

    <section class="method">
      <h2>How this was made</h2>
      <ul>
        {C.method.map((m) => <li>{m}</li>)}
      </ul>
      <p class="built">Built {C.built}. A gap found by search is evidence, not proof: a paper using other words for the same idea can be missed.</p>
    </section>
  </main>
</Layout>

<style>
  .container { max-width: min(95vw, 1180px); margin: 0 auto; padding: 20px; box-sizing: border-box; }
  .head h1 { font-size: 1.6rem; margin: 4px 0 6px; letter-spacing: -.02em; text-align: left; }
  .lede { margin: 0 0 14px; color: #334155; font-size: .95rem; line-height: 1.65; max-width: 78ch; text-align: left; }
  .lede a { color: #1d4ed8; text-decoration: none; border-bottom: 1px solid rgba(29,78,216,.3); }
  .funnel { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 8px; margin: 0 0 18px; padding: 0; }
  .funnel li { display: flex; gap: 10px; align-items: baseline; padding: 9px 12px; border: 1px solid rgba(148,163,184,.3);
    border-radius: 10px; background: #fff; }
  .funnel b { font-size: 1.25rem; color: #0f172a; font-variant-numeric: tabular-nums; }
  .funnel span { font-size: .76rem; line-height: 1.35; color: #475569; text-align: left; }

  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .card { display: grid; grid-template-columns: 64px minmax(0,1fr); gap: 14px; padding: 14px 16px;
    border: 1px solid rgba(148,163,184,.3); border-radius: 12px; background: #fff; }
  .rank { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .rank-n { font-family: 'Montserrat', sans-serif; font-size: .72rem; font-weight: 700; color: #94a3b8; }
  .score { font-size: 1.35rem; font-weight: 800; color: #0f172a; font-variant-numeric: tabular-nums; cursor: help; }
  .pair { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin-bottom: 4px; }
  .fchip { display: inline-flex; align-items: center; gap: 5px; padding: 2px 9px; border-radius: 999px; text-decoration: none;
    font-size: .74rem; font-weight: 700; color: var(--hue); background: color-mix(in srgb, var(--hue) 10%, white);
    border: 1px solid color-mix(in srgb, var(--hue) 25%, white); }
  .fchip i { font-size: .7rem; }
  .x { color: #94a3b8; font-weight: 700; }
  .card h2 { font-size: 1.05rem; margin: 2px 0 6px; line-height: 1.35; text-align: left; color: #0f172a; }
  .card p, .prior { margin: 0 0 5px; font-size: .86rem; line-height: 1.55; color: #334155; text-align: left; }
  .card b { color: #0f172a; }
  .prior ul { margin: 2px 0 0; padding-left: 18px; }
  .prior li { font-size: .8rem; line-height: 1.5; }
  .prior a { color: #1d4ed8; text-decoration: none; }
  .prior a:hover { text-decoration: underline; }
  .pnote { color: #64748b; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; margin-top: 8px;
    padding-top: 8px; border-top: 1px solid rgba(148,163,184,.2); }
  .hits { font-size: .74rem; color: #64748b; cursor: help; }
  .hits i { margin-right: 5px; font-size: .68rem; }
  .parts { display: flex; flex-wrap: wrap; gap: 6px 14px; }
  .part { display: inline-flex; align-items: center; gap: 5px; cursor: help; }
  .plabel { font-size: .68rem; font-weight: 700; color: #64748b; }
  .bar { width: 44px; height: 5px; border-radius: 3px; background: #e2e8f0; overflow: hidden; }
  .bar i { display: block; height: 100%; background: #334155; }
  .pval { font-size: .7rem; font-weight: 700; color: #0f172a; font-variant-numeric: tabular-nums; }

  .pool { margin-top: 22px; border: 1px solid rgba(148,163,184,.3); border-radius: 12px; background: #fff; }
  .pool summary { cursor: pointer; padding: 10px 14px; font-weight: 700; font-size: .9rem; color: #0f172a; }
  .sum-note { font-weight: 500; font-size: .76rem; color: #64748b; margin-left: 8px; }
  .table-wrap { overflow-x: auto; border-top: 1px solid rgba(148,163,184,.25); }
  .pool table { width: 100%; border-collapse: collapse; font-size: .8rem; }
  .pool th { text-align: left; font-size: .64rem; letter-spacing: .08em; text-transform: uppercase; color: #64748b;
    padding: 7px 10px; background: #f8fafc; white-space: nowrap; }
  .pool td { padding: 6px 10px; border-top: 1px solid rgba(148,163,184,.15); vertical-align: top; text-align: left; }
  .pool td.fields { color: #64748b; white-space: nowrap; }
  .pool td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .outcome { font-size: .68rem; font-weight: 700; padding: 1px 7px; border-radius: 999px; white-space: nowrap; }
  .o-top { background: #0f172a; color: #fff; }
  .o-open { background: #e0f2fe; color: #075985; }
  .o-done { background: #fee2e2; color: #991b1b; }
  .o-drop { background: #f1f5f9; color: #64748b; }

  .method { margin-top: 22px; }
  .method h2 { font-family: 'Montserrat', sans-serif; font-size: .78rem; font-weight: 700; letter-spacing: .1em;
    text-transform: uppercase; color: #64748b; margin: 0 0 6px; text-align: left; }
  .method li, .built { font-size: .84rem; line-height: 1.6; color: #334155; text-align: left; }
  .built { color: #64748b; font-size: .78rem; }

  @media (max-width: 760px) {
    .funnel { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .card { grid-template-columns: 1fr; gap: 6px; }
    .rank { flex-direction: row; justify-content: flex-start; gap: 10px; }
    .pool td.fields { white-space: normal; }
  }
</style>
