---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { destinations } from '../../data/destinations.js';
import { GROUPS } from '../../data/domains.js';

// Every upcoming edition of every conference the site tracks, on a world
// map that fills the screen. One pin per city, sized by how many meetings
// it holds; clicking a city lists them in a panel. The filters float over
// the map and apply to the pins and the panel alike.
//
// Leaflet with clustered markers on OpenStreetMap tiles. Coordinates come
// from build-destinations.py, looked up once per place and cached.
const COLORS = { computing: '#6d28d9', math: '#b45309', science: '#0f766e', mind: '#be185d', other: '#64748b' };
const groups = [...GROUPS, { id: 'other', label: 'Other fields' }]
  .map((g) => ({ ...g, color: COLORS[g.id], n: destinations.items.filter((i) => (i.group || 'other') === g.id).length }))
  .filter((g) => g.n);
const items = destinations.items.map((i, k) => ({
  k, t: i.title, d: i.desc, y: i.year, date: i.date, place: i.place, f: i.field || '',
  g: i.group || 'other', dl: i.deadline || '', link: i.link || '',
  pins: i.pins || (i.lat != null ? [[i.lat, i.lon]] : []),
  h: (i.honors || []).map((x) => x.t),
}));
---

<Layout title="Conferences by destination | Zhiqian Chen">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/MarkerCluster.min.css" />
  <main class="container">
    <Nav current="destinations" />
  </main>

  <div class="stage">
    <div id="map" role="region" aria-label="World map of conference locations"></div>

    {/* Filters, floating over the map. */}
    <section class="panel controls" aria-label="Filters">
      <h1>Conferences by destination <span id="count">{items.length}</span></h1>
      <div class="gfilter" role="group" aria-label="Field group">
        <button type="button" class="gchip is-on" data-g="all">All</button>
        {groups.map((g) => (
          <button type="button" class="gchip" data-g={g.id}>
            <i class="dot" style={`background:${g.color}`}></i>{g.label}
          </button>
        ))}
      </div>
      <div class="ffilter" id="ffilter" hidden></div>
      <div class="row">
        <label class="opt"><input type="checkbox" id="open-only" /> Call still open</label>
        <input type="search" id="q" placeholder="Search a city or conference" aria-label="Search" />
      </div>
      <p class="hint">Click a city for its meetings.</p>
    </section>

    {/* The city's meetings, opened by a click on its pin. */}
    <aside class="panel city" id="city" hidden aria-live="polite">
      <header>
        <div>
          <h2 id="city-name"></h2>
          <span id="city-sub"></span>
        </div>
        <button type="button" id="city-x" aria-label="Close">&times;</button>
      </header>
      <ol id="city-list"></ol>
    </aside>
  </div>

  <script is:inline type="application/json" id="dest-data" set:html={JSON.stringify({ items, colors: COLORS })}></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/leaflet.markercluster.min.js"></script>
  <script is:inline>
    (function () {
      const { items, colors } = JSON.parse(document.getElementById('dest-data').textContent);
      const today = new Date().toISOString().slice(0, 10);
      const esc = (s) => String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      const days = (d) => Math.round((Date.parse(d) - Date.parse(today)) / 86400000);
      const isOpen = (i) => i.dl && i.dl >= today;
      // A city's label: the place string without venue or street, so
      // "World Forum, Hague, Netherlands" reads as "Hague, Netherlands".
      const cityOf = (place) => {
        const parts = place.split(';')[0].split(',').map((x) => x.trim()).filter(Boolean);
        return parts.length > 2 ? parts.slice(-2).join(', ') : parts.join(', ');
      };

      const map = L.map('map', { worldCopyJump: true, minZoom: 2, zoomControl: false }).setView([28, 10], 3);
      L.control.zoom({ position: 'bottomleft' }).addTo(map);
      // OpenStreetMap's own tiles, free for a light-traffic site with the
      // attribution shown.
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors', maxZoom: 19,
      }).addTo(map);
      // Clusters count meetings, not cities, so a number means the same
      // thing on a cluster as on a city pin.
      const cluster = L.markerClusterGroup({
        showCoverageOnHover: false, maxClusterRadius: 45,
        iconCreateFunction: (c) => {
          const n = c.getAllChildMarkers().reduce((a, m) => a + m.options.n, 0);
          const size = Math.round(30 + Math.min(26, Math.sqrt(n) * 3));
          return L.divIcon({ html: `<span>${n}</span>`, className: 'clu', iconSize: [size, size] });
        },
      });
      map.addLayer(cluster);

      const state = { g: 'all', f: '', open: false, q: '', city: null };
      const match = (i) => (state.g === 'all' || i.g === state.g)
        && (!state.f || i.f === state.f)
        && (!state.open || isOpen(i))
        && (!state.q || `${i.t} ${i.d} ${i.place} ${i.f}`.toLowerCase().includes(state.q));

      // One pin per city. A meeting held in several cities is listed in each.
      const cities = () => {
        const by = new Map();
        items.filter(match).forEach((i) => i.pins.forEach((p, n) => {
          const key = p[0].toFixed(2) + ',' + p[1].toFixed(2);
          if (!by.has(key)) by.set(key, { key, ll: p, name: cityOf(i.place.split(';')[n] || i.place), items: [] });
          by.get(key).items.push(i);
        }));
        return [...by.values()];
      };
      const colorOf = (c) => {
        const tally = {};
        c.items.forEach((i) => { tally[i.g] = (tally[i.g] || 0) + 1; });
        return colors[Object.entries(tally).sort((a, b) => b[1] - a[1])[0][0]] || colors.other;
      };

      const panel = document.getElementById('city');
      const showCity = (c) => {
        state.city = c ? c.key : null;
        if (!c) { panel.hidden = true; return; }
        document.getElementById('city-name').textContent = c.name;
        document.getElementById('city-sub').textContent = `${c.items.length} meeting${c.items.length > 1 ? 's' : ''}`;
        const list = c.items.slice().sort((a, b) => a.y - b.y || a.t.localeCompare(b.t));
        document.getElementById('city-list').innerHTML = list.map((i) => `
          <li>
            <div class="c-top">
              ${i.link ? `<a href="${esc(i.link)}" target="_blank" rel="noopener">${esc(i.t)}</a>` : `<b>${esc(i.t)}</b>`}
              <span class="c-y">${i.y}</span>
              ${i.f ? `<span class="c-f" style="--c:${colors[i.g] || colors.other}">${esc(i.f)}</span>` : ''}
            </div>
            <span class="c-d">${esc(i.d)}</span>
            <span class="c-w">${esc(i.date)}</span>
            <span class="c-dl">${i.dl ? (isOpen(i) ? `<b class="open">deadline ${esc(i.dl)} &middot; ${days(i.dl)}d</b>` : `deadline ${esc(i.dl)}, closed`) : 'deadline not published'}</span>
            ${i.h.length ? `<span class="c-h">${i.h.map((h) => `<i>${esc(h)}</i>`).join('')}</span>` : ''}
          </li>`).join('');
        panel.hidden = false;
      };
      document.getElementById('city-x').addEventListener('click', () => showCity(null));

      const draw = () => {
        const cs = cities();
        cluster.clearLayers();
        cluster.addLayers(cs.map((c) => {
          const n = c.items.length;
          const m = L.circleMarker(c.ll, {
            n, radius: 6 + Math.min(10, Math.sqrt(n) * 2.2), color: '#fff', weight: 1.5,
            fillColor: colorOf(c), fillOpacity: 0.92,
          });
          m.bindTooltip(`${esc(c.name)} &middot; ${n}`, { direction: 'top', offset: [0, -6] });
          m.on('click', () => showCity(c));
          return m;
        }));
        document.getElementById('count').textContent = items.filter(match).length;
        if (state.city) showCity(cs.find((c) => c.key === state.city) || null);
      };

      const ffilter = document.getElementById('ffilter');
      const drawFields = () => {
        state.f = '';
        if (state.g === 'all') { ffilter.hidden = true; ffilter.innerHTML = ''; return; }
        const counts = {};
        items.filter((i) => i.g === state.g).forEach((i) => { counts[i.f] = (counts[i.f] || 0) + 1; });
        const fields = Object.entries(counts).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
        ffilter.innerHTML = `<button type="button" class="fchip is-on" data-f="">Every field</button>`
          + fields.map(([f, n]) => `<button type="button" class="fchip" data-f="${esc(f)}">${esc(f)} <span>${n}</span></button>`).join('');
        ffilter.hidden = false;
        ffilter.querySelectorAll('.fchip').forEach((b) => b.addEventListener('click', () => {
          ffilter.querySelectorAll('.fchip').forEach((x) => x.classList.toggle('is-on', x === b));
          state.f = b.dataset.f; draw();
        }));
      };
      document.querySelectorAll('.gchip').forEach((b) => b.addEventListener('click', () => {
        document.querySelectorAll('.gchip').forEach((x) => x.classList.toggle('is-on', x === b));
        state.g = b.dataset.g; drawFields(); draw();
      }));
      document.getElementById('open-only').addEventListener('change', (e) => { state.open = e.target.checked; draw(); });
      document.getElementById('q').addEventListener('input', (e) => { state.q = e.target.value.trim().toLowerCase(); draw(); });
      draw();
    })();
  </script>
</Layout>

<style>
  .container { max-width: min(95vw, 1600px); margin: 0 auto; padding: 20px 20px 0; box-sizing: border-box; }
  /* The map takes the whole screen under the nav, edge to edge. */
  .stage { position: relative; height: calc(100vh - 86px); min-height: 480px; }
  #map { position: absolute; inset: 0; z-index: 0; }
  .panel { position: absolute; z-index: 500; background: rgba(255,255,255,.96); border: 1px solid rgba(148,163,184,.35);
    border-radius: 14px; box-shadow: 0 12px 30px rgba(15,23,42,.16); backdrop-filter: blur(6px); }
  .controls { top: 14px; left: 14px; width: min(440px, calc(100vw - 28px)); padding: 12px 14px; }
  .controls h1 { font-size: 1.05rem; margin: 0 0 8px; letter-spacing: -.01em; text-align: left; }
  .controls h1 span { font-size: .72rem; font-weight: 700; color: #64748b; background: #f1f5f9; border-radius: 999px; padding: 1px 8px; margin-left: 4px; vertical-align: 2px; }
  .gfilter, .ffilter { display: flex; flex-wrap: wrap; gap: 5px; }
  .ffilter { margin-top: 7px; padding-top: 7px; border-top: 1px dashed rgba(148,163,184,.4); }
  .ffilter[hidden] { display: none; }
  .gchip, .ffilter :global(.fchip) { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 999px;
    border: 1px solid rgba(148,163,184,.45); background: #fff; font: inherit; font-size: .74rem; font-weight: 600; color: #334155; cursor: pointer; }
  .gchip .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .ffilter :global(.fchip span) { color: #a3adbb; font-size: .66rem; font-weight: 700; }
  .gchip.is-on, .ffilter :global(.fchip.is-on) { background: #1e293b; border-color: #1e293b; color: #fff; }
  .ffilter :global(.fchip.is-on span) { color: rgba(255,255,255,.7); }
  .row { display: flex; align-items: center; gap: 10px; margin-top: 9px; }
  .opt { font-size: .76rem; color: #475569; display: inline-flex; align-items: center; gap: 5px; cursor: pointer; white-space: nowrap; }
  #q { flex: 1; min-width: 0; padding: 4px 10px; border: 1px solid rgba(148,163,184,.5); border-radius: 999px; font: inherit; font-size: .76rem; }
  .hint { margin: 7px 0 0; font-size: .7rem; color: #94a3b8; }

  .city { top: 14px; right: 14px; bottom: 14px; width: min(380px, calc(100vw - 28px)); display: flex; flex-direction: column; }
  .city[hidden] { display: none; }
  .city header { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; padding: 12px 14px 8px;
    border-bottom: 1px solid rgba(148,163,184,.25); }
  .city h2 { font-size: 1rem; margin: 0; text-align: left; }
  #city-sub { font-size: .72rem; color: #64748b; }
  #city-x { border: 0; background: none; font-size: 1.4rem; line-height: 1; color: #94a3b8; cursor: pointer; }
  #city-list { list-style: none; margin: 0; padding: 6px 14px 12px; overflow-y: auto; display: grid; gap: 2px; }
  #city-list :global(li) { padding: 8px 0; border-bottom: 1px solid rgba(148,163,184,.18); display: flex; flex-direction: column; gap: 2px; text-align: left; }
  #city-list :global(.c-top) { display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
  #city-list :global(.c-top a), #city-list :global(.c-top b) { font-weight: 700; color: #0f172a; text-decoration: none; font-size: .88rem; }
  #city-list :global(.c-top a:hover) { color: var(--accent); text-decoration: underline; }
  #city-list :global(.c-y) { font-size: .62rem; font-weight: 800; color: #fff; background: #334155; border-radius: 4px; padding: 0 5px; }
  #city-list :global(.c-f) { font-size: .62rem; font-weight: 700; color: var(--c); background: color-mix(in srgb, var(--c) 10%, white); border-radius: 4px; padding: 1px 6px; }
  #city-list :global(.c-d) { font-size: .72rem; color: #8a95a5; }
  #city-list :global(.c-w) { font-size: .78rem; color: #334155; }
  #city-list :global(.c-dl) { font-size: .74rem; color: #94a3b8; }
  #city-list :global(.c-dl .open) { color: #0f766e; }
  #city-list :global(.c-h) { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 2px; }
  #city-list :global(.c-h i) { font-style: normal; font-size: .64rem; font-weight: 700; color: #854d0e; background: #fefce8; border: 1px solid #fde68a; border-radius: 5px; padding: 0 6px; }

  /* Leaflet's own stylesheet loads after this one, so the rule needs its
     class to win. */
  :global(.leaflet-marker-icon.clu) { display: flex; align-items: center; justify-content: center; border-radius: 50%;
    background: rgba(30,41,59,.82); color: #fff; font-weight: 800; font-size: .78rem; border: 2px solid #fff; box-shadow: 0 2px 8px rgba(15,23,42,.3); }

  @media (max-width: 760px) {
    .container { padding: 10px 14px 0; }
    .stage { height: calc(100vh - 62px); }
    .controls { top: 10px; left: 10px; right: 10px; width: auto; padding: 10px 12px; }
    .hint { display: none; }
    /* On a phone the city list is a sheet from the bottom. */
    .city { top: auto; left: 10px; right: 10px; bottom: 10px; width: auto; max-height: 55%; }
  }
</style>
