---
import Layout from '../layouts/Layout.astro';



// Deadlines, Sep 2026 - Feb 2027. `kind` drives the colour and follows the
// source legend: NSF grant, NIH grant, other grant, paper, review/report.
const deadlines = [
  { month: 'Sep 2026', y: 2026, m: 8, items: [
    { d: 15, name: 'Sony Research Award (FRA)', kind: 'other' },
    { d: 18, name: 'ICLR 2027 abstract registration (mandatory)', kind: 'paper' },
    { d: 25, name: 'ICLR 2027 full paper', kind: 'paper' },
    { d: 28, name: 'NIH R16 SuRE', kind: 'nih' },
  ]},
  { month: 'Oct 2026', y: 2026, m: 9, items: [
    { d: 9, name: 'NSF MFAI', kind: 'nsf' },
    { d: 12, name: 'NAACL 2027 (main)', kind: 'paper' },
    { d: 12, name: 'COLING 2027 (main)', kind: 'paper' },
    { d: 14, name: 'IEEE BigData reviews due', kind: 'review' },
    { d: 15, name: 'WSDM 2027 demo', kind: 'paper' },
    { d: 16, name: 'NIH R21 new (standing date)', kind: 'nih' },
    { d: 18, name: 'WebConf abstract (research + industry)', kind: 'paper' },
    { d: 25, name: 'WebConf full paper', kind: 'paper' },
    { d: 26, name: 'NIH R15 AREA new (Oct 25 shift)', kind: 'nih' },
    { d: 29, name: 'NSF CIRC final + outcomes report', kind: 'review' },
    { d: 30, name: 'RIT Global Seed', kind: 'other' },
    { d: 30, name: 'ONR YIP', kind: 'other' },
  ]},
  { month: 'Nov 2026', y: 2026, m: 10, items: [
    { d: 4, name: 'NSF AI Datasets', kind: 'nsf' },
    { d: 4, name: 'NSF SBIR/STTR', kind: 'nsf' },
    { d: 7, name: 'CVPR 2027 abstract', kind: 'paper', est: true },
    { d: 9, name: 'WebConf short abstract', kind: 'paper' },
    { d: 9, name: 'Web4Good abstract', kind: 'paper' },
    { d: 13, name: 'CVPR 2027 main paper', kind: 'paper', est: true },
    { d: 16, name: 'WebConf short paper', kind: 'paper' },
    { d: 16, name: 'Web4Good full paper', kind: 'paper' },
    { d: 16, name: 'WebConf demo paper', kind: 'paper' },
    { d: 17, name: 'WSDM 2027 short paper', kind: 'paper' },
    { d: 17, name: 'NSF TTP', kind: 'nsf' },
  ]},
  { month: 'Dec 2026', y: 2026, m: 11, items: [
    { d: 1, name: 'Simons Empire AI (noon ET)', kind: 'other' },
    { d: 2, name: 'NSF Expeditions preliminary proposal', kind: 'nsf' },
  ]},
  { month: 'Jan 2027', y: 2027, m: 0, items: [
    { d: 20, name: 'NSF CICI', kind: 'nsf' },
    { d: 31, name: 'NSF CISE Core eligible again', kind: 'nsf' },
  ]},
  { month: 'Feb 2027', y: 2027, m: 1, items: [
    { d: 3, name: 'NIH R35 MIRA for ESIs', kind: 'nih' },
    { d: 8, name: 'NSF GCR', kind: 'nsf' },
    { d: 15, name: 'NeuroArts Fleming (mid Feb)', kind: 'other', est: true },
    { d: 16, name: 'NIH R21 new (standing date)', kind: 'nih' },
    { d: 25, name: 'NIH R15 AREA new (standing date)', kind: 'nih' },
  ]},
];

const DOW = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
const SHORT_MONTH = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

// Weekday placement is computed, not transcribed, so the grid cannot drift from
// the dates in the list beneath it.
const buildWeeks = (mo) => {
  const lead = new Date(Date.UTC(mo.y, mo.m, 1)).getUTCDay();
  const length = new Date(Date.UTC(mo.y, mo.m + 1, 0)).getUTCDate();
  const byDay = new Map();
  mo.items.forEach((i) => byDay.set(i.d, [...(byDay.get(i.d) ?? []), i]));
  const cells = Array.from({ length: lead }, () => null);
  for (let d = 1; d <= length; d += 1) cells.push({ d, items: byDay.get(d) ?? [] });
  while (cells.length % 7 !== 0) cells.push(null);
  return Array.from({ length: cells.length / 7 }, (_, w) => cells.slice(w * 7, w * 7 + 7));
};

const labelFor = (mo, item) => `${SHORT_MONTH[mo.m]} ${item.d}`;
const dayName = (mo, d) => ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][new Date(Date.UTC(mo.y, mo.m, d)).getUTCDay()];

const deadlineCount = deadlines.reduce((n, m) => n + m.items.length, 0);

const kindLabels = {
  nsf: 'NSF grant',
  nih: 'NIH grant',
  other: 'Other grant',
  paper: 'Paper',
  review: 'Review / report',
};

const openCalls = [
  { heading: 'Submit anytime (no fixed deadline)', items: ['NSF BIO Core', 'NSF CMMI / IIDS (NSF 26-515)', 'NSF CMMI / EME', 'NSF TTP-E', 'NSF CISE Core — 2 per rolling 12 months; next slot opens Jan 31, 2027'] },
  { heading: 'Date not announced', items: ['ARPA-H EHI (call not yet announced)', 'NSF Future CoRe', 'CVPR 2027 demo (historically spring)', 'NeuroArts Fleming (mid Feb 2027)'] },
  { heading: 'NIH due dates (new applications)', items: ['R35 MIRA for ESIs: Feb 3, 2027 (Feb and Oct cycles)', 'R21: Feb 16 / Jun 16 / Oct 16', 'R15 AREA: Feb 25 / Jun 25 / Oct 25'] },
];
---
<Layout title="Research | Zhiqian Chen">
  <main class="container">
    <nav class="top-nav" aria-label="Sections">
      <a href="/">Home</a>
      <a href="/research" aria-current="page">Research</a>
      <a href="/grant">Grant</a>
      <a href="/people">People</a>
      <a href="/teach">Teach</a>
      <a href="https://scholar.google.com/citations?user=NC3-O6UAAAAJ&hl=en&oi=ao" target="_blank" rel="noopener">Paper <i class="ai ai-google-scholar-square ai-sm nav-ghost"></i> <i class="fas fa-arrow-up-right-from-square nav-ghost"></i></a>
      <a href="https://substack.com/@zhiqianchen1" target="_blank" rel="noopener">Zhiqian's Note <svg class="nav-ghost nav-substack" viewBox="0 0 24 24" fill="currentColor" width="11" height="11" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg> <i class="fas fa-arrow-up-right-from-square nav-ghost"></i></a>
    </nav>

    <section class="hero">
      <h1>Research Statement</h1>
      <div class="hero-grid">
      <p class="lead">COVID-19 has caused over 6 million deaths worldwide since late 2019 and an estimated $12.5 trillion in economic loss as of 2024. The pandemic exposed deep vulnerabilities in modern networked systems — disrupted supply chains, financial market volatility, misinformation amplified across social networks. The July 2024 CrowdStrike update failure brought airlines, hospitals, and businesses to a standstill worldwide, underscoring how far cascading effects travel inside interconnected systems. Climate change, pandemics, and food security all run on interdependent networks — transportation, finance, supply chains, ecology, social networks — that form the backbone of our societal and economic infrastructure. As the world grows more interconnected, resilient and interpretable network models become essential.</p>
      <blockquote class="statement">
        <strong>Research interest.</strong> I explore the fundamental principles of networked system dynamics by integrating machine learning, network science, and dynamical systems theory. The work spans theoretical innovation and practical application, and centers on efficient, interpretable models that improve decision-making in real-world contexts.
      </blockquote>
      </div>
    </section>

    <section class="section">
      <h2>Current research</h2>
      <p class="section-lead">I study graph dynamics through spectral graph theory, uncertainty quantification, higher-order analysis, and physics-inspired methods. My current focus is the behavior of coupled and interdependent networks — prevalent in practice, but still thinly developed.</p>
      <div class="scope-row">
      <figure class="scope-figure">
        <img src="/research-scope.png" alt="Two overlapping sets. Theoretical/Tool Study covers higher-order analysis, uncertainty quantification, spectral graph theory, and approximation theory. Application Study covers traffic and urban computing, spatial epidemiology, circuit and power networks, social networks, brain networks, and genetics and genomics. Graph dynamics sits in the overlap, feeding both." />
      </figure>
      <div class="prose scope-prose">
        <p><strong>Theoretical study.</strong> Developing new methodology to represent and analyze graphs and their dynamics. I have explored spectral graph theory as a unified framework for representing complex networks — several papers, a survey, tutorials at prestigious venues, and a widely used paper collection. I also investigate higher-order methods such as Shapley values and Sobol indices to understand combinatorial interactions among nodes, and use Bayesian optimization, Gaussian processes, and Kalman filtering to address efficiency in graph-based problems.</p>
        <p><strong>Application research.</strong> The work reaches key social infrastructure and biological networks: transportation and urban systems, spatial epidemiology, and genetic networks. Collaborations with ecologists, medical researchers, and engineers have extended these methods to ecological networks, circuit dynamics, and brain signals in conditions such as ADHD and sleep disorders.</p>
      </div>
      </div>
      <a class="page-link" href="/grant">
        <span class="page-link-title">Funded projects</span>
        <span class="page-link-desc">Every external and internal award — funder, role, amount, period</span>
        <i class="fas fa-arrow-right" aria-hidden="true"></i>
      </a>
    </section>

    <section class="section" id="deadlines">
      <h2>Fall 2025 Agenda</h2>
      <ul class="legend">
        {Object.entries(kindLabels).map(([k, label]) => (
          <li><span class={`dot dot-${k}`} aria-hidden="true"></span>{label}</li>
        ))}
        <li><span class="dot dot-est" aria-hidden="true"></span>Estimated date</li>
      </ul>

      <div class="cals">
        {deadlines.map((mo) => (
          <section class="cal">
            <h3>{mo.month}</h3>
            <div class="cal-dow" aria-hidden="true">
              {DOW.map((d) => <span>{d}</span>)}
            </div>
            {buildWeeks(mo).map((week) => (
              <div class="cal-week">
                {week.map((cell) => (
                  cell === null
                    ? <span class="cal-cell is-blank"></span>
                    : <span
                        class={`cal-cell${cell.items.length ? ' is-due' : ''}`}
                        data-key={cell.items.length ? `${mo.y}-${mo.m}-${cell.d}` : undefined}
                        title={cell.items.length ? `${labelFor(mo, cell)}: ${cell.items.map((i) => i.name).join('; ')}` : undefined}
                      >
                        <span class="cal-num">{cell.d}</span>
                        {cell.items.length > 0 && (
                          <span class="cal-dots">
                            {cell.items.map((i) => <span class={`dot dot-${i.kind}${i.est ? ' is-est' : ''}`}></span>)}
                          </span>
                        )}
                      </span>
                ))}
              </div>
            ))}
          </section>
        ))}
      </div>

      <div class="months">
        {deadlines.map((mo) => (
          <section class="month">
            <h3>{mo.month}</h3>
            <ul class="deadline-list">
              {mo.items.map((d) => (
                <li class={`deadline kind-${d.kind}${d.est ? ' is-est' : ''}`} data-key={`${mo.y}-${mo.m}-${d.d}`}>
                  <span class="deadline-date">{labelFor(mo, d)}<span class="deadline-day">{dayName(mo, d.d)}</span></span>
                  <span class="deadline-name">{d.name}{d.est && <span class="est-flag">est.</span>}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <div class="cards three open-calls">
        {openCalls.map((c) => (
          <article class="card">
            <h3>{c.heading}</h3>
            <ul class="topics">
              {c.items.map((i) => <li>{i}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <p class="fineprint">Verify each against its own solicitation. A date on a weekend or federal holiday shifts to the next business day; NIH resubmissions run one month later (Mar / Jul / Nov).</p>
    </section>
  </main>

  <script>
    // A calendar cell and its list rows carry the same data-key, so hovering
    // either side can light up the other without knowing anything about dates.
    const paired = document.querySelectorAll('[data-key]');
    const setLinked = (key, on) => {
      document.querySelectorAll(`[data-key="${key}"]`).forEach((el) => el.classList.toggle('is-linked', on));
    };
    paired.forEach((el) => {
      const key = el.getAttribute('data-key');
      if (!key) return;
      el.addEventListener('mouseenter', () => setLinked(key, true));
      el.addEventListener('mouseleave', () => setLinked(key, false));
    });
  </script>
</Layout>
<style>
  :root { --accent:#2563eb; --ink:#0f172a; --muted:#475569; }
  .container { max-width: min(95vw, 1600px); margin: 0 auto; padding: 20px; box-sizing: border-box; }
  .top-nav { margin-bottom: 14px; padding: 10px 0 14px; display:flex; flex-wrap:wrap; gap:8px; align-items:center; background:transparent; border:none; border-bottom:none; border-radius:0; box-shadow:none; }
  .top-nav a { text-decoration:none; color:var(--ink); font-family:'Montserrat',sans-serif; font-size:.9rem; padding:7px 10px; border-radius:999px; background:transparent; }
  .top-nav a:hover { background: #f1f5f9; color: #0f172a; }
  .top-nav a[aria-current="page"] { background: #e2e8f0; color: #0f172a; box-shadow: inset 0 1px 2px rgba(15,23,42,0.10); }
  .nav-ghost { font-size:.78rem; margin-left:4px; opacity:.85; }
  .nav-substack { vertical-align: -1px; opacity: .85; }

  .hero { margin: 10px 0 28px; }
  .hero h1 { font-family:'Montserrat',sans-serif; font-size:2rem; margin:0 0 10px; }
  /* The page runs to 1600px, so a single measure would leave the right half
     empty; pair the motivation with the statement instead of stacking them. */
  .hero-grid { display:grid; grid-template-columns:1.55fr 1fr; gap:24px; align-items:start; }
  .lead { margin:0; color:var(--muted); font-size:.95rem; line-height:1.6; }
  .statement { margin:0; padding:14px 16px; border-left:3px solid var(--accent); border-radius:0 12px 12px 0; background:#f8fafc; color:#1e293b; font-size:1rem; line-height:1.6; }
  .statement strong { color:var(--ink); }

  .section { padding-top:18px; margin-top:26px; border-top:1px solid rgba(148,163,184,.18); }
  .section h2 { font-family:'Montserrat',sans-serif; font-size:1.1rem; margin:0 0 12px; }
  .section-lead { margin:0 0 14px; color:var(--muted); font-size:.92rem; line-height:1.55; }
  .prose { margin-top:14px; }
  .prose p, .prose-p { margin:0 0 10px; color:#334155; font-size:.93rem; line-height:1.6; }
  .prose p:last-child { margin-bottom:0; }
  /* Theory and application read as a pair, and two columns keep the measure
     readable at full width instead of running to ~180 characters. */
  .prose.scope-prose { margin:0; }
  .prose.scope-prose p { margin:0; }

  .cards { display:grid; gap:14px; }
  .cards.three { grid-template-columns: repeat(3, minmax(0,1fr)); }
  .card { position:relative; border:1px solid rgba(148,163,184,.16); border-radius:16px; background:#fff; padding:16px; }
  .card h3 { font-family:'Montserrat',sans-serif; font-size:.95rem; margin:0 0 8px; }
  .card p { margin:0; color:#334155; font-size:.9rem; line-height:1.55; }
  .topics { list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:6px; }
  .topics li { font-size:.78rem; color:#334155; background:#f1f5f9; border:1px solid rgba(148,163,184,.2); border-radius:999px; padding:3px 9px; }

  /* The figure ships from the statement itself, rendered at 300dpi so it stays
     sharp across the full container width. */
  .scope-row { display:grid; grid-template-columns:1.4fr 1fr; gap:24px; align-items:start; margin-bottom:4px; }
  .scope-figure { margin:0; }
  .scope-figure img { display:block; width:100%; height:auto; }
  .scope-prose p + p { margin-top:12px; }

  .page-link { display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; margin-top:16px; padding:12px 14px; border:1px solid rgba(148,163,184,.22); border-radius:14px; background:#f8fafc; text-decoration:none; transition:border-color .15s ease, background .15s ease; }
  .page-link:hover { border-color:rgba(37,99,235,.4); background:#f1f5f9; }
  .page-link-title { font-family:'Montserrat',sans-serif; font-weight:700; font-size:.88rem; color:var(--accent); }
  .page-link-desc { font-size:.84rem; color:#475569; }
  .page-link i { margin-left:auto; font-size:.78rem; color:var(--accent); }

  .legend { list-style:none; margin:0 0 14px; padding:0; display:flex; flex-wrap:wrap; gap:12px; font-size:.76rem; color:#475569; }
  .legend li { display:inline-flex; align-items:center; gap:5px; }
  .dot { width:9px; height:9px; border-radius:50%; display:inline-block; }
  .dot-nsf { background:#2563eb; }
  .dot-nih { background:#0f766e; }
  .dot-other { background:#9d174d; }
  .dot-paper { background:#b45309; }
  .dot-review { background:#6d28d9; }
  .dot-est { background:transparent; border:1px dashed #94a3b8; }

  /* Six month grids, the way the source sheet lays them out. */
  .cals { display:grid; grid-template-columns:repeat(6, minmax(0,1fr)); gap:12px; margin-bottom:22px; }
  .cal h3 { font-family:'Montserrat',sans-serif; font-size:.72rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:#334155; margin:0 0 6px; text-align:center; }
  .cal-dow, .cal-week { display:grid; grid-template-columns:repeat(7, 1fr); gap:1px; }
  .cal-dow span { text-align:center; font-size:.6rem; font-weight:700; color:#94a3b8; padding-bottom:2px; }
  .cal-cell { position:relative; aspect-ratio:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1px; border-radius:4px; }
  .cal-cell.is-blank { visibility:hidden; }
  .cal-num { font-size:.62rem; color:#64748b; font-variant-numeric:tabular-nums; line-height:1; }
  .cal-cell.is-due { background:#f1f5f9; }
  .cal-cell.is-due .cal-num { font-weight:700; color:#0f172a; }
  .cal-dots { display:flex; gap:1px; }
  .cal-dots .dot { width:4px; height:4px; }

  /* The list repeats the same items in words, one tier smaller than the grids.
     Multicol rather than a grid: a four-item September would otherwise pad its
     cell down to November's height before October could start. */
  .months { columns:4; column-gap:16px; }
  /* Months must be splittable, or a short September holds a whole column and
     October cannot start under it. Rows stay whole; a heading keeps its first row. */
  .month { break-inside:auto; margin-bottom:12px; }
  .month h3 { break-after:avoid; }
  .deadline { break-inside:avoid; }
  .month h3 { font-family:'Montserrat',sans-serif; font-size:.72rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#64748b; margin:0 0 6px; padding-bottom:3px; border-bottom:1px solid rgba(148,163,184,.2); }
  .deadline-list { list-style:none; margin:0; padding:0; display:grid; gap:3px; }
  .deadline { display:grid; grid-template-columns:52px minmax(0,1fr); gap:7px; align-items:baseline; padding:3px 7px; border-radius:6px; border-left:2px solid transparent; background:#f8fafc; }
  .deadline-date { font-size:.68rem; font-weight:700; color:#0f172a; font-variant-numeric:tabular-nums; }
  .deadline-day { display:block; font-size:.6rem; font-weight:400; color:#94a3b8; }
  .deadline-name { font-size:.74rem; color:#334155; line-height:1.3; }
  .kind-nsf { border-left-color:#2563eb; }
  .kind-nih { border-left-color:#0f766e; }
  .kind-other { border-left-color:#9d174d; }
  .kind-paper { border-left-color:#b45309; }
  .kind-review { border-left-color:#6d28d9; }
  .is-est { border-left-style:dashed; }
  .est-flag { margin-left:5px; font-size:.66rem; color:#94a3b8; border:1px dashed #cbd5e1; border-radius:4px; padding:0 4px; }

  /* Hovering either side lights up its counterpart on the other. */
  .cal-cell.is-linked { background:#dbeafe; box-shadow:inset 0 0 0 1px rgba(37,99,235,.55); }
  .cal-cell.is-linked .cal-num { color:#1d4ed8; }
  .deadline.is-linked { background:#dbeafe; }
  .deadline.is-linked .deadline-name, .deadline.is-linked .deadline-date { color:#1d4ed8; }
  .cal-cell.is-due, .deadline { cursor:default; }

  .fineprint { margin:14px 0 0; font-size:.72rem; color:#94a3b8; line-height:1.5; }
  .open-calls { margin-top:16px; }
  .open-calls .topics { flex-direction:column; gap:5px; align-items:flex-start; }
  .open-calls .topics li { background:transparent; border:none; padding:0; font-size:.82rem; color:#475569; line-height:1.45; }

  @media (max-width: 1350px) {
    .cals { grid-template-columns:repeat(3, minmax(0,1fr)); }
  }
  @media (max-width: 1100px) {
    .cards.three { grid-template-columns:repeat(2, minmax(0,1fr)); }
    .months { columns:2; }
  }
  @media (max-width: 900px) {
    .hero-grid, .scope-row { grid-template-columns:1fr; }
    .statement { border-radius:0 12px 12px 0; }
  }
  @media (max-width: 620px) {
    .months { columns:1; }
  }
  @media (max-width: 620px) {
    .cals { grid-template-columns:repeat(2, minmax(0,1fr)); }
  }
  @media (max-width: 720px) {
    .cards.three { grid-template-columns:1fr; }
    .page-link i { margin-left:0; }
  }
</style>
