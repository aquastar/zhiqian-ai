---
import Layout from '../layouts/Layout.astro';
import { ranked, others, notable } from '../data/conferences.js';

const AREAS = ['AI / ML / Data Mining', 'Security & Privacy', 'Biomedical & Health', 'Science & Interdisciplinary'];
const AREA_SHORT = {
  'AI / ML / Data Mining': 'AI · ML · Data Mining',
  'Security & Privacy': 'Security & Privacy',
  'Biomedical & Health': 'Biomedical & Health',
  'Science & Interdisciplinary': 'Science & Interdisciplinary',
};
const slug = (a) => a.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');
// Each field gets one icon and one hue, used identically in the filter and in
// every row, so the two can be matched at a glance instead of by reading.
const AREA_ICON = {
  'AI / ML / Data Mining': 'fa-brain',
  'Security & Privacy': 'fa-shield-halved',
  'Biomedical & Health': 'fa-dna',
  'Science & Interdisciplinary': 'fa-flask',
};
const DEFAULT_AREA = 'AI / ML / Data Mining';
const AR_REPO = 'https://github.com/lixin4ever/Conference-Acceptance-Rate';
// Fixed 0-45% scale: the point of the bars is to compare venues to each other,
// which a per-row scale would destroy.
const RATE_MAX = 40;
const TIER = { 1: 'Top', 2: 'Strong', 3: 'Listed' };

const coreLabel = { 'A*': 'A*', A: 'A', B: 'B', C: 'C', TBR: 'TBR', JP: 'jrnl', N: '—' };
const coreClass = (c) => `core-${c === 'A*' ? 'as' : c.toLowerCase()}`;

// Acceptance rates are only as fresh as the upstream table; anything before
// this is shown with the year called out rather than quietly passed off as current.
const FRESH_FROM = 2024;

// One list, date order. Venues with no announced date sit at the end rather
// than pretending to a position in the calendar.
const society = notable.map((c) => ({ ...c, society: true, tier: 3 }));
const all = [...ranked, ...society];
const dated = all.filter((c) => c.nextDeadline).sort((a, b) => a.nextDeadline.localeCompare(b.nextDeadline));
const undated = all.filter((c) => !c.nextDeadline).sort((a, b) => a.title.localeCompare(b.title));
const rows = [...dated, ...undated];

const counts = AREAS.map((a) => ({ area: a, n: rows.filter((c) => c.area === a).length })).filter((x) => x.n);
const totalRated = rows.filter((c) => c.rates.length).length;
const freshRated = rows.filter((c) => c.rates.length && c.rates[c.rates.length - 1].y >= FRESH_FROM).length;

---
<Layout title="Conferences | Zhiqian Chen">
  <main class="container">
    <nav class="top-nav" aria-label="Sections">
      <a href="/">Home</a>
      <a href="/research">Research</a>
      <a href="/agenda" aria-current="page">Agenda</a>
      <a href="/people">People</a>
      <a href="/teach">Talk &amp; Teach</a>
      <a href="https://scholar.google.com/citations?user=NC3-O6UAAAAJ&hl=en&oi=ao" target="_blank" rel="noopener">Paper <i class="ai ai-google-scholar-square ai-sm nav-ghost"></i> <i class="fas fa-arrow-up-right-from-square nav-ghost"></i></a>
      <a href="https://substack.com/@zhiqianchen1" target="_blank" rel="noopener">Zhiqian's Note <svg class="nav-ghost nav-substack" viewBox="0 0 24 24" fill="currentColor" width="11" height="11" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg> <i class="fas fa-arrow-up-right-from-square nav-ghost"></i></a>
    </nav>

    <section class="head">
      <div class="head-row">
        <div class="head-text">
          <h1>Conferences</h1>
          <p class="sub">
            One list, soonest deadline first. A venue is listed when it clears CORE A*&ndash;A or CCF A&ndash;B,
            either one &mdash; plus unranked venues that matter anyway. The tag on each row is importance; the
            ranks that justify it are in the last column.
          </p>
        </div>
        <div class="filter" role="group" aria-label="Filter by field">
          <span class="filter-label">Field</span>
          <button class="fbtn" data-area="all" type="button"><i class="fas fa-layer-group" aria-hidden="true"></i>All<span class="fcount">{rows.length}</span></button>
          {counts.map((c) => (
            <button class={`fbtn area-${slug(c.area)}${c.area === DEFAULT_AREA ? ' is-on' : ''}`} data-area={slug(c.area)} type="button">
              <i class={`fas ${AREA_ICON[c.area]}`} aria-hidden="true"></i>{AREA_SHORT[c.area]}<span class="fcount">{c.n}</span>
            </button>
          ))}
        </div>
      </div>

      <ul class="legend">
        <li><span class="tier-tag tt-1">Top</span> CCF A or CORE A*</li>
        <li><span class="tier-tag tt-2">Strong</span> CCF B or CORE A</li>
        <li><span class="tier-tag tt-3">Listed</span> unranked, importance stated</li>
        <li class="legend-gap"><span class="chip band-urgent"></span>&lt;30d</li>
        <li><span class="chip band-soon"></span>30&ndash;60</li>
        <li><span class="chip band-later"></span>60&ndash;90</li>
        <li><span class="chip band-far"></span>90+</li>
        <li><span class="rounds-tag">2&times;</span>cycles / year</li>
      </ul>
    </section>

    <section class="section">
      <div class="table-wrap">
        <table class="confs">
          <thead>
            <tr>
              <th class="c-name">Conference</th>
              <th class="c-date">Next deadline</th>
              <th class="c-when">Edition</th>
              <th class="c-rate">Acceptance</th>
              <th class="c-rank">Ranking</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((c) => {
              const last = c.rates.length ? c.rates[c.rates.length - 1] : null;
              const stale = last && last.y < FRESH_FROM;
              return (
              <tr class={`tier-${c.tier}`} data-area={slug(c.area)}>
                <td class="c-name">
                  <span class={`tier-tag tt-${c.tier}`}>{TIER[c.tier]}</span>
                  <span class="name-line">
                    {c.link
                      ? <a class="conf-name" href={c.link} target="_blank" rel="noopener">{c.title}</a>
                      : <span class="conf-name">{c.title}</span>}
                    {c.cycles > 1 && <span class="rounds-tag" title={c.roundLabels.join(' · ')}>{c.cycles}&times;</span>}
                    {c.notable && !c.society && <span class="new-tag">emerging</span>}
                    {c.society && <span class="proc proc-none">no proceedings</span>}
                  </span>
                  <span class="conf-desc">{c.desc}</span>
                  <span class={`area-tag area-${slug(c.area)}`}><i class={`fas ${AREA_ICON[c.area]}`} aria-hidden="true"></i>{AREA_SHORT[c.area]}</span>
                  {c.note && <p class="why">{c.note}</p>}
                </td>
                <td class="c-date">
                  {c.nextDeadline
                    ? <>
                        <span class="dl">{c.nextDeadline}</span>
                        <span class="dl-days" data-deadline={c.nextDeadline}></span>
                      </>
                    : <span class="none">not announced</span>}
                </td>
                <td class="c-when">
                  {c.nextYear ? <span class="ed">{c.nextYear}</span> : null}
                  {c.date ? <span class="when">{c.date}</span> : <span class="none">&mdash;</span>}
                  {c.place && <span class="where">{c.place}</span>}
                </td>
                <td class="c-rate">
                  {last
                    ? <div class={`rate ${stale ? 'is-stale' : ''}`}>
                        <div class="bars">
                          {c.rates.slice(-3).map((p) => (
                            <div class="bar-col" title={`${p.y}: ${p.r}%`}>
                              <span class="bar-pct">{p.r}%</span>
                              <span class="bar-track"><span class="bar-fill" style={`height:${Math.min(p.r / RATE_MAX, 1) * 100}%`}></span></span>
                              <span class="bar-year">'{String(p.y).slice(2)}</span>
                            </div>
                          ))}
                        </div>
                        {c.rates.length > 3 && (
                          <a class="rate-more" href={`${AR_REPO}#${c.rateSection}`} target="_blank" rel="noopener">
                            {c.rates.length} yrs <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                          </a>
                        )}
                        {stale && <span class="rate-stale-note">ends {last.y}</span>}
                      </div>
                    : <span class="none">no published rate</span>}
                </td>
                <td class="c-rank">
                  {c.society
                    ? <span class="eqv eqv-none">not rankable &mdash; no archival proceedings</span>
                    : c.notable
                    ? <span class="eqv">unranked &mdash; treated as {c.equivalent}</span>
                    : <span class="ranks">
                        <span class={`pill ccf-${c.ccf.toLowerCase()}`} title="CCF catalogue">CCF {c.ccf === 'N' ? '—' : c.ccf}</span>
                        <span class={`pill ${coreClass(c.core)}`} title={c.coreVerified ? 'Confirmed against the official CORE2023 export' : 'Not found in the official CORE2023 export'}>CORE {coreLabel[c.core]}</span>
                      </span>}
                </td>
              </tr>
            );})}
          </tbody>
        </table>
      </div>
      <p class="empty-note" hidden>No conference in this field.</p>
      <p class="area-note">
        Acceptance rates: {totalRated} of {rows.length} venues publish one, and {freshRated} of those are {FRESH_FROM} or later.
        The rest are labelled with the year they stop &mdash; the upstream compilation simply stopped updating them.
        Main track only; Findings and workshops are excluded.
      </p>
    </section>

    <section class="section">
      <details class="rest">
        <summary>
          <h2>Below the bar</h2>
          <span class="rest-count">{others.length}</span>
          <span class="rest-note">CORE B or lower and CCF C or lower</span>
        </summary>
        <ul class="rest-list">
          {others.map((c) => (
            <li>
              <a href={c.link} target="_blank" rel="noopener">{c.title}</a>
              <span class={`pill ccf-${c.ccf.toLowerCase()}`}>CCF {c.ccf === 'N' ? '—' : c.ccf}</span>
              <span class={`pill ${coreClass(c.core)}`}>CORE {coreLabel[c.core]}</span>
              <span class="rest-desc">{c.desc}</span>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <p class="src-note">
      CCF ranks mirror the CCF catalogue through <a href="https://github.com/ccfddl/ccf-deadlines" target="_blank" rel="noopener">ccfddl/ccf-deadlines</a>;
      CORE ranks are cross-checked against the official CORE2023 export from
      <a href="https://portal.core.edu.au/conf-ranks/" target="_blank" rel="noopener">portal.core.edu.au</a>;
      acceptance rates from <a href="https://github.com/lixin4ever/Conference-Acceptance-Rate" target="_blank" rel="noopener">lixin4ever/Conference-Acceptance-Rate</a>.
      Rebuilt weekly. Dates marked “not announced” are genuinely unpublished &mdash; nothing here is estimated.
    </p>
  </main>
</Layout>

<style>
.container { max-width: min(95vw, 1600px); margin: 0 auto; padding: 20px; box-sizing: border-box; }
  .top-nav { margin-bottom: 14px; padding: 10px 0 14px; display:flex; flex-wrap:wrap; gap:8px; align-items:center; background:transparent; border:none; border-bottom:none; border-radius:0; box-shadow:none; }
  .top-nav a { text-decoration:none; color:var(--ink); font-family:'Montserrat',sans-serif; font-size:.9rem; padding:7px 10px; border-radius:999px; background:transparent; }
  .top-nav a:hover { background: #f1f5f9; color: #0f172a; }
  .top-nav a[aria-current="page"] { background: #e2e8f0; color: #0f172a; box-shadow: inset 0 1px 2px rgba(15,23,42,0.10); }
  .head { margin-bottom: 18px; }
  .head-row { display:flex; align-items:flex-start; justify-content:space-between; gap:28px; flex-wrap:wrap; }
  .head-text { flex:1 1 440px; min-width:0; }
  h1 { font-size: 1.9rem; margin: 0 0 6px; letter-spacing: -.02em; }
  .sub { margin: 0; color: #475569; font-size: .92rem; line-height: 1.6; max-width: 62ch; }

  /* Field filter, top-right. */
  .filter { flex:0 0 auto; display:flex; flex-wrap:wrap; gap:6px; align-items:center; justify-content:flex-end; max-width:420px; }
  .filter-label { width:100%; text-align:right; font-size:.7rem; letter-spacing:.09em; text-transform:uppercase; color:#94a3b8; margin-bottom:2px; }
  .fbtn { display:inline-flex; align-items:center; gap:6px; padding:5px 11px; border-radius:999px; cursor:pointer;
    border:1px solid rgba(148,163,184,.4); background:#fff; color:#475569; font:inherit; font-size:.76rem; font-weight:600;
    transition:background .15s ease, border-color .15s ease, color .15s ease; }
  .fbtn:hover { border-color:rgba(37,99,235,.45); color:var(--accent); }
  .fbtn.is-on { background:#1e293b; border-color:#1e293b; color:#fff; }
  .fcount { font-size:.68rem; font-weight:700; opacity:.6; }
  .fbtn.is-on .fcount { opacity:.75; }

  .legend { list-style:none; margin:14px 0 0; padding:0; display:flex; flex-wrap:wrap; gap:14px; font-size:.76rem; color:#475569; }
  .legend li { display:inline-flex; align-items:center; gap:6px; }
  .legend .tier-tag { margin-bottom:0; }
  .legend strong { font-weight:700; color:#1e293b; }
  .legend-gap { margin-left:10px; }
    .chip { width:11px; height:11px; border-radius:3px; display:inline-block; }
  .chip.band-urgent { background:#dc2626; } .chip.band-soon { background:#fde68a; }
  .chip.band-later { background:#2563eb; } .chip.band-far { background:#64748b; }

  .section { margin-top: 26px; }
  .area-head { font-size:1.02rem; margin:0 0 6px; display:flex; align-items:center; gap:9px; }
  .area-count { font-size:.72rem; font-weight:700; color:#64748b; background:#f1f5f9; border-radius:999px; padding:2px 8px; }
  .area-note { margin:8px 0 0; font-size:.8rem; color:#64748b; line-height:1.6; max-width:78ch; }

  .table-wrap { overflow-x:auto; border:1px solid rgba(148,163,184,.26); border-radius:12px; }
  table.confs { width:100%; border-collapse:collapse; font-size:.84rem; }
  .confs thead th { position:sticky; top:0; z-index:2; background:#f8fafc; text-align:left; font-size:.68rem;
    letter-spacing:.08em; text-transform:uppercase; color:#64748b; font-weight:700;
    padding:9px 12px; border-bottom:1px solid rgba(148,163,184,.3); white-space:nowrap; }
  .confs td { padding:10px 12px; border-bottom:1px solid rgba(148,163,184,.17); vertical-align:top; }
  .confs tbody tr:last-child td { border-bottom:0; }

  .confs tbody tr:hover { background:#f8fafc; }
  /* Importance reads as a label at the head of the row. A wash behind the
     whole row said the same thing but fought with everything written on it. */
  .tier-tag { display:inline-block; margin-bottom:5px; padding:2px 9px; border-radius:4px;
    font-size:.62rem; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:#fff; }
  .tt-1 { background:#dc2626; }
  .tt-2 { background:#ea7317; }
  .tt-3 { background:#8a6d0b; }

  .c-name { min-width:230px; }
  .name-line { display:flex; align-items:center; gap:7px; flex-wrap:wrap; }
  .conf-name { font-weight:700; color:#0f172a; text-decoration:none; font-size:.9rem; }
  a.conf-name:hover { color:var(--accent); text-decoration:underline; }
  .conf-desc { display:block; text-align:left; color:#64748b; font-size:.74rem; line-height:1.45; margin-top:2px; max-width:42ch; }
  .area-tag { display:inline-flex; align-items:center; gap:5px; margin-top:5px; font-size:.65rem; letter-spacing:.05em;
    text-transform:uppercase; font-weight:700; border-radius:4px; padding:2px 7px; border:1px solid currentColor; }
  .area-tag i { font-size:.72rem; }
  /* One hue per field, shared by the tag and the filter button. */
  .area-ai-ml-data-mining        { color:#6d28d9; background:#f3f0ff; }
  .area-security-privacy         { color:#0f766e; background:#effcfa; }
  .area-biomedical-health        { color:#be185d; background:#fdf2f8; }
  .area-science-interdisciplinary{ color:#1d4ed8; background:#eff6ff; }
  .fbtn i { font-size:.8rem; }
  .fbtn.area-ai-ml-data-mining:not(.is-on)         { color:#6d28d9; border-color:#ddd6fe; }
  .fbtn.area-security-privacy:not(.is-on)          { color:#0f766e; border-color:#99f6e4; }
  .fbtn.area-biomedical-health:not(.is-on)         { color:#be185d; border-color:#fbcfe8; }
  .fbtn.area-science-interdisciplinary:not(.is-on) { color:#1d4ed8; border-color:#bfdbfe; }
  .rounds-tag { font-size:.64rem; font-weight:800; color:#0369a1; background:#e0f2fe; border-radius:4px; padding:1px 5px; }
  .new-tag { font-size:.62rem; font-weight:800; letter-spacing:.05em; text-transform:uppercase;
    color:#5b21b6; background:#ede9fe; border:1px solid #ddd6fe; border-radius:4px; padding:1px 6px; }

  .c-date { white-space:nowrap; }
  .dl { display:block; font-variant-numeric:tabular-nums; font-weight:600; color:#1e293b; }
  .dl-days { display:inline-block; margin-top:4px; font-size:.68rem; font-weight:800; color:#fff;
    border-radius:999px; padding:2px 8px; background:#64748b; }
  .dl-days.band-urgent { background:#dc2626; }
  .dl-days.band-soon   { background:#fde68a; color:#92400e; }
  .dl-days.band-later  { background:#2563eb; }
  .dl-days.band-far    { background:#64748b; }
  .dl-days.band-past   { background:#e2e8f0; color:#64748b; }

  .c-when { font-size:.75rem; color:#475569; min-width:140px; }
  .ed { display:block; font-weight:700; color:#1e293b; font-size:.8rem; }
  .when { display:block; }
  .where { display:block; color:#94a3b8; }

  .c-rate { min-width:150px; }
  .rate { display:flex; align-items:flex-end; gap:10px; }
  .bars { display:flex; align-items:flex-end; gap:6px; }
  .bar-col { display:flex; flex-direction:column; align-items:center; gap:2px; width:34px; }
  .bar-pct { font-size:.64rem; font-weight:800; color:#0f172a; font-variant-numeric:tabular-nums; }
  .bar-track { position:relative; width:100%; height:44px; display:flex; align-items:flex-end;
    background:rgba(148,163,184,.2); border-radius:3px; overflow:hidden; }
  /* Reference line at 25% — most CS rates sit near it, so it turns a cluster
     of similar bars into an above/below read. */
  .bar-track::before { content:''; position:absolute; left:0; right:0; bottom:62.5%; height:1px;
    background:rgba(71,85,105,.33); z-index:1; }
  .bar-fill { position:relative; z-index:0; width:100%; background:linear-gradient(180deg,#60a5fa,#2563eb); border-radius:3px 3px 0 0; }
  .bar-year { font-size:.62rem; color:#64748b; font-variant-numeric:tabular-nums; }
  .rate.is-stale .bar-fill { background:linear-gradient(180deg,#cbd5e1,#94a3b8); }
  .rate.is-stale .bar-pct { color:#64748b; }
  .rate-more { font-size:.63rem; font-weight:700; color:#475569; text-decoration:none; white-space:nowrap;
    border:1px solid rgba(148,163,184,.45); border-radius:999px; padding:2px 7px; background:#fff; margin-bottom:18px; }
  .rate-more:hover { color:var(--accent); border-color:rgba(37,99,235,.5); }
  .rate-stale-note { font-size:.62rem; font-weight:700; color:#b45309; background:#fef3c7;
    border-radius:4px; padding:1px 5px; margin-bottom:19px; white-space:nowrap; }

  .c-rank { white-space:nowrap; }
  .ranks { display:flex; flex-direction:column; gap:4px; align-items:flex-start; }
  .pill { display:inline-block; min-width:60px; text-align:center; padding:2px 8px; border-radius:5px;
    font-size:.68rem; font-weight:800; color:#fff; letter-spacing:.02em; }
  /* CCF: red / orange / yellow. CORE: red / orange / yellow / green. Same hues,
     so a reader compares the two tables without relearning a palette. */
  .ccf-a { background:#dc2626; } .ccf-b { background:#c2410c; } .ccf-c { background:#a16207; }
  .ccf-n { background:#e2e8f0; color:#64748b; }
  .core-as { background:#dc2626; } .core-a { background:#c2410c; } .core-b { background:#a16207; }
  .core-c { background:#4d7c0f; }
  .core-tbr, .core-jp, .core-n { background:#e2e8f0; color:#64748b; }
  .eqv-none { color:#92400e; background:#fffbeb; border-color:#fde68a; }
  .why { margin:6px 0 0; text-align:left; font-size:.72rem; line-height:1.5; color:#64748b; max-width:44ch;
    border-left:2px solid rgba(148,163,184,.4); padding-left:8px; }
  .eqv { display:inline-block; max-width:180px; white-space:normal; font-size:.7rem; line-height:1.4;
    color:#5b21b6; background:#f5f3ff; border:1px solid #ddd6fe; border-radius:6px; padding:4px 8px; font-weight:600; }

  .none { color:#b6c0cc; font-size:.75rem; }
  .empty-note { margin:16px 0 0; font-size:.84rem; color:#64748b; }

  .proc { font-size:.62rem; font-weight:800; letter-spacing:.04em; text-transform:uppercase; border-radius:4px; padding:2px 6px; }
  .proc-none { color:#92400e; background:#fef3c7; }

  .rest { border:1px solid rgba(148,163,184,.26); border-radius:12px; background:#fbfcfe; }
  .rest > summary { cursor:pointer; list-style:none; display:flex; align-items:center; gap:10px; padding:12px 16px; }
  .rest > summary::-webkit-details-marker { display:none; }
  .rest > summary h2 { font-size:.98rem; margin:0; }
  .rest-count { font-size:.72rem; font-weight:700; color:#64748b; background:#f1f5f9; border-radius:999px; padding:2px 8px; }
  .rest-note { font-size:.74rem; color:#94a3b8; margin-left:auto; }
  .rest-list { list-style:none; margin:0; padding:0 16px 14px; display:grid;
    grid-template-columns:repeat(auto-fill, minmax(300px,1fr)); gap:7px 18px; }
  .rest-list li { display:grid; grid-template-columns:auto auto auto 1fr; gap:7px; align-items:center; font-size:.78rem; }
  .rest-list a { font-weight:700; color:#334155; text-decoration:none; }
  .rest-list a:hover { color:var(--accent); }
  .rest-desc { color:#94a3b8; font-size:.71rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

  .src-note { margin-top:22px; font-size:.73rem; color:#94a3b8; line-height:1.7; }
  .src-note a { color:#64748b; }

  @media (max-width: 760px) {
    .head-row { flex-direction:column; }
    .filter { justify-content:flex-start; max-width:none; }
    .filter-label { text-align:left; }
    .c-when, .c-rate { display:none; }
  }
</style>

<script>
  const DAY = 86400000;
  const today = new Date(); today.setHours(0, 0, 0, 0);

  document.querySelectorAll('.dl-days').forEach((el) => {
    const raw = el.getAttribute('data-deadline');
    if (!raw) return;
    const [y, m, d] = raw.split('-').map(Number);
    const days = Math.round((new Date(y, m - 1, d).getTime() - today.getTime()) / DAY);
    const band = days < 0 ? 'past' : days < 30 ? 'urgent' : days < 60 ? 'soon' : days < 90 ? 'later' : 'far';
    el.classList.add('band-' + band);
    el.textContent = days < 0 ? `closed ${-days}d ago` : days === 0 ? 'today' : `${days}d`;
  });

  // Field filter. Rows carry their own area, so this is pure show/hide — the
  // date order never changes underneath the reader.
  const rows = Array.from(document.querySelectorAll('table.confs tbody tr'));
  const empty = document.querySelector('.empty-note');
  const apply = (btn) => {
    const want = btn.dataset.area;
    document.querySelectorAll('.fbtn').forEach((b) => b.classList.toggle('is-on', b === btn));
    let shown = 0;
    rows.forEach((r) => {
      const on = want === 'all' || r.dataset.area === want;
      r.style.display = on ? '' : 'none';
      if (on) shown++;
    });
    if (empty) empty.hidden = shown > 0;
  };
  document.querySelectorAll('.fbtn').forEach((btn) => btn.addEventListener('click', () => apply(btn)));
  // The markup marks AI as selected; run the filter so the rows agree with it.
  const start = document.querySelector('.fbtn.is-on');
  if (start) apply(start);
</script>
