  table.jrnl-table { min-width:980px; }
  .j-name { width:24%; } .j-why { width:22%; text-align:left; color:#475569; font-size:.8rem; }
  .j-subs { width:26%; } .j-cite, .j-h { width:9%; text-align:center; }
  .j-pub { color:#a3adbb; }
  .j-num { font-size:1.05rem; font-weight:800; color:#0f172a; font-variant-numeric:tabular-nums; }
  .j-num-soft { font-weight:600; color:#475569; font-size:.92rem; }
  .jrnl-table .spark { max-width:240px; }
  .area-head { font-size:1.02rem; margin:0 0 6px; display:flex; align-items:center; gap:9px; }
  .area-count { font-size:.72rem; font-weight:700; color:#64748b; background:#f1f5f9; border-radius:999px; padding:2px 8px; }
  .area-note { margin:6px 0 0; font-size:.8rem; color:#64748b; line-height:1.6; max-width:78ch; }

  .table-wrap { overflow-x:auto; border:1px solid rgba(148,163,184,.26); border-radius:12px; }
  table.confs { width:100%; min-width:1180px; table-layout:fixed; border-collapse:collapse; font-size:.84rem; }
  .confs thead th { position:sticky; top:0; z-index:2; background:#f8fafc; text-align:left; font-size:.64rem;
    letter-spacing:.08em; text-transform:uppercase; color:#64748b; font-weight:700;
    padding:6px 6px; border-bottom:1px solid rgba(148,163,184,.3); white-space:nowrap; }
  .confs td { padding:6px 6px; border-bottom:1px solid rgba(148,163,184,.17); vertical-align:top; }
  .confs tbody tr:last-child td { border-bottom:0; }

  .confs tbody tr:hover { background:#f8fafc; }
  /* Importance reads as a label at the head of the row. A wash behind the
     whole row said the same thing but fought with everything written on it. */

  /* Percentages, not pixels: a long conference name used to push this column
     wide at every viewport. Capped under half the table it can no longer do
     that, and the other three keep their share whatever the window does. */
  .c-name { width:24%; }
  .name-line { display:flex; align-items:baseline; gap:7px; flex-wrap:wrap; }
  .conf-name { overflow-wrap:anywhere; font-weight:700; color:#0f172a; text-decoration:none; font-size:.9rem; }
  a.conf-name:hover { color:var(--accent); text-decoration:underline; }
  .conf-desc { display:block; text-align:left; color:#8a95a5; font-size:.72rem;
    line-height:1.4; margin-top:2px; }
  .area-tag { display:inline-flex; margin-right:4px; align-items:center; gap:5px; margin-top:5px; font-size:.65rem; letter-spacing:.05em;
    text-transform:uppercase; font-weight:700; border-radius:4px; padding:2px 7px; border:1px solid currentColor; }
  .area-tag i { font-size:.72rem; }
  /* One hue per field, shared by the tag and the filter button. */
  .area-ai-ml-data-mining        { color:#6d28d9; background:#f3f0ff; }
  .area-security                 { color:#b91c1c; background:#fef2f2; }
  .area-health-bio               { color:#0f766e; background:#effcfa; }
  .area-control                  { color:#b45309; background:#fffbeb; }
  .area-society-meetings         { color:#475569; background:#f1f5f9; }
  .fbtn i { font-size:.8rem; }
  .fbtn.area-ai-ml-data-mining:not(.is-on)         { color:#6d28d9; border-color:#ddd6fe; }
  .fbtn.area-security:not(.is-on)                  { color:#b91c1c; border-color:#fecaca; }
  .fbtn.area-health-bio:not(.is-on)                { color:#0f766e; border-color:#99f6e4; }
  .fbtn.area-control:not(.is-on)                   { color:#b45309; border-color:#fde68a; }
  .fbtn.area-society-meetings:not(.is-on)          { color:#475569; border-color:#cbd5e1; }
  .fbtn-dest { margin-left:auto; }
  .fbtn-dest:not(.is-on) { color:#0e7490; border-color:#a5f3fc; }
  .fbtn-dest.is-on { background:#0e7490; border-color:#0e7490; }
  .dest-section[hidden], .section[hidden] { display:none; }
  .legend[hidden] { display:none; }

  /* Society meetings, as cards. A table made them look like venues that had
     simply failed to report a rank. */
  .society-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(330px, 1fr)); gap:12px; }
  .soc-card { display:flex; flex-direction:column; padding:14px 16px; border-radius:13px;
    border:1px solid rgba(148,163,184,.32); background:#fff; }
  .soc-head { display:flex; align-items:baseline; justify-content:space-between; gap:10px; flex-wrap:wrap; }
  .soc-head h3 { margin:0; font-size:1rem; letter-spacing:-.01em; }
  .soc-head a { color:#0f172a; text-decoration:none; }
  .soc-head a:hover { color:var(--accent); text-decoration:underline; }
  .soc-desc { margin:2px 0 0; font-size:.78rem; color:#64748b; line-height:1.4; }
  .soc-note { margin:9px 0 0; font-size:.8rem; color:#334155; line-height:1.6; text-align:left; }
  .soc-facts { display:flex; flex-wrap:wrap; gap:4px 18px; margin:12px 0 0; padding:11px 0 0;
    border-top:1px dotted rgba(148,163,184,.45); }
  .soc-facts div { min-width:0; }
  .soc-facts dt { font-size:.58rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:#94a3b8; }
  .soc-facts dd { margin:1px 0 0; font-size:.77rem; color:#1e293b; }
  .soc-when { display:inline-flex; align-items:center; gap:6px; }
  .soc-place { display:inline-flex; align-items:center; gap:5px; }
  .soc-place .fi { border-radius:2px; box-shadow:0 0 0 1px rgba(15,23,42,.08); }
  @media (max-width: 1150px) {
    .society-grid { grid-template-columns:1fr; }
  }
  .dest-pick[hidden] { display:none; }
  .dest-pick { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:10px; }
  .dbtn { display:inline-flex; align-items:center; gap:6px; padding:5px 11px; border-radius:999px; cursor:pointer;
    border:1px solid rgba(148,163,184,.4); background:#fff; color:#475569; font:inherit; font-size:.76rem;
    font-weight:600; white-space:nowrap; }
  .dbtn:hover { border-color:rgba(14,116,144,.5); color:#0e7490; }
  .dbtn.is-on { background:#0e7490; border-color:#0e7490; color:#fff; }
  .dbtn i { font-size:.8rem; }
  .dest-table .c-name { width:34%; }
  .dest-table .c-when { width:30%; }
  .open-tag { font-size:.62rem; font-weight:800; letter-spacing:.04em; text-transform:uppercase;
    color:#15803d; background:#dcfce7; border:1px solid #bbf7d0; border-radius:4px; padding:1px 6px; }
  .rounds-tag { font-size:.64rem; font-weight:800; color:#0369a1; background:#e0f2fe; border-radius:4px; padding:1px 5px; }
  .new-tag { font-size:.62rem; font-weight:800; letter-spacing:.05em; text-transform:uppercase;
    color:#5b21b6; background:#ede9fe; border:1px solid #ddd6fe; border-radius:4px; padding:1px 6px; }

  .c-date { white-space:nowrap; width:19%; }
  .round { display:flex; align-items:center; flex-wrap:wrap; gap:3px 5px; margin-bottom:5px; }
  .round:last-of-type { margin-bottom:0; }
  /* [hidden] is the weakest rule the browser has and loses to the display
     above it, so the rolled line needs saying twice. */
  .round[hidden] { display:none; }
  /* The abstract deadline comes first and is the one that actually shuts the
     door, so it leads the round and is coloured, not greyed. Once it has
     passed the date goes and the chip alone remains: the round is closed to
     new work even while its paper date is still ahead, and that fact is
     worth one word, not a line. */
  .abs-line { flex:0 0 100%; display:flex; align-items:center; gap:4px; margin-bottom:1px;
    font-size:.64rem; font-variant-numeric:tabular-nums; color:#92400e; }
  .abs-line b { font-size:.54rem; font-weight:800; letter-spacing:.05em; text-transform:uppercase;
    background:#fef3c7; border:1px solid #fde68a; border-radius:4px; padding:0 4px; color:#92400e; }
  .abs-days { font-size:.58rem; font-weight:700; }
  .abs-line.is-past { color:#b91c1c; }
  .abs-line.is-past b { background:#fee2e2; border-color:#fecaca; color:#b91c1c; }
  .round-label { flex:0 0 100%; font-size:.58rem; color:#a3adbb; line-height:1.2;
    white-space:normal; }
  .round-more { display:inline-block; margin-top:2px; white-space:normal; font-size:.6rem; color:#a3adbb; cursor:help;
    border-bottom:1px dotted rgba(148,163,184,.7); }
  .links { display:flex; gap:12px; margin-top:5px; }
  .links a { font-size:.67rem; font-weight:600; color:#94a3b8; text-decoration:none; }
  .links a:hover { color:var(--accent); }
  /* The date leads the cell, but the cell is now only the dates still ahead,
     so it does not need to shout to be found. */
  .dl { font-variant-numeric:tabular-nums; font-weight:700; color:#0f172a;
    font-size:.82rem; line-height:1.35; letter-spacing:-.01em; }
  /* An estimate is drawn differently from a published date, every time. */
  .dl.is-est { color:#64748b; font-weight:500; border-bottom:1px dashed rgba(100,116,139,.6); display:inline-block; }
  .est-tag i { margin-left:3px; opacity:.75; }
  .est-tag { display:inline-flex; align-items:center; margin-left:3px; font-size:.58rem; font-weight:700; color:#64748b;
    background:#f1f5f9; border:1px dashed rgba(148,163,184,.6); border-radius:4px; padding:0 4px; cursor:help; }
  .dl-days { display:inline-block; font-size:.62rem; font-weight:800; color:#fff;
    border-radius:999px; padding:1px 7px; background:#64748b; }
  .dl-days.band-urgent { background:#dc2626; }
  .dl-days.band-soon   { background:#1d4ed8; }
  .dl-days.band-far    { background:#64748b; }
  .dl-days.band-past   { background:#e2e8f0; color:#64748b; }

  .c-when { font-size:.73rem; color:#475569; width:30%; line-height:1.35; }
  /* The edition now lives inside the conference cell, set apart by a rule
     rather than a column. */
  /* The edition sits under the name as its own line. It used to be fenced off
     by a dotted rule, which drew a border around two lines of text that were
     never in any danger of being confused. */
  /* No rule above this line. It was the same hairline the table uses between
     rows, so it read as a row boundary inside a row. Space does the same job
     without the ambiguity. */
  .ed-line { display:flex; flex-wrap:wrap; align-items:center; gap:4px 9px;
    margin-top:7px; font-size:.73rem; color:#8a95a5; line-height:1.4; }
  .ed { display:inline-block; font-weight:600; color:#8a95a5; font-size:.74rem; margin-right:5px; }
  .ed-ord { display:inline-block; margin-right:5px; padding:1px 6px; border-radius:4px;
    background:#1e293b; color:#fff; font-size:.63rem; font-weight:800; letter-spacing:.02em; }
  .when { display:inline; }
  /* The place is the way out to somewhere that knows about the place. The
     three hand-written food notes that used to sit under every row said more
     about my guesswork than about the city. */
  .where { display:inline-flex; align-items:center; gap:5px; color:#8a95a5;
    text-decoration:none; }
  .where:hover { color:var(--accent); }
  .where i { font-size:.55rem; opacity:.45; }
  .ed-line .when { display:inline; }
  .where .fi { flex:0 0 auto; border-radius:2px; box-shadow:0 0 0 1px rgba(15,23,42,.08); }

  .c-rate { width:24%; }
  .c-subs { width:24%; }
  /* The chart fills the column it was given. At a fixed 214px it left a third
     of the cell empty, which is the gap that made this table look padded.
     preserveAspectRatio:none lets it stretch horizontally only, so the line
     keeps its height while the years spread out and become readable. Strokes
     and text are vector-effect'd back to a constant width, otherwise the
     stretch would smear them. */
  .rate-flat { cursor:help; }
  .spark { display:block; width:100%; max-width:420px; height:auto; overflow:visible; color:#1d4ed8; }
  .spark .grid { stroke:rgba(148,163,184,.35); stroke-width:.6; stroke-dasharray:2 2; }
  /* One level shared by every chart on the page. Without it each series
     floats in its own cell and the column reads as ragged. */
  .spark .base { stroke:rgba(148,163,184,.55); stroke-width:.7; stroke-dasharray:4 3; }
  .spark .glab { font-size:6px; fill:#94a3b8; }
  .spark .line { fill:none; stroke:currentColor; stroke-width:1.4; stroke-linejoin:round; stroke-linecap:round; }
  .spark .dot, .spark .dot-end { fill:currentColor; }
  /* The three most recent years, labelled on the chart. The leader is a
     hairline so it reads as a pointer rather than as data. */
  .spark .mdot { fill:currentColor; }
  .spark .mlead { stroke:rgba(148,163,184,.55); stroke-width:.5; fill:none; }
  .spark .mlab { font-size:11px; font-weight:700; fill:#0f172a; }
  .spark .myr { font-weight:600; fill:#94a3b8; }
  .rate.is-stale .spark .mlab { fill:#64748b; }
  /* The line draws itself left to right with a dot at the leading edge, then
     rests on the finished chart before starting over. Staggered so a screen
     full of them does not pulse in unison. */
  .spark .line {
    stroke-dasharray: var(--len); stroke-dashoffset: var(--len);
    animation: spark-draw 7s ease-in-out var(--delay, 0s) infinite;
  }
  .anim-off .spark .line,
  .anim-off .spark .dot,
  .anim-off .spark .dot-end { animation-play-state: paused; }
  .spark .dot {
    offset-rotate: 0deg; opacity: 0;
    animation: spark-ride 7s ease-in-out var(--delay, 0s) infinite;
  }
  .spark .dot-end { opacity: 0; animation: spark-rest 7s ease-in-out var(--delay, 0s) infinite; }
  @keyframes spark-draw {
    0%   { stroke-dashoffset: var(--len); }
    45%  { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 0; }
  }
  @keyframes spark-ride {
    0%   { offset-distance: 0%;   opacity: 0; }
    4%   { opacity: 1; }
    45%  { offset-distance: 100%; opacity: 1; }
    52%  { offset-distance: 100%; opacity: 0; }
    100% { offset-distance: 100%; opacity: 0; }
  }
  @keyframes spark-rest {
    0%, 45% { opacity: 0; }
    52%, 100% { opacity: 1; }
  }
  /* Anyone who has asked for less motion gets the finished chart, still. */
  @media (prefers-reduced-motion: reduce) {
    .spark .line { animation: none; stroke-dashoffset: 0; }
    .spark .dot { display: none; }
    .spark .dot-end { animation: none; opacity: 1; }
  }
  .rate.is-stale .spark { color:#94a3b8; }
  /* chart and numbers on the left, the link to the full history on the right */
  .rate { display:grid; grid-template-columns:minmax(0,1fr) auto; column-gap:10px; align-items:center; }
  .rate > .spark { grid-column:1; grid-row:1; }
  .rate > .rate-side { grid-row:1; }
  .rate > .rate-side { grid-column:2; grid-row:1 / span 2; }
  .rate-side { display:flex; flex-direction:column; gap:4px; align-items:flex-start; }
  .rate-more { font-size:.63rem; font-weight:700; color:#475569; text-decoration:none; white-space:nowrap;
    border:1px solid rgba(148,163,184,.45); border-radius:999px; padding:1px 7px; background:#fff; }
  .rate-more:hover { color:var(--accent); border-color:rgba(37,99,235,.5); }
  .rate-stale-note { font-size:.62rem; font-weight:700; color:#64748b; background:#f1f5f9;
    border-radius:4px; padding:1px 5px; white-space:nowrap; }

  .c-rank { white-space:nowrap; width:9%; }
  .ranks { display:flex; flex-direction:column; gap:4px; align-items:flex-start; }
  .pill { display:inline-block; min-width:86px; text-align:center; padding:2px 8px; border-radius:5px;
    font-size:.68rem; font-weight:800; color:#fff; letter-spacing:.02em; }
  /* CCF: red / orange / yellow. CORE: red / orange / yellow / green. Same hues,
     so a reader compares the two tables without relearning a palette. */
  .ccf-a { background:#dc2626; } .ccf-b { background:#1d4ed8; } .ccf-c { background:#15803d; }
  .ccf-n { background:#e2e8f0; color:#64748b; }
  .core-as { background:#dc2626; } .core-a { background:#1d4ed8; } .core-b { background:#15803d; }
  .core-c { background:#64748b; }
  .core-tbr, .core-jp, .core-n { background:#e2e8f0; color:#64748b; }
  /* CSRankings is a yes or no, not a grade, so it gets one colour and a
     muted off state rather than a place on the red/blue/green scale. */
  a.pill.csr-yes { background:#0f172a; color:#fff; text-decoration:none; }
  a.pill.csr-yes:hover { background:#334155; }
  .csr-no { background:#f1f5f9; color:#94a3b8; }
  .eqv-none { color:#475569; background:#f8fafc; border-color:#cbd5e1; }
  .why { margin:4px 0 0; text-align:left; font-size:.72rem; line-height:1.5; color:#64748b;
    border-left:2px solid rgba(148,163,184,.4); padding-left:8px; }
  .eqv { display:inline-block; max-width:180px; white-space:normal; font-size:.7rem; line-height:1.4;
    color:#5b21b6; background:#f5f3ff; border:1px solid #ddd6fe; border-radius:6px; padding:4px 8px; font-weight:600; }

  .none { color:#b6c0cc; font-size:.75rem; }
  .empty-note { margin:16px 0 0; font-size:.84rem; color:#64748b; }

  /* Three chips where a paragraph used to be. Field first, because that is
     what a reader scanning twenty cards is sorting on. */
  .soc-tags { list-style:none; display:flex; flex-wrap:wrap; gap:5px; margin:8px 0 0; padding:0; }
  .soc-tags li { font-size:.66rem; font-weight:600; line-height:1.3; border-radius:999px;
    padding:2px 9px; border:1px solid transparent; }
  .st-field { color:#0f172a; background:#eef2f7; border-color:rgba(148,163,184,.4); font-weight:700; }
  .st-kind { color:#475569; background:#fff; border-color:rgba(148,163,184,.4); }
  .st-kind.is-top { color:#0e7490; background:#ecfeff; border-color:rgba(14,116,144,.35); font-weight:700; }
  .st-why { color:#64748b; background:#fff; border-color:rgba(148,163,184,.3); cursor:help; }
  .proc { font-size:.62rem; font-weight:800; letter-spacing:.04em; text-transform:uppercase; border-radius:4px; padding:2px 6px; }
  .proc-none { color:#475569; background:#e2e8f0; }
  .proc-optin { color:#92400e; background:#fef3c7; }
  .proc-abstracts { color:#3730a3; background:#e0e7ff; }

  .rest { border:1px solid rgba(148,163,184,.26); border-radius:12px; background:#fbfcfe; }
  .rest > summary { cursor:pointer; list-style:none; display:flex; align-items:center; gap:10px; padding:12px 16px; }
  .rest > summary::-webkit-details-marker { display:none; }
  .rest > summary h2 { font-size:.98rem; margin:0; }
  .rest-count { font-size:.72rem; font-weight:700; color:#64748b; background:#f1f5f9; border-radius:999px; padding:2px 8px; }
  .rest-note { font-size:.74rem; color:#94a3b8; margin-left:auto; text-align:right; }
  /* Two columns of topics side by side: the rows are short and there are
     thirty of them, so one column left half the width empty and pushed the
     rest of the page down. The header carries one label set per column. */
  /* The topic chart and the panel that floats over it. */
  .tchart-wrap { position:relative; padding:4px 12px 2px; }
  .tchart-scroll { overflow-x:auto; overflow-y:visible; }
  .tchart { display:block; width:100%; height:auto; overflow:visible; }
  .tc-grid { stroke:rgba(148,163,184,.3); stroke-width:.7; stroke-dasharray:3 3; }
  .tc-base { stroke:rgba(148,163,184,.65); stroke-width:.9; }
  .tc-glab { font-size:8px; fill:#94a3b8; font-weight:700; }
  .tc-axis { font-size:8px; fill:#b6bfcc; letter-spacing:.02em; }
  .tc-n { font-size:7.6px; fill:#a3adbb; font-variant-numeric:tabular-nums; }
  /* Rate is the sort key, so the ramp reads left to right and gives the
     chart a direction that bar heights inside a 17 point band cannot. */
  .tc-fill { fill:#93c5fd; transition:fill .12s ease; }
  .tone-a .tc-fill { fill:#1d4ed8; }
  .tone-b .tc-fill { fill:#3b82f6; }
  .tone-c .tc-fill { fill:#7dafff; }
  .tone-d .tc-fill { fill:#b9d4fe; }
  .tc-hit { fill:transparent; cursor:pointer; }
  .tc-lab { font-size:12.5px; fill:#475569; dominant-baseline:middle; }
  .tc-pct { font-weight:800; fill:#0f172a; }
  .tc-sub { fill:#b6bfcc; font-variant-numeric:tabular-nums; }
  .tc-lead { fill:none; stroke:rgba(148,163,184,.5); stroke-width:.6; }
  .tc-bar:hover .tc-lead, .tc-bar.is-on .tc-lead { stroke:#0f172a; stroke-width:1; }
  .tc-bar:hover .tc-fill, .tc-bar.is-on .tc-fill { fill:#0f172a; }
  .tc-bar:hover .tc-lab, .tc-bar.is-on .tc-lab { fill:#0f172a; }
  .tc-bar:focus { outline:none; }
  .tc-bar:focus-visible .tc-fill { stroke:#0f172a; stroke-width:1.2; }
  .tchart-note { margin:2px 0 8px; font-size:.64rem; color:#a3adbb; }
  /* Floating, not inline: the list used to push every row below it down the
     page, and with the bars side by side there is no row to push. */
  .tpop { position:absolute; z-index:30; width:min(560px, 94%); max-height:320px; overflow:auto;
    background:#fff; border:1px solid rgba(148,163,184,.45); border-radius:12px;
    box-shadow:0 14px 34px rgba(15,23,42,.18); padding:10px 13px 8px; }
  .tpop[hidden] { display:none; }
  .tpop-head { display:flex; align-items:baseline; gap:9px; margin-bottom:5px;
    padding-bottom:5px; border-bottom:1px solid rgba(148,163,184,.3); }
  .tpop-head b { font-size:.78rem; color:#0f172a; }
  .tpop-head span { font-size:.64rem; color:#94a3b8; font-weight:700; }
  .tpop-x { margin-left:auto; border:0; background:none; cursor:pointer; font-size:1rem;
    line-height:1; color:#94a3b8; padding:0 2px; }
  .tpop-x:hover { color:#0f172a; }
  .tpop-list { display:block !important; padding:0 !important; border:0 !important; margin:0 !important; }

  .topic-list { list-style:none; margin:0; padding:0 10px 14px; display:grid;
    grid-template-columns:1fr 1fr; column-gap:26px; gap:1px 26px; }
  .topic-head { display:grid; grid-template-columns:1fr 1fr; column-gap:26px; }
  .th-row, .topic-list li {
    display:grid; grid-template-columns:50px 70px minmax(0,1fr) 44px 58px 56px; gap:8px; align-items:center; }
  /* The rate label spans the number and its bar, so it fits on one line
     instead of being cut to fit a number-sized column. */
  .th-rate  { grid-column:1 / span 2; }
  .th-topic { grid-column:3; }
  .th-share { grid-column:4 / span 2; text-align:right; }
  .th-count { grid-column:6; text-align:right; }
  .th-rate { cursor:help; }
  .topic-head { padding:0 10px 7px; font-size:.55rem; align-items:end; letter-spacing:.05em;
    text-transform:uppercase; color:#64748b; font-weight:700; white-space:nowrap; }
  /* The two number labels are wider than their numbers, so let them wrap
     rather than run into each other. */
  .th-share, .th-count { white-space:normal; line-height:1.1; }
  .th-row { align-items:end; }
  .topic-head .th-mute { color:#94a3b8; font-weight:700; line-height:1.15; }
  .topic-list li { font-size:.8rem; padding:3px 10px 3px 0; }
  .topic-list li.has-papers { cursor:pointer; }
  .t-open { display:inline-flex; align-items:center; gap:4px; margin-left:9px; padding:1px 7px;
    border:1px solid rgba(148,163,184,.55); border-radius:999px; background:#fff;
    font-size:.62rem; font-weight:700; color:#64748b; white-space:nowrap; vertical-align:1px; }
  .topic-list li.has-papers:hover .t-open { border-color:rgba(37,99,235,.55); color:var(--accent); }
  .topic-list li.is-open .t-open { border-color:rgba(37,99,235,.55); color:var(--accent); }
  .topic-list li.is-open .t-open i { transform:rotate(180deg); }
  /* The exemplars sit inside the row and break out of its grid. */
  .t-papers { display:none; grid-column:1 / -1; list-style:none; margin:4px 0 7px; padding:7px 0 2px 58px;
    text-align:left;
    border-top:1px dashed rgba(148,163,184,.35); }
  .topic-list li.is-open .t-papers { display:block; }
  .t-papers { counter-reset:pp; }
  .t-papers li { display:grid; grid-template-columns:18px 36px 62px 30px minmax(0,1fr); gap:7px;
    align-items:baseline; padding:2px 0; font-size:.74rem; }
  .pp-n::before { counter-increment:pp; content:counter(pp) '.'; }
  .pp-n { text-align:right; font-size:.66rem; color:#cbd5e1; font-variant-numeric:tabular-nums; }
  .pp-c { text-align:right; font-weight:800; color:#0f172a; font-variant-numeric:tabular-nums; }
  .pp-k { font-size:.6rem; font-weight:800; letter-spacing:.04em; text-transform:uppercase; text-align:center;
    border-radius:4px; padding:1px 0; color:#fff; background:#94a3b8; }
  .pp-oral { background:#dc2626; } .pp-spotlight { background:#1d4ed8; } .pp-poster { background:#94a3b8; }
  .pp-y { font-size:.66rem; color:#94a3b8; font-variant-numeric:tabular-nums; }
  .t-papers li > *:last-child { text-align:left; }
  .t-papers a { color:#334155; text-decoration:none; border-bottom:1px solid rgba(148,163,184,.45); }
  .t-papers a:hover { color:var(--accent); border-color:currentColor; }
  .topic-list li:hover { background:#eef2f7; border-radius:5px; }
  /* Folded by default: it is a personal side list, not part of the main
     breakdown, so it should not push the table down until someone wants it. */
  .topic-list li:nth-child(4n+3), .topic-list li:nth-child(4n+4) {
    background:rgba(148,163,184,.055); border-radius:5px; }
  /* The pair that matters: how hard the topic is, and which way it moved. */
  .t-rate { font-weight:800; font-size:.86rem; color:#0f172a; font-variant-numeric:tabular-nums; text-align:right; }
  .t-bar { height:7px; border-radius:999px; background:rgba(148,163,184,.25); overflow:hidden; }
  .t-fill { display:block; height:100%; border-radius:999px; background:linear-gradient(90deg,#60a5fa,#1d4ed8); }
  /* The second bar reads the share, which is a fact about the pile and not
     about the bar for getting in, so it is drawn flatter and greyer than
     the rate bar beside it. */
  .t-sbar { height:5px; }
  .t-sbar .t-fill { background:#cbd5e1; }
  .t-name { color:#1e293b; line-height:1.3; text-align:left; }
  /* The secondary pair, deliberately quieter. */
  .t-share, .t-count { font-size:.7rem; color:#64748b; text-align:right; font-variant-numeric:tabular-nums; }
  .t-count { color:#94a3b8; }
  .t-up { color:#15803d; } .t-down { color:#dc2626; } .t-flat { color:#cbd5e1; }
  .topics > summary { border-bottom:1px solid rgba(148,163,184,.2); }
  /* Sitting above the table, this is context for it, not a footnote. */
  .topics.lead { background:#fbfcfe; }
  .topics.lead > summary h2 { font-size:1.02rem; }
  .rest-list { list-style:none; margin:0; padding:0 16px 14px; display:grid;
    grid-template-columns:repeat(auto-fill, minmax(300px,1fr)); gap:7px 18px; }
  .rest-list li { display:grid; grid-template-columns:auto auto auto 1fr; gap:7px; align-items:center; font-size:.78rem; }
  .rest-list a { font-weight:700; color:#334155; text-decoration:none; }
  .rest-list a:hover { color:var(--accent); }
  .rest-desc { color:#94a3b8; font-size:.71rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

  .sources { border-top:1px solid rgba(148,163,184,.26); padding-top:14px; }
  .src-list { list-style:none; margin:12px 0 0; padding:0; display:grid;
    grid-template-columns:repeat(auto-fit, minmax(260px,1fr)); gap:0; }
  .src-list li { padding:9px 14px 9px 0; border-top:1px solid rgba(148,163,184,.22); }
  .src-list a, .src-plain { display:block; font-size:.82rem; font-weight:700; color:#1e293b;
    text-decoration:none; }
  .src-list a:hover { color:var(--accent); }
  .src-list a::after { content:'\f08e'; font-family:'Font Awesome 6 Free'; font-weight:900;
    font-size:.56rem; margin-left:6px; color:#cbd5e1; vertical-align:2px; }
  .src-list span:last-child { display:block; font-size:.74rem; color:#94a3b8; line-height:1.45; margin-top:2px; }
  .src-plain { color:#64748b; }
  .src-note { margin-top:16px; padding:11px 14px; border:1px solid rgba(148,163,184,.3); border-radius:10px;
    background:#f8fafc; font-size:.78rem; color:#475569; line-height:1.65; }
  .src-note b { color:#0f172a; }
  .src-note .est-tag { margin:0 2px; }
  .src-note a { color:#64748b; }

  /* Narrow screens: the table stops being a table. Each row becomes a card
     with its cells labelled, so everything stays readable instead of being
     pushed off the side behind a horizontal scrollbar. */
  @media (max-width: 1320px) {
    .table-wrap { overflow-x:visible; border:0; }
    /* The filter row wraps instead of hiding its tail behind a sideways scroll. */
    .filter { flex-wrap:wrap; overflow-x:visible; row-gap:6px; }
    .fbtn-dest { margin-left:0; }
    table.confs { min-width:0; table-layout:auto; display:block; }
    .confs thead { display:none; }
    .confs tbody { display:block; }
    .confs tbody tr { display:block; margin-bottom:10px; padding:10px 12px;
      border:1px solid rgba(148,163,184,.3); border-radius:12px; background:#fff; }
    .confs tbody td { display:block; width:auto !important; padding:0; border:0; }
    .confs tbody td + td { margin-top:9px; padding-top:9px; border-top:1px dashed rgba(148,163,184,.3); }
    .confs tbody td[data-label]::before { content:attr(data-label); display:block; margin-bottom:3px;
      font-size:.6rem; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:#94a3b8; }
    .c-name, .c-date, .c-when, .c-rate, .c-subs, .c-rank { width:auto !important; white-space:normal; }
    .conf-desc, .why { max-width:none; }
    .round-label, .round-more { max-width:none; }
    .ranks { flex-direction:row; flex-wrap:wrap; gap:6px; }
    .rate { grid-template-columns:auto 1fr; column-gap:14px; }
    .rate-side { grid-column:2; grid-row:1 / span 2; }
    .spark { width:100%; max-width:220px; }
    /* The topic block is a grid, not a table, and needs its own squeeze. */
    .rest > summary { flex-wrap:wrap; gap:6px 10px; }
    .rest > summary h2 { flex:1 0 100%; }
    .topic-head { display:none; }
    /* Twenty-one rotated labels do not survive being scaled to a phone, so
       the chart keeps its size and the block scrolls sideways instead. */
    .tchart { min-width:900px; }
    .topic-list { grid-template-columns:1fr; gap:1px; }
    .topic-list li { grid-template-columns:50px minmax(0,1fr) 56px; row-gap:2px; }
    .topic-list li > .t-bar, .t-share { display:none; }
    .topic-list li:nth-child(4n+3), .topic-list li:nth-child(4n+4) { background:none; }
    .topic-list li:nth-child(even) { background:rgba(148,163,184,.055); border-radius:5px; }
    .t-papers { padding-left:0; }
    .t-papers li { grid-template-columns:18px 38px 64px minmax(0,1fr); }
  }

  @media (max-width: 760px) {
    .head-row { flex-direction:column; }
    .c-when, .c-rate { display:none; }
  }
</style>

<script>
  const DAY = 86400000;
  const today = new Date(); today.setHours(0, 0, 0, 0);

  // Run the chart animation only while the table is on screen. One observer
  // over the wrapper, not thirty-nine over the charts.
  // The destination table comes first in the DOM, so find the wrapper that
  // actually holds the charts rather than the first one on the page.
  const firstSpark = document.querySelector('.spark');
  const chartHost = firstSpark && firstSpark.closest('.table-wrap');
  if (chartHost && 'IntersectionObserver' in window) {
    new IntersectionObserver((entries) => {
      entries.forEach((e) => chartHost.classList.toggle('anim-off', !e.isIntersecting));
    }, { rootMargin: '150px' }).observe(chartHost);
  }

  // Abstract deadlines: the one that closes the round, so a passed abstract
  // is called out in red even while the paper date is still ahead.
  document.querySelectorAll('.abs-line').forEach((el) => {
    const raw = el.getAttribute('data-abs');
    if (!raw) return;
    const [y, m, d] = raw.split('-').map(Number);
    const days = Math.round((new Date(y, m - 1, d).getTime() - today.getTime()) / DAY);
    const tag = el.querySelector('.abs-days');
    if (days < 0) {
      el.classList.add('is-past');
      if (tag) tag.textContent = 'closed';
      const date = el.querySelector('.abs-date');
      if (date) date.hidden = true;
    } else if (tag) {
      tag.textContent = days === 0 ? 'today' : days + 'd';
    }
  });

  document.querySelectorAll('.dl-days').forEach((el) => {
    const raw = el.getAttribute('data-deadline');
    if (!raw) return;
    const [y, m, d] = raw.split('-').map(Number);
    const days = Math.round((new Date(y, m - 1, d).getTime() - today.getTime()) / DAY);
    const band = days < 0 ? 'past' : days < 30 ? 'urgent' : days < 90 ? 'soon' : 'far';
    el.classList.add('band-' + band);
    el.textContent = days < 0 ? 'closed' : days === 0 ? 'today' : `${days}d`;
    // The page is rebuilt weekly, so a round that was live at build time can
    // close before the next build. It leaves the cell the same way the ones
    // already closed at build time did, rather than sitting there greyed.
    if (days < 0) {
      const round = el.closest('.round');
      if (round && !round.classList.contains('rolled')) round.hidden = true;
    }
  });

  // Re-run the ordering in the reader's today.
  //
  // The page is static and rebuilt weekly, so the order baked into it is
  // right on the Monday and drifts every day after. The rule is the same one
  // the build uses: while a round's abstract deadline is open that is the
  // date that counts, once it closes the full paper date takes over, and a
  // venue with nothing ahead of it rolls a year forward and sinks below
  // everything still live.
  const pad = (n) => String(n).padStart(2, '0');
  const ymd = (d) => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
  const TODAY = ymd(today);
  const rollYear = (iso) => {
    const [y, m, d] = iso.split('-').map(Number);
    const nd = new Date(y + 1, m - 1, d);
    if (nd.getMonth() !== m - 1) nd.setDate(0);       // Feb 29 lands on Feb 28
    return ymd(nd);
  };

  const liveKey = (tr) => {
    const cell = tr.querySelector('.c-date');
    if (!cell) return { key: '', expired: false };
    const rounds = Array.from(cell.querySelectorAll('.round:not(.rolled)')).map((el) => {
      const dl = el.querySelector('.dl');
      const abs = el.querySelector('.abs-line');
      const lab = el.querySelector('.round-label');
      return {
        d: dl ? dl.textContent.trim() : '',
        abs: abs ? abs.getAttribute('data-abs') || '' : '',
        // A commitment round takes papers that already have ARR reviews. It
        // is not a date new work can be sent to, so it never counts as the
        // venue still being open.
        sub: !/commitment/i.test(lab ? lab.textContent : ''),
      };
    });
    // A row past MAX_ROUNDS keeps its tail in the "+N more" tooltip. Those
    // dates still count: without them a venue whose shown rounds have all
    // closed would look finished while a later one is still open.
    const more = cell.querySelector('.round-more');
    if (more) {
      (more.getAttribute('title') || '').split(', ').forEach((d) => {
        if (/^\d{4}-\d{2}-\d{2}$/.test(d)) rounds.push({ d, abs: '', sub: true });
      });
    }
    if (!rounds.length) return { key: '', expired: false };
    rounds.sort((a, b) => a.d.localeCompare(b.d));
    const subs = rounds.filter((r) => r.sub);
    const pool = subs.length ? subs : rounds;
    for (const r of pool) {
      if (r.abs && r.abs >= TODAY) return { key: r.abs, expired: false };
      if (r.d && r.d >= TODAY) return { key: r.d, expired: false };
    }
    return { key: rollYear(pool[0].d), expired: true };
  };

  document.querySelectorAll('table.confs:not(.dest-table):not(.jrnl-table) tbody').forEach((tbody) => {
    // A sub-row (ICLR's topic chart) travels with the row above it.
    const subs = new Map();
    tbody.querySelectorAll('tr.sub-row').forEach((sr) => subs.set(sr.previousElementSibling, sr));
    const trs = Array.from(tbody.querySelectorAll('tr:not(.sub-row)'));
    trs.forEach((tr) => {
      const live = liveKey(tr);
      tr.dataset.live = live.key || '9999-12-31';
      tr.classList.toggle('is-spent', live.expired);
      const rolled = tr.querySelector('.round.rolled');
      if (!rolled) return;
      rolled.hidden = !live.expired;
      if (!live.expired) return;
      // The build may have rolled from a different round than today would.
      const dl = rolled.querySelector('.dl');
      const tag = rolled.querySelector('.dl-days');
      if (dl && live.key && dl.textContent.trim() !== live.key) {
        dl.textContent = live.key;
        if (tag) {
          const [y, m, d] = live.key.split('-').map(Number);
          const days = Math.round((new Date(y, m - 1, d).getTime() - today.getTime()) / DAY);
          tag.className = 'dl-days band-' + (days < 30 ? 'urgent' : days < 90 ? 'soon' : 'far');
          tag.textContent = days + 'd';
        }
      }
    });
    trs
      .sort((a, b) => a.dataset.live.localeCompare(b.dataset.live))
      .forEach((tr) => {
        tbody.appendChild(tr);
        if (subs.has(tr)) tbody.appendChild(subs.get(tr));
      });
  });

  // Field filter. Rows carry their own area, so this is pure show/hide. The
  // date order never changes underneath the reader.
  const rows = Array.from(document.querySelectorAll('table.confs:not(.dest-table):not(.jrnl-table) tbody tr'));
  const empty = document.querySelector('.empty-note');
  // Each topic row opens to its most-cited accepted papers.
  document.querySelectorAll('.topic-list li.has-papers').forEach((row) => {
    row.addEventListener('click', (e) => {
      if (e.target.closest('a')) return;      // let a paper link through
      row.classList.toggle('is-open');
    });
  });

  // The topic chart's paper panels. One panel per bar, floated over the
  // chart next to the bar that opened it and nudged back inside when the
  // bar is near an edge, since a panel half off the page is no panel.
  document.querySelectorAll('.tchart-wrap').forEach((wrap) => {
    const pops = wrap.querySelectorAll('[data-pop]');
    const close = () => {
      pops.forEach((p) => { p.hidden = true; });
      wrap.querySelectorAll('.tc-bar.is-on').forEach((b) => b.classList.remove('is-on'));
    };
    wrap.querySelectorAll('.tc-bar').forEach((bar) => {
      const open = () => {
        const pop = pops[Number(bar.dataset.topic)];
        if (!pop) return;
        const was = !pop.hidden;
        close();
        if (was) return;
        pop.hidden = false;
        bar.classList.add('is-on');
        const box = wrap.getBoundingClientRect();
        const b = bar.querySelector('.tc-fill').getBoundingClientRect();
        const w = pop.offsetWidth;
        let left = b.left - box.left + b.width / 2 - w / 2;
        left = Math.max(6, Math.min(left, box.width - w - 6));
        pop.style.left = left + 'px';
        pop.style.top = (b.bottom - box.top + 8) + 'px';
      };
      bar.addEventListener('click', open);
      bar.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
      });
    });
    wrap.querySelectorAll('.tpop-x').forEach((x) => x.addEventListener('click', close));
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.tchart-wrap')) close();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  });


  // Representative papers per keyword, fetched once per field on first use.
  const paperCache = {};
  document.querySelectorAll('.trends').forEach((box) => {
    const list = box.querySelector('.trend-list');
    const panel = box.querySelector('.tr-papers');
    if (!list || !panel) return;
    const field = list.dataset.field;
    const close = () => {
      panel.hidden = true;
      list.querySelectorAll('li.is-on').forEach((li) => li.classList.remove('is-on'));
    };
    panel.querySelector('.trp-x').addEventListener('click', close);
    list.querySelectorAll('li[data-kw] button.tr-name').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const li = btn.closest('li');
        if (li.classList.contains('is-on')) { close(); return; }
        list.querySelectorAll('li.is-on').forEach((x) => x.classList.remove('is-on'));
        li.classList.add('is-on');
        const kw = li.dataset.kw;
        panel.querySelector('.trp-title').textContent = li.dataset.label;
        panel.querySelector('.trp-oa').href = `https://openalex.org/works?filter=keywords.id:${kw}`;
        const ol = panel.querySelector('.trp-list');
        ol.innerHTML = '<li>Loading…</li>';
        panel.hidden = false;
        try {
          paperCache[field] = paperCache[field] || await fetch(`/trend-papers/${field}.json`).then((r) => r.json());
          const ps = paperCache[field][kw] || [];
          ol.innerHTML = '';
          ps.forEach((p) => {
            const item = document.createElement('li');
            const a = document.createElement('a');
            a.href = p.u; a.target = '_blank'; a.rel = 'noopener'; a.textContent = p.t;
            const meta = document.createElement('span');
            meta.className = 'trp-meta';
            meta.textContent = [p.a, p.v && `${p.v} ${p.y}`, `${p.c.toLocaleString()} citations`].filter(Boolean).join(' · ');
            item.append(a, meta);
            ol.appendChild(item);
          });
          if (!ps.length) ol.innerHTML = '<li>No papers found.</li>';
        } catch (e) {
          ol.innerHTML = '<li>Could not load the papers.</li>';
        }
      });
    });
  });
  // Hover covers the mouse, focus covers the keyboard, and this covers the
  // phone, where neither exists.
  const legendWrap = document.querySelector('.legend-wrap');
  if (legendWrap) {
    const btn = legendWrap.querySelector('.legend-btn');
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const on = legendWrap.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', on ? 'true' : 'false');
    });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.legend-wrap')) {
        legendWrap.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        legendWrap.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // The topic breakdown is ICLR, so it belongs to one field. There is no
  // equivalent for the others yet, and showing AI's numbers while the reader
  // has Security selected would read as if they were Security's.

  const scholarLink = document.getElementById('scholar-link');
  const destSection = document.getElementById('destinations');
  // The legend explains the table's countdown bands and cycle tags, so it
  // only shows with a table field.
  const legend = document.getElementById('legend');
  const doms = Array.from(document.querySelectorAll('.dom'));
  const fieldBtns = Array.from(document.querySelectorAll('.dir .dchip'));
  const destBtn = document.querySelector('.fbtn-dest');
  const jfoot = document.querySelector('.jrnl-foot');

  // One field at a time. The field's section carries its own columns, so
  // switching is showing one section and hiding the rest.
  const apply = (btn) => {
    const want = btn.dataset.area;
    const onDest = want === 'destinations';
    if (destSection) destSection.hidden = !onDest;
    if (jfoot) jfoot.hidden = onDest;
    let dom = null;
    doms.forEach((d) => {
      const on = !onDest && d.dataset.domain === want;
      d.hidden = !on;
      if (on) dom = d;
    });
    if (legend) legend.hidden = !dom || !dom.classList.contains('dom-table');
    [...fieldBtns, destBtn].forEach((b) => b && b.classList.toggle('is-on', b === btn));
    if (scholarLink) {
      const url = onDest ? '' : (btn.dataset.scholar || '');
      scholarLink.hidden = !url;
      if (url) scholarLink.href = url;
    }
  };
  fieldBtns.forEach((btn) => btn.addEventListener('click', () => apply(btn)));
  if (destBtn) destBtn.addEventListener('click', () => apply(destBtn));

  // One destination list. There is no search, so the data holds only what a
  // chip can reach; anything else is dropped at build time rather than
  // shipped with no way in.
  const destRows = Array.from(document.querySelectorAll('.dest-table tbody tr'));
  const destNone = document.querySelector('.dest-none');
  let pick = '';

  const paintDest = () => {
    let shown = 0;
    destRows.forEach((r) => {
      const on = r.dataset.dest === pick;
      r.hidden = !on;
      if (on) shown++;
    });
    if (destNone) destNone.hidden = shown > 0;
  };

  document.querySelectorAll('.dbtn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.dbtn').forEach((b) => b.classList.toggle('is-on', b === btn));
      pick = btn.dataset.dest;
      paintDest();
    });
  });
  const firstDest = document.querySelector('.dbtn');
  if (firstDest) { pick = firstDest.dataset.dest; paintDest(); }
  // The markup marks AI as selected; run the filter so the rows agree with it.
  const start = document.querySelector('.dir .dchip.is-on');
  if (start) apply(start);
</script>
