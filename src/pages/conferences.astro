---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { ranked, notable, journals } from '../data/conferences.js';
import { topicRates } from '../data/topics.js';
import { destinations } from '../data/destinations.js';
import { DOMAINS, GROUPS } from '../data/domains.js';
import { trends } from '../data/trends.js';

// The fields live in src/data/domains.js, each with the format that suits
// it. AI opens first: it is what this page is mostly for.
const DEFAULT = 'ai';
const slug = (a) => a.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');
// Fixed 0-45% scale: the point of the bars is to compare venues to each other,
// which a per-row scale would destroy.
const RATE_MAX = 45;
// Wide on purpose. At 180 the chart used a little over half its column and
// the rest of the cell was empty, which is most of what made this table look
// padded. The geometry itself grows rather than the drawing being stretched,
// so the line keeps its weight and the dot stays round.
//
// Twice as tall as it was, too. At 38 units against 300 wide, a swing from
// 20% to 40% was a few pixels of vertical travel and every venue's history
// looked like the same flat line. The extra height is pure vertical
// resolution: the scale is still fixed at 0 to RATE_MAX, so two venues are
// still directly comparable, there is simply room to see the shape.
const CHART = { w: 300, h: 110 };
// Headroom above the plot for the year labels, in the same user units. Five
// of them at this size will not fit on one row without touching, so they
// alternate between two, which halves the horizontal space each one needs.
const LABEL_ROWS = [-24, -10];
const MARKED_YEARS = 5;
// A line over the whole published history, on a fixed axis so two venues can
// be compared by eye. The three most recent numbers are printed underneath,
// because that is what anyone actually wants off this cell.
// Submissions over the same years, drawn in the same hand as the rate chart.
//
// Its own scale, not a shared one: venues run from a few hundred submissions
// to thirty thousand, and one axis across all of them would flatten every
// small venue into a line on the floor. The axis is labelled, so the shape
// is comparable between venues even though the height is not.
const volume = (subs) => {
  if (!subs || subs.length < 2) return null;
  const hi = Math.max(...subs.map((p) => p.n));
  // The next round number above the peak, not the next power of ten: a
  // venue topping out at 3,370 should fill the box, not a third of it.
  const pow = Math.pow(10, Math.floor(Math.log10(hi)));
  const top = pow * ([1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10].find((f) => f * pow >= hi) || 10);
  const xs = subs.map((p, i) => (i / (subs.length - 1)) * CHART.w);
  const y = (n) => CHART.h - (Math.min(n, top) / top) * CHART.h;
  const pts = subs.map((p, i) => [xs[i], y(p.n)]);
  const d = pts.map(([px, py], i) => `${i ? 'L' : 'M'}${px.toFixed(1)},${py.toFixed(1)}`).join(' ');
  const len = pts.slice(1).reduce(
    (a, [px, py], i) => a + Math.hypot(px - pts[i][0], py - pts[i][1]), 0);
  const show = (n) => (n >= 1000 ? `${Number((n / 1000).toFixed(n >= 10000 ? 1 : 2)).toString()}k` : String(Math.round(n)));
  const recent = subs.slice(-MARKED_YEARS);
  const first = 1 - 0.13 * recent.length;
  const marks = recent.map((p, k) => {
    const i = subs.length - recent.length + k;
    const t = recent.length === 1 ? 1 : first + (1.02 - first) * (k / (recent.length - 1));
    // The axis is rounded, the annotated points are not.
    const exact = p.n >= 10000 ? show(p.n) : p.n.toLocaleString('en-US');
    return { x: xs[i], y: y(p.n), v: exact, yr: String(p.y).slice(2),
             lx: CHART.w * t, ly: LABEL_ROWS[k % LABEL_ROWS.length] };
  });
  return {
    d, len: Math.ceil(len),
    last: { x: xs[xs.length - 1], y: y(subs[subs.length - 1].n) },
    grid: [0.25, 0.5, 0.75, 1].map((f) => ({ v: show(top * f), y: y(top * f) })),
    marks,
    span: `${subs[0].y}\u2013${subs[subs.length - 1].y}`,
  };
};

const chart = (rates) => {
  if (!rates || rates.length < 2) return null;
  const xs = rates.map((p, i) => (i / (rates.length - 1)) * CHART.w);
  const y = (r) => CHART.h - (Math.min(r, RATE_MAX) / RATE_MAX) * CHART.h;
  const pts = rates.map((p, i) => [xs[i], y(p.r)]);
  // Path and its length, both needed by the draw-on animation: the dash
  // trick needs the length, and the dot rides the same path.
  const d = pts.map(([px, py], i) => `${i ? 'L' : 'M'}${px.toFixed(1)},${py.toFixed(1)}`).join(' ');
  const len = pts.slice(1).reduce(
    (a, [px, py], i) => a + Math.hypot(px - pts[i][0], py - pts[i][1]), 0);
  // The three most recent years, labelled on the chart itself now that the
  // row of numbers under it is gone.
  //
  // They cannot be labelled in place. Thirty-nine years across 300 units puts
  // consecutive points about eight units apart, and a label like "'26 33.3%"
  // is nearer thirty wide, so three of them stacked over the right-hand edge
  // would sit on top of each other. Instead they are spread along a band
  // above the plot, each with a hairline leading down to the point it
  // belongs to, which is why the viewBox carries headroom.
  const recent = rates.slice(-MARKED_YEARS);
  // Spread evenly across the right of the plot, ending just past the last
  // point. Fewer years than MARKED_YEARS means a shorter run, so the band
  // starts later and the labels stay near what they describe.
  const first = 1 - 0.13 * recent.length;
  const marks = recent.map((p, k) => {
    const i = rates.length - recent.length + k;
    const t = recent.length === 1 ? 1 : first + (1.02 - first) * (k / (recent.length - 1));
    return {
      x: xs[i], y: y(p.r), v: p.r, yr: String(p.y).slice(2),
      lx: CHART.w * t, ly: LABEL_ROWS[k % LABEL_ROWS.length],
    };
  });
  return {
    d, len: Math.ceil(len),
    last: { x: xs[xs.length - 1], y: y(rates[rates.length - 1].r) },
    grid: [10, 20, 30, 40].map((v) => ({ v, y: y(v) })),
    marks,
    span: `${rates[0].y}\u2013${rates[rates.length - 1].y}`,
  };
};
const CSC = 'https://csconfstats.xoveexu.com/conferences';
const DBLP = 'https://dblp.org/db/conf';
const BEST = 'https://jeffhuang.com/best_paper_awards/conferences.html';
// Two rounds at most. A venue with four open cycles was making its row
// twice the height of its neighbours, and the charts beside it then sat at
// a different level in every row. The rest stay in the "+N more" tooltip.
const MAX_ROUNDS = 2;

// Which rounds to print for a venue that runs more than we can show.
//
// Taking the first three stopped working once closed rounds were allowed to
// stay in the data. VLDB runs twelve, and its first three had all passed, so
// the cell showed three dead dates while the one you could still submit to
// sat in the overflow tooltip. Show the live ones, and fall back to the most
// recently closed only to fill the space, since knowing a round shut last
// week is useful and knowing one shut in May is not.
// Only the rounds still ahead. A closed call is not something anyone can
// submit to, and on a venue with four cycles the dead ones were most of the
// cell. If every round has closed the row falls back to the rolled estimate
// below, which is drawn as the estimate it is.
const roundWindow = (rounds) => {
  const live = (rounds || []).filter((r) => r.d >= TODAY);
  return live.slice(0, MAX_ROUNDS);
};

// The topic chart. Bars are the topics of the newest edition: width is the
// topic's share of submissions, height is its acceptance rate, so the area
// of a bar is the papers it accepted. A plain equal-width bar chart would
// have drawn learning theory, 410 submissions, the same size as frontier
// models at 1,903.
//
// The names are set the right way up, in rows across the empty space above
// the bars, each tied to its bar by a thin lead line. This is the same
// arrangement the venue charts use for their annotated years. Rotated
// labels fitted more characters, but a column of twenty-one of them asked
// the reader to tilt their head.
const TC = { w: 1400, base: 480, bar: 180, top: 12, left: 34, lab: 12.5 };
const TC_TOP = 50;              // the rate axis, in percent
const LAB_ROWS = 10;            // a label and the next one on its row are
                                // ten bars apart, which is the room each
                                // name gets before it has to be cut
const topicChart = (topics) => {
  const inner = TC.w - TC.left - 6;
  const gap = 2;
  const total = topics.reduce((a, t) => a + t.share, 0) || 100;
  let x = TC.left;
  const bars = topics.map((t) => {
    const w = Math.max((t.share / total) * (inner - gap * topics.length), 7);
    const h = (Math.min(t.rate, TC_TOP) / TC_TOP) * TC.bar;
    const bx = x;
    x += w + gap;
    return { ...t, x: bx, w, h, y: TC.base - h, cx: bx + w / 2 };
  });
  // Shade by rank rather than by value: the rates sit in a 17 point band,
  // so a scale keyed on the number would leave every bar the same colour.
  bars.forEach((b, i) => { b.tone = i < 4 ? 'a' : i < 9 ? 'b' : i < 15 ? 'c' : 'd'; });

  // The label rows fill the space between the top of the chart and the top
  // of the tallest bar. Row assignment cycles, so neighbouring bars send
  // their leads to different heights and the lines fan out instead of
  // piling up.
  const ceiling = Math.min(...bars.map((b) => b.y));
  const rowH = Math.max(14, (ceiling - TC.top - 10) / LAB_ROWS);
  // Each label starts above its own bar and runs right, up to where the
  // next label on the same row begins. The last pass of rows has no next
  // label and would otherwise be squeezed against the right edge, so those
  // labels are set right-aligned and grow leftwards into the space the row
  // still has.
  const CH = TC.lab * 0.5;                  // about one character of width
  const rowEnd = new Array(LAB_ROWS).fill(TC.left);
  bars.forEach((b, i) => {
    const row = i % LAB_ROWS;
    const next = bars[i + LAB_ROWS];
    const head = `${b.rate}%  `;
    const tail = `  ${b.n.toLocaleString()}`;
    b.ly = TC.top + 8 + row * rowH;
    b.head = head;
    b.tail = tail;
    let room;
    if (next) {
      b.anchor = 'start';
      b.lx = Math.max(b.x, rowEnd[row] + 10);
      room = next.x - b.lx - 10;
    } else {
      b.anchor = 'end';
      b.lx = TC.w - 2;
      room = b.lx - rowEnd[row] - 12;
    }
    const fits = Math.max(6, Math.floor(room / CH) - head.length - tail.length);
    b.name = b.area.length > fits
      ? b.area.slice(0, Math.max(1, fits - 1)).replace(/[ ,(]+$/, '') + '\u2026'
      : b.area;
    const width = (head.length + b.name.length + tail.length) * CH;
    rowEnd[row] = (b.anchor === 'start' ? b.lx : b.lx - width) + width;
  });
  return {
    bars,
    grid: [0, 10, 20, 30, 40, 50].map((v) => ({ v, y: TC.base - (v / TC_TOP) * TC.bar })),
  };
};

const RATE_CEIL = 100;   // a rate is read against 100, not against the table's max
const hiOf = () => RATE_CEIL;
const topicBlocks = Object.entries(topicRates).map(([venue, eds]) => {
  const now = eds[0];
  const prev = eds[1];
  const years = eds.map((e) => e.year).reverse();
  const rates = now.topics.map((t) => t.rate);
  const topShare = Math.max(...now.topics.map((t) => t.share), 1);
  const lo = 0;
  const hi = RATE_CEIL;
  return {
    venue, year: now.year, overall: now.overall, decided: now.decided,
    selected: (now.selected || []).map((x) => ({ ...x, pct: Math.min(x.rate / hiOf(now), 1) * 100 })),
    headline: now.headline, submitted: now.submitted,
    accepted: now.accepted, withdrawn: now.withdrawn,
    prevYear: prev ? prev.year : null, lo, hi,
    chart: topicChart(now.topics),
    rows: now.topics.map((t) => {
      const before = prev ? prev.topics.find((x) => x.area === t.area) : undefined;
      const d = (now_, then_) => (then_ === undefined ? null : Math.round((now_ - then_) * 10) / 10);
      // Two bars per row, each against its own scale and each saying what
      // it is measured against. The rate runs on the page's fixed ceiling,
      // the same one the venue bars use, so topics are comparable across
      // blocks. The share runs against the largest topic in this block,
      // because shares of one conference sum to a hundred and a fixed
      // scale would leave every bar a stub.
      return { ...t, delta: d(t.rate, before && before.rate),
               shareDelta: d(t.share, before && before.share),
               pct: ((t.rate - lo) / (hi - lo)) * 100,
               sharePct: (t.share / topShare) * 100 };
    }),
  };
});
// What a society meeting does with its abstracts. Three cases, because
// "no proceedings" and "opt-in proceedings" did not cover a meeting that
// publishes every abstract by default and nothing longer.
const PROC_TAG = { none: 'no proceedings', optin: 'opt-in proceedings', abstracts: 'abstract proceedings', full: 'full proceedings' };
const PROC_WHY = {
  none: 'not rankable, no archival proceedings',
  optin: 'not rankable, proceedings are opt-in and not peer reviewed',
  abstracts: 'not rankable, the proceedings are the abstracts themselves',
};
const CSR = 'https://csrankings.org/';
// Google Scholar Metrics has no API, so the h5-index itself is not pulled in.
// What is linkable is the category page, which is the field-native ranking.
// Every slug below was opened and confirmed to resolve. Society meetings get
// no link: they publish no papers, so Scholar Metrics does not index them.
const GSM = 'https://scholar.google.com/citations?view_op=top_venues&hl=en&vq=';
const TIER = { 1: 'Top', 2: 'Strong', 3: 'Listed' };

const coreLabel = { 'A*': 'A*', A: 'A', B: 'B', C: 'C', TBR: 'TBR', JP: 'jrnl', N: 'n/a' };
const coreClass = (c) => `core-${c === 'A*' ? 'as' : c.toLowerCase()}`;

// Acceptance rates are only as fresh as the upstream table; anything before
// this is shown with the year called out rather than quietly passed off as current.
const FRESH_FROM = 2024;

// One list, ordered by the date a reader can still act on.
//
// Not the first date in the file: by the time anyone reads this page some of
// those have passed. Within a venue the rule is the one a submitter actually
// follows. While a round's abstract deadline is open, that is the date that
// counts, because missing it shuts the round. Once it closes, the full paper
// date takes over. A venue with nothing ahead of it has finished its cycle,
// so it rolls a year forward and sorts to the end, out of the way of
// everything still live. The page is static and rebuilt weekly, so the same
// rule runs again in the browser against the reader's own today.
const ymd = (d) => d.toISOString().slice(0, 10);
const TODAY = ymd(new Date());
const rollYear = (iso) => {
  if (!iso) return '';
  const [y, m, d] = iso.split('-').map(Number);
  const nd = new Date(Date.UTC(y + 1, m - 1, d));
  if (nd.getUTCMonth() !== m - 1) nd.setUTCDate(0);   // Feb 29 lands on Feb 28
  return ymd(nd);
};
const roundsOf = (c) => (c.rounds && c.rounds.length
  ? c.rounds
  : c.nextDeadline ? [{ d: c.nextDeadline, abs: c.nextAbstract || '' }] : []);
// A commitment round is not a date you can submit new work to. The ARR
// venues run one submission deadline and then a commitment deadline months
// later, open only to papers that already have ARR reviews. Counting that as
// the venue's next deadline kept NAACL near the top of the table on a date
// nobody can act on. Only submission rounds decide whether a venue is still
// open; the commitment date stays on the page, it just does not sort.
const isSubmission = (r) => !/commitment/i.test(r.label || '');
const liveDate = (c) => {
  const rs = roundsOf(c);
  // Nothing on record is not the same as everything having passed. A society
  // meeting that publishes no call has no cycle to roll forward, so it sorts
  // last without an estimate it cannot support.
  if (!rs.length) return { key: '', expired: false };
  const subs = rs.filter(isSubmission);
  const pool = subs.length ? subs : rs;
  for (const r of pool) {
    if (r.abs && r.abs >= TODAY) return { key: r.abs, expired: false };
    if (r.d && r.d >= TODAY) return { key: r.d, expired: false };
  }
  return { key: rollYear(pool[0].d), expired: true };
};

// Society meetings are a different kind of thing and no longer share the
// table. A table's columns are acceptance rate, rank and deadline, and all
// three are blank for a meeting that reviews nothing and ranks nowhere, so
// the row said almost nothing while looking like it should. They are cards
// now, led by what the meeting is and why it matters, which is the part a
// visitor from another field actually needs.
// Grouped by field, then by date inside a field. Sorting the whole grid by
// date alone scattered the four neuroscience meetings across twenty-eight
// cards, and the field is the first thing on a card and the first thing a
// reader is filtering on.
const society = notable
  .map((c) => ({ ...c, society: true, live: liveDate(c) }))
  .sort((a, b) => (a.field || 'zz').localeCompare(b.field || 'zz')
    || (a.live.key || '9999').localeCompare(b.live.key || '9999'));
const all = ranked.map((c) => ({ ...c, live: liveDate(c) }));
// One date order, no buckets. A venue that has finished its cycle sinks on
// its own merits, because a date rolled a year forward is a year away. It
// does not need a separate block to put it there, and a block would split it
// from the venues whose next call is genuinely that far out anyway.
const dated = all.filter((c) => c.live.key).sort((a, b) => a.live.key.localeCompare(b.live.key));
const undated = all.filter((c) => !c.live.key).sort((a, b) => a.title.localeCompare(b.title));
const rows = [...dated, ...undated].map((c) => ({ ...c, chart: chart(c.rates), vol: volume(c.subs) }));

// Every venue, assembled per field. A table field gets rows with charts; a
// card field gets cards. Columns that would be empty for a whole field are
// left out of it rather than shown blank: most fields publish no acceptance
// rate, and only AI is ranked by CCF and CORE.
const jrows = journals.map((j) => ({ ...j, vol: volume(j.subs) }));
const cardsOf = (list) => list
  .map((c) => (c.live ? c : { ...c, live: liveDate(c) }))
  .sort((a, b) => (a.live.key || '9999').localeCompare(b.live.key || '9999') || a.title.localeCompare(b.title));
const socAll = society.map((c) => ({ ...c, chart: null, vol: null }));
const topicNow = Object.values(topicRates)[0]?.[0];
const topicVenue = Object.keys(topicRates)[0];
const domains = DOMAINS.map((d) => {
  const mine = [...rows, ...socAll].filter((c) => c.area === d.id);
  const tableRows = d.format === 'table' ? mine.sort((a, b) =>
    (a.live.key || '9999').localeCompare(b.live.key || '9999')) : [];
  const cards = d.format === 'cards' ? cardsOf(mine) : [];
  const js = jrows.filter((x) => x.area === d.id);
  const ranked_ = d.rank === 'ccf' || (d.rank === 'field' && tableRows.some((c) => c.frank || c.ccf !== 'N' || c.core !== 'N'));
  // The security calendar: every round of every Big Four venue over the
  // next twelve months, because in security the question is which cycle
  // comes next, not which venue.
  let cycles = null;
  if (d.cycles) {
    const start = new Date(); start.setUTCDate(1);
    const months = Array.from({ length: 12 }, (_, k) => {
      const m = new Date(Date.UTC(start.getUTCFullYear(), start.getUTCMonth() + k, 1));
      return { key: m.toISOString().slice(0, 7), label: m.toLocaleString('en-US', { month: 'short', timeZone: 'UTC' }), yr: m.getUTCMonth() === 0 || k === 0 ? String(m.getUTCFullYear()) : '' };
    });
    const until = months[11].key;
    cycles = {
      months,
      venues: tableRows.filter((c) => c.frank).map((c) => {
        const fromRounds = (c.rounds || []).filter((r) => r.d >= TODAY).map((r) => ({ d: r.d, label: r.label || '', est: !!r.est }));
        const all_ = fromRounds.length ? fromRounds : (c.live.key ? [{ d: c.live.key, label: 'next cycle', est: true }] : []);
        return { title: c.title, dates: all_.filter((r) => r.d.slice(0, 7) <= until) };
      }),
    };
  }
  let topic = null;
  if (d.topic && topicNow) {
    const t = topicNow.topics.find((x) => x.area.toLowerCase().includes(d.topic));
    if (t) topic = { venue: topicVenue, year: topicNow.year, rate: t.rate, n: t.n, area: t.area, overall: topicNow.headline };
  }
  return {
    ...d,
    tableRows, cards, journals: js,
    hasRate: tableRows.some((c) => c.rates.length),
    hasSubs: tableRows.some((c) => c.vol),
    rankCol: ranked_,
    jRank: d.rank === 'ccf' || js.some((x) => x.rank || (d.rank === 'field' && x.ccf !== 'N')),
    n: mine.length + js.length,
    cycles, topic,
    trend: (() => {
      const t = trends.fields[d.id];
      if (!t || !t.rows.length) return null;
      const max = Math.max(...t.rows.map((r) => r.n));
      return { ...t, rows: t.rows.map((r) => ({ ...r, pct: (r.n / max) * 100 })) };
    })(),
    scholarUrl: d.scholar ? GSM + d.scholar : '',
  };
});
const groupOf = Object.fromEntries(DOMAINS.map((d) => [d.id, d.group]));
const totalRated = rows.filter((c) => c.rates.length).length;
const freshRated = rows.filter((c) => c.rates.length && c.rates[c.rates.length - 1].y >= FRESH_FROM).length;

---
<Layout title="Conferences | Zhiqian Chen">
  <main class="container">
    <Nav current="conferences" />

    <section class="head">
      {/* Every field at once, as a directory: a small caption per group and
          its fields after it, groups kept whole on a line and divided by a
          hairline. No tabs to open, and the grouping reads from the caption. */}
      <div class="picker">
        <nav class="dir" aria-label="Field">
          {GROUPS.map((g) => (
            <div class="dir-group">
              <span class="dir-label">{g.label}</span>
              <span class="dir-chips">
              {domains.filter((d) => d.group === g.id).map((d) => (
                <button class={`dchip${d.id === DEFAULT ? ' is-on' : ''}`} data-area={d.id} type="button"
                        data-scholar={d.scholarUrl} style={`--hue:${d.hue}`}>
                  <i class={`fas ${d.icon}`} aria-hidden="true"></i>{d.label}<span class="fcount">{d.n}</span>
                </button>
              ))}
              </span>
            </div>
          ))}
        </nav>
        <div class="side">
          <button class="fbtn fbtn-dest" data-area="destinations" type="button">
            <i class="fas fa-plane-departure" aria-hidden="true"></i>Selected destination<span class="fcount">{destinations.items.length}</span>
          </button>
          <a class="scholar-link" id="scholar-link" href={domains[0].scholarUrl} target="_blank" rel="noopener"
             title="This field's h5-index ranking on Google Scholar Metrics, journals and conferences together">
            h5-index <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
          </a>
        </div>
      </div>
      {/* The legend is a reference, not a thing to read first, so it sits
          behind the button and comes out on hover or on focus. Focus matters:
          hover alone would put it out of reach of a keyboard and of a phone,
          where the button's own tap opens it. */}
      <div class="legend-wrap" id="legend">
        <button type="button" class="legend-btn" aria-expanded="false" aria-controls="legend-list">
          <i class="fas fa-circle-info" aria-hidden="true"></i>What the tags mean
        </button>
        <ul class="legend" id="legend-list">
          <li><span class="chip band-urgent"></span>&lt;30d</li>
          <li><span class="chip band-soon"></span>30&ndash;90</li>
          <li><span class="chip band-far"></span>90+</li>
          <li><span class="rounds-tag">2&times;</span>cycles / year</li>
          <li><span class="est-tag">est.<i class="fas fa-circle-question" aria-hidden="true"></i></span>estimated from last year</li>
          <li><span class="abs-line"><b>abstract</b></span>abstract due before the paper</li>
        </ul>
      </div>
    </section>


    <section class="section dest-section" id="destinations" hidden>
      <div class="dest-pick">
        {destinations.places.map((d, i) => (
          <button class={`dbtn${i === 0 ? ' is-on' : ''}`} data-dest={d.name} type="button">
            <i class={`fas fa-${d.icon}`} aria-hidden="true"></i>{d.name}<span class="fcount">{d.n}</span>
          </button>
        ))}
      </div>
      <div class="table-wrap">
        <table class="confs dest-table">
          <thead>
            <tr>
              <th class="c-name">Conference</th>
              <th class="c-date">Deadline</th>
              <th class="c-when">When and where</th>
              <th class="c-rank" title="The strongest credential each venue has: the field's own standing first, then CCF and CORE where they exist">Standing</th>
            </tr>
          </thead>
          <tbody>
            {destinations.items.map((it) => (
              <tr data-dest={it.dest} data-place={it.q} hidden>
                <td class="c-name">
                  <span class="name-line">
                    <a class="conf-name" href={it.link} target="_blank" rel="noopener">{it.title}</a>
                    <span class="ed-ord">{it.year}</span>
                  </span>
                  <span class="conf-desc">{it.desc}</span>
                  {it.field && it.field !== 'AI · ML · Data Mining' && <span class="dest-field">{it.field}</span>}
                </td>
                <td class="c-date" data-label="Deadline">
                  <span class="dl">{it.deadline || 'not published'}</span>
                  {it.deadline && <span class={it.open ? 'dl-days' : 'dl-days band-past'} data-deadline={it.open ? it.deadline : ''}>{it.open ? '' : 'closed'}</span>}
                </td>
                <td class="c-when" data-label="When and where">
                  <span class="when">{it.date}</span>
                  <span class="where">{it.place}</span>
                </td>
                <td class="c-rank" data-label="Standing">
                  {it.honors.length
                    ? <span class="ranks">{it.honors.map((h) => <span class={`pill ${h.k === 'field' ? 'honor' : h.k}`}>{h.t}</span>)}</span>
                    : <span class="none">&mdash;</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="dest-none" hidden>Nothing announced there yet.</p>
      <p class="area-note">
        {destinations.items.length} upcoming editions across {destinations.places.length} destinations, each one a
        place rather than a category, so cities, countries and regions sit side by side. The computing venues are those at
        CCF A or B or CORE A* or A; every hand-kept venue from the field tabs is here too, along with a few chosen for the trip.
        Standing gives each venue's strongest credential first: the field's own (a society flagship, the Big Four), then CCF
        and CORE where they rank it. A call marked open still has a deadline ahead of today.
      </p>
    </section>

    {domains.map((d) => (
      <section class={`dom dom-${d.format}`} data-domain={d.id} hidden={d.id !== DEFAULT} style={`--hue:${d.hue}`}>
        <div class="section field-note">
          <h2 class="fn-head">How {d.label} publishes</h2>
          <ul>{d.notes.map((l) => <li>{l}</li>)}</ul>
        </div>

        {/* What the field is publishing most. Papers, not acceptance rates,
            because every field has the first and almost none the second. */}
        {d.trend && (
          <div class="section trends">
            <h2 class="kind-head">Most published topics, {trends.year}</h2>
            <ol class="trend-list" data-field={d.id}>
              {d.trend.rows.map((r) => (
                <li data-kw={r.id} data-label={r.label}>
                  <button type="button" class="tr-name" title={r.papers ? `The ${r.papers} most representative recent papers on ${r.label}` : r.label}
                          disabled={!r.papers}>{r.label}</button>
                  <span class="tr-bar"><span style={`width:${r.pct.toFixed(1)}%`}></span></span>
                  <span class="tr-n">{r.n.toLocaleString()}</span>
                  <span class={`tr-g ${r.growth === null ? 'is-new' : r.growth >= 15 ? 'is-up' : r.growth <= -15 ? 'is-down' : ''}`}
                        title={r.growth === null ? `Not among this field's topics in ${trends.base}` : `Share of the field's papers, ${trends.base} to ${trends.year}`}>
                    {r.growth === null ? 'new'
                      : r.growth >= 100 ? `\u00d7${(1 + r.growth / 100).toFixed(r.growth >= 900 ? 0 : 1)}`
                      : `${r.growth > 0 ? '+' : ''}${r.growth}%`}
                  </span>
                </li>
              ))}
            </ol>
            <div class="tr-papers" hidden>
              <div class="trp-head">
                <b class="trp-title"></b>
                <span class="trp-sub">ranked on citations, venue standing and author standing together</span>
                <a class="trp-oa" target="_blank" rel="noopener">all on OpenAlex <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
                <button type="button" class="trp-x" aria-label="Close">&times;</button>
              </div>
              <ol class="trp-list"></ol>
            </div>
            <p class="area-note trends-note">
              Click a keyword for its ten most representative papers since {trends.year - 1}.
              {d.trend.total.toLocaleString()} papers in {trends.year}
              {d.trend.confs.length > 0
                ? <>from {d.trend.confs.join(', ')} and the {d.trend.journals} journals listed below</>
                : <>across the {d.trend.journals} journals listed below</>}, grouped by the keywords OpenAlex assigns them.
              {d.trend.missing.length > 0 && ` ${d.trend.missing.join(' and ')} ${d.trend.missing.length > 1 ? 'are' : 'is'} not indexed there, so ${d.trend.missing.length > 1 ? 'they are' : 'it is'} not counted.`}
              The figure on the right is the change in each keyword's share of those papers since {trends.base}; &times;3 means three times the share.
            </p>
          </div>
        )}

        {d.cycles && (
          <div class="section cycles">
            <h2 class="kind-head">The next twelve months of cycles</h2>
            <div class="cyc-grid" style={`--n:${d.cycles.months.length}`}>
              <span></span>
              {d.cycles.months.map((m) => <span class="cyc-m"><span class="m-full">{m.label}</span><span class="m-short">{m.label[0]}</span>{m.yr && <em>{m.yr}</em>}</span>)}
              {d.cycles.venues.map((v) => (
                <>
                  <span class="cyc-v">{v.title}</span>
                  {d.cycles.months.map((m) => {
                    const hits = v.dates.filter((r) => r.d.slice(0, 7) === m.key);
                    return (
                      <span class="cyc-cell">
                        {hits.map((r) => (
                          <span class={`cyc-dot${r.est ? ' is-est' : ''}`} title={`${v.title} ${r.d}${r.label ? ', ' + r.label : ''}${r.est ? ' (estimated)' : ''}`}>{Number(r.d.slice(8, 10))}</span>
                        ))}
                      </span>
                    );
                  })}
                </>
              ))}
            </div>
            <p class="area-note">Each mark is a paper deadline, numbered by its day. Hollow marks are estimates rolled from last year.</p>
          </div>
        )}

        {d.topic && (
          <div class="section ts-stat">
            <h2 class="kind-head">Inside the ML conferences</h2>
            <p class="ts-line">
              <b>{d.topic.rate}%</b> of {d.topic.n.toLocaleString()} {d.topic.venue} {d.topic.year} submissions on
              &ldquo;{d.topic.area}&rdquo; were accepted, against {d.topic.overall}% overall.
              That is where most time-series methods papers go; the AI tab has the full chart.
            </p>
          </div>
        )}

        {d.format === 'table' ? (
          <div class="section">
            <h2 class="kind-head">Conferences</h2>
