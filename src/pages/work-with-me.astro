---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

const tracks = [
  {
    title: 'Ph.D.',
    body: [
      'Apply to the Department of Computer Science, Golisano College of Computing and Information Sciences at Rochester Institute of Technology, if you wish to work with me. If you are already at RIT, feel free to email me, schedule a meeting, or stop by my office.',
      'It helps a great deal if you have at least one solid research experience behind you, ideally a first-author paper at a top AI venue, or an equivalent publication in your own field. I receive many inquiries, so I may not be able to reply to each one individually, and I appreciate your understanding.',
    ],
  },
  {
    title: 'Research Intern',
    body: [
      'Unpaid research internships are open both in person at RIT and remotely. Openings come up throughout the year, sometimes on a monthly basis, and are filled case by case. Send your CV with a short note on what you would like to work on, and I will keep you in mind for the next suitable project. High school students are welcome to apply as well.',
    ],
  },
];
---
<Layout title="Work With Me | Zhiqian Chen">
  <main class="container">
    <Nav />

    <section class="hero">
      <h1>For Prospective Students</h1>
      <p class="lead">
        Please send your CV and transcript to
        <a href="mailto:zhiqian.chen@rit.edu">zhiqian DOT chen AT rit DOT edu</a>
        or
        <a href="mailto:chen.zhiqian.work@gmail.com">chen DOT zhiqian DOT work AT gmail DOT com</a>.
      </p>
      <p class="contact">I currently take Ph.D. students and research interns.</p>
    </section>

    <section class="section">
      <h2>Tracks</h2>
      <div class="tracks">
        {tracks.map((t) => (
          <article class="track">
            <h3>{t.title}</h3>
            {t.body.map((para) => <p>{para}</p>)}
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
<style>
  :root { --accent:#2563eb; --ink:#0f172a; --muted:#475569; }
  .container { max-width: min(95vw, 1600px); margin: 0 auto; padding: 20px; box-sizing: border-box; }

  .hero { margin: 10px 0 28px; }
  .hero h1 { font-family:'Montserrat',sans-serif; font-size:2rem; margin:0 0 8px; color:var(--ink); }
  .hero .lead { margin: 0 0 6px; color:#334155; font-size:1rem; }
  .hero .contact { margin: 0; color:var(--muted); font-size:.92rem; }
  .hero .lead a, .hero .contact a { color: var(--accent); text-decoration: none; }
  .hero .contact a:hover { text-decoration: underline; }

  .section { padding-top: 6px; margin-top: 22px; }
  .section h2 { font-family:'Montserrat',sans-serif; font-size:.82rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:var(--accent); margin: 0 0 12px; }
  .section > p { color:#334155; font-size:.95rem; line-height:1.55; margin: 0 0 10px; max-width: 80ch; }

  .tracks { display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 14px; }
  .track { background:#fafbfc; padding:16px 18px; }
  .track h3 { font-family:'Montserrat',sans-serif; font-size:1.02rem; margin:0 0 8px; color:var(--ink); }
  .track p:last-child { margin-bottom:0; }
  .track p { text-align:left; margin:0 0 8px; color:#334155; font-size:.92rem; line-height:1.55; }


  @media (max-width: 720px) {
    .tracks { grid-template-columns: 1fr; }
  }
</style>
