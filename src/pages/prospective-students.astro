---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

const tracks = [
  {
    title: 'Ph.D.',
    body: [
      'Apply to the Department of Computer Science, Golisano College of Computing and Information Sciences at Rochester Institute of Technology, if you wish to work with me. If you are already at RIT, feel free to email me, schedule a meeting, or stop by my office.',
      'It helps a great deal if you have at least one solid research experience behind you, ideally a first-author paper at a top AI venue, or an equivalent publication in your own field. I receive many inquiries, so I may not be able to reply to each one individually, and I appreciate your understanding.',
    ],
  },
  {
    title: 'Research Intern',
    body: [
      'Both remote and in-person interns are welcome. Openings come up throughout the year, sometimes on a monthly basis, and are filled case by case. Send your CV with a short note on what you would like to work on, and I will keep you in mind for the next suitable project. High school students are welcome to apply as well.',
    ],
  },
  {
    title: 'Capstone and Independent Study',
    body: [
      'If your degree program requires a capstone project, or you would like to do an independent study for credit, I am open to supervising projects in my research areas. Reach out early in the semester before you plan to start, with a short note on your program and the kind of project you have in mind.',
    ],
  },
];
---
<Layout title="Prospective Students | Zhiqian Chen">
  <main class="container">
    <Nav current="students" />

    <section class="hero">
      <h1>Prospective Students</h1>
      <p class="lead">
        Please send your CV and transcript to
        <a href="mailto:zhiqian.chen@rit.edu">zhiqian DOT chen AT rit DOT edu</a>
        or
        <a href="mailto:chen.zhiqian.work@gmail.com">chen DOT zhiqian DOT work AT gmail DOT com</a>.
      </p>
      <p class="contact">I currently take Ph.D. students, research interns, and capstone or independent study students.</p>
    </section>

    <section class="section">
      <h2>Basic requirements</h2>
      <ul class="reqs">
        <li>A background in engineering, computer science, mathematics or a related field</li>
        <li>Solid coding skills</li>
        <li>Solid mathematics</li>
        <li>Genuine passion and motivation for research</li>
      </ul>
    </section>

    <section class="section">
      <h2>Tracks</h2>
      <div class="tracks">
        {tracks.map((t) => (
          <article class="track">
            <h3>{t.title}</h3>
            {t.body.map((para) => <p>{para}</p>)}
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
<style>
  :root { --accent:#C45200; --ink:#16202B; --muted:#4E5C6A; }
  .container { max-width: min(95vw, 1600px); margin: 0 auto; padding: 20px; box-sizing: border-box; }

  .hero { margin: 10px 0 28px; }
  .hero h1 { font-family:'et-book',Palatino,serif; font-size:2rem; margin:0 0 8px; color:var(--ink); }
  .hero .lead { margin: 0 0 6px; color:#2E3A47; font-size:1rem; }
  .hero .contact { margin: 0; color:var(--muted); font-size:.92rem; }
  .hero .lead a, .hero .contact a { color: var(--accent); text-decoration: none; }
  .hero .contact a:hover { text-decoration: underline; }

  .section { padding-top: 6px; margin-top: 22px; }
  .section h2 { font-family:'et-book',Palatino,serif; font-size:.82rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:var(--accent); margin: 0 0 12px; }
  .section > p { color:#2E3A47; font-size:.95rem; line-height:1.55; margin: 0 0 10px; max-width: 80ch; }

  .reqs { margin:0; padding-left:20px; color:#2E3A47; font-size:.95rem; line-height:1.7; text-align:left; }
  .tracks { display:grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 14px; }
  .track { background:#EEF3F8; padding:16px 18px; }
  .track h3 { font-family:'et-book',Palatino,serif; font-size:1.02rem; margin:0 0 8px; color:var(--ink); }
  .track p:last-child { margin-bottom:0; }
  .track p { text-align:left; margin:0 0 8px; color:#2E3A47; font-size:.92rem; line-height:1.55; }


  @media (max-width: 1000px) {
    .tracks { grid-template-columns: 1fr; }
  }
</style>
