  .when { display:inline; }
  .where { display:flex; align-items:center; gap:5px; color:#94a3b8; }
  .ed-line .when { display:inline; }
  .where .fi { flex:0 0 auto; border-radius:2px; box-shadow:0 0 0 1px rgba(15,23,42,.08); }

  .c-rate { width:30%; }
  /* The chart fills the column it was given. At a fixed 214px it left a third
     of the cell empty, which is the gap that made this table look padded.
     preserveAspectRatio:none lets it stretch horizontally only, so the line
     keeps its height while the years spread out and become readable. Strokes
     and text are vector-effect'd back to a constant width, otherwise the
     stretch would smear them. */
  .spark { display:block; width:100%; max-width:420px; height:auto; overflow:visible; color:#1d4ed8; }
  .spark .grid { stroke:rgba(148,163,184,.35); stroke-width:.6; stroke-dasharray:2 2; }
  .spark .glab { font-size:6px; fill:#94a3b8; }
  .spark .line { fill:none; stroke:currentColor; stroke-width:1.4; stroke-linejoin:round; stroke-linecap:round; }
  .spark .dot, .spark .dot-end { fill:currentColor; }
  /* The line draws itself left to right with a dot at the leading edge, then
     rests on the finished chart before starting over. Staggered so a screen
     full of them does not pulse in unison. */
  .spark .line {
    stroke-dasharray: var(--len); stroke-dashoffset: var(--len);
    animation: spark-draw 7s ease-in-out var(--delay, 0s) infinite;
  }
  .anim-off .spark .line,
  .anim-off .spark .dot,
  .anim-off .spark .dot-end { animation-play-state: paused; }
  .spark .dot {
    offset-rotate: 0deg; opacity: 0;
    animation: spark-ride 7s ease-in-out var(--delay, 0s) infinite;
  }
  .spark .dot-end { opacity: 0; animation: spark-rest 7s ease-in-out var(--delay, 0s) infinite; }
  @keyframes spark-draw {
    0%   { stroke-dashoffset: var(--len); }
    45%  { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 0; }
  }
  @keyframes spark-ride {
    0%   { offset-distance: 0%;   opacity: 0; }
    4%   { opacity: 1; }
    45%  { offset-distance: 100%; opacity: 1; }
    52%  { offset-distance: 100%; opacity: 0; }
    100% { offset-distance: 100%; opacity: 0; }
  }
  @keyframes spark-rest {
    0%, 45% { opacity: 0; }
    52%, 100% { opacity: 1; }
