---
import Layout from '../layouts/Layout.astro';
import { deadlines, kindLabels, openCalls } from '../data/deadlines.js';

const DOW = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
const SHORT_MONTH = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

// Weekday placement is computed, not transcribed, so the grid cannot drift from
// the dates in the list beneath it.
const buildWeeks = (mo) => {
  const lead = new Date(Date.UTC(mo.y, mo.m, 1)).getUTCDay();
  const length = new Date(Date.UTC(mo.y, mo.m + 1, 0)).getUTCDate();
  const byDay = new Map();
  mo.items.forEach((i) => byDay.set(i.d, [...(byDay.get(i.d) ?? []), i]));
  const cells = Array.from({ length: lead }, () => null);
  for (let d = 1; d <= length; d += 1) cells.push({ d, items: byDay.get(d) ?? [] });
  while (cells.length % 7 !== 0) cells.push(null);
  return Array.from({ length: cells.length / 7 }, (_, w) => cells.slice(w * 7, w * 7 + 7));
};

const labelFor = (mo, item) => `${SHORT_MONTH[mo.m]} ${item.d}`;
const dayName = (mo, d) => ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][new Date(Date.UTC(mo.y, mo.m, d)).getUTCDay()];
---
<Layout title="Agenda | Zhiqian Chen">
  <main class="container">
    <nav class="top-nav" aria-label="Sections">
      <a href="/">Home</a>
      <a href="/research">Research</a>
      <a href="/agenda" aria-current="page">Agenda</a>
      <a href="/people">People</a>
      <a href="/teach">Teach</a>
      <a href="https://scholar.google.com/citations?user=NC3-O6UAAAAJ&hl=en&oi=ao" target="_blank" rel="noopener">Paper <i class="ai ai-google-scholar-square ai-sm nav-ghost"></i> <i class="fas fa-arrow-up-right-from-square nav-ghost"></i></a>
      <a href="https://substack.com/@zhiqianchen1" target="_blank" rel="noopener">Zhiqian's Note <svg class="nav-ghost nav-substack" viewBox="0 0 24 24" fill="currentColor" width="11" height="11" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg> <i class="fas fa-arrow-up-right-from-square nav-ghost"></i></a>
    </nav>

    <section class="section" id="deadlines">
      <ul class="legend">
        <li class="legend-action">
          <a class="ics-link" href="/research-calendar.ics" download>
            <i class="fas fa-download" aria-hidden="true"></i>
            Download .ics
          </a>
        </li>
        {Object.entries(kindLabels).map(([k, label]) => (
          <li><span class={`dot dot-${k}`} aria-hidden="true"></span>{label}</li>
        ))}
        <li><span class="dot dot-est" aria-hidden="true"></span>Estimated date</li>
      </ul>

      <div class="cals">
        {deadlines.map((mo) => (
          <section class="cal">
            <h3>{mo.month}</h3>
            <div class="cal-dow" aria-hidden="true">
              {DOW.map((d) => <span>{d}</span>)}
            </div>
            {buildWeeks(mo).map((week) => (
              <div class="cal-week">
                {week.map((cell) => (
                  cell === null
                    ? <span class="cal-cell is-blank"></span>
                    : <span
                        class={`cal-cell${cell.items.length ? ' is-due' : ''}`}
                        data-today={`${mo.y}-${mo.m}-${cell.d}`}
                        data-key={cell.items.length ? `${mo.y}-${mo.m}-${cell.d}` : undefined}
                      >
                        <span class="cal-num">{cell.d}</span>
                        {cell.items.length > 0 && (
                          <span class="cal-dots">
                            {cell.items.map((i) => <span class={`dot dot-${i.kind}${i.est ? ' is-est' : ''}`}></span>)}
                          </span>
                        )}
                        {cell.items.length > 0 && (
                          <span class="cal-pop" role="tooltip">
                            <span class="cal-pop-head">{labelFor(mo, cell)} · {dayName(mo, cell.d)}</span>
                            {cell.items.map((i) => (
                              <span class="cal-pop-item">
                                <span class={`dot dot-${i.kind}${i.est ? ' is-est' : ''}`}></span>
                                <span>{i.name}{i.est && <span class="est-flag">est.</span>}</span>
                              </span>
                            ))}
                          </span>
                        )}
                      </span>
                ))}
              </div>
            ))}
          </section>
        ))}
      </div>

      <div class="months">
        {deadlines.map((mo) => (
          <section class="month">
            <h3>{mo.month}</h3>
            <ul class="deadline-list">
              {mo.items.map((d) => (
                <li class={`deadline kind-${d.kind}${d.est ? ' is-est' : ''}`} data-key={`${mo.y}-${mo.m}-${d.d}`}>
                  <span class="deadline-date">{labelFor(mo, d)}</span>
                  <span class="deadline-name"><span class={`dot dot-${d.kind}${d.est ? ' is-est' : ''}`} aria-hidden="true"></span>{d.name}{d.est && <span class="est-flag">est.</span>}</span>
                  <span class="deadline-left" data-countdown></span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <div class="cards three open-calls" id="open-calls">
        <article class="card past-card" id="past-card" hidden>
          <h3>Already passed</h3>
          <ul class="topics" id="past-list"></ul>
        </article>
        {openCalls.map((c) => (
          <article class="card">
            <h3>{c.heading}</h3>
            <ul class="topics">
              {c.items.map((i) => <li>{i}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <p class="fineprint">Verify each against its own solicitation. A date on a weekend or federal holiday shifts to the next business day; NIH resubmissions run one month later (Mar / Jul / Nov).</p>
    </section>
  </main>

  <script>
    // A calendar cell and its list rows carry the same data-key, so hovering
    // either side can light up the other without knowing anything about dates.
    const setLinked = (key, on) => {
      document.querySelectorAll(`[data-key="${key}"]`).forEach((el) => el.classList.toggle('is-linked', on));
    };
    document.querySelectorAll('[data-key]').forEach((el) => {
      const key = el.getAttribute('data-key');
      if (!key) return;
      el.addEventListener('mouseenter', () => setLinked(key, true));
      el.addEventListener('mouseleave', () => setLinked(key, false));
    });

    // Days remaining, counted from the viewer's own today. Both endpoints go
    // through Date.UTC so a DST boundary in between cannot cost or add a day.
    // The band drives the pill colour: under 30 days, 30-60, 60-90, and beyond.
    const now = new Date();
    const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
    const pastItems = [];
    document.querySelectorAll('.deadline[data-key]').forEach((row) => {
      const slot = row.querySelector('[data-countdown]');
      if (!slot) return;
      const [y, m, d] = row.getAttribute('data-key').split('-').map(Number);
      const days = Math.round((Date.UTC(y, m, d) - today) / 86400000);

      if (days < 0) {
        // Gone by: out of the month lists and off the grid, into one box at the
        // foot of the page, so the board only ever shows what is still ahead.
        pastItems.push({
          label: row.querySelector('.deadline-date').textContent.trim(),
          name: row.querySelector('.deadline-name').textContent.trim(),
          dotClass: row.querySelector('.deadline-name .dot')?.className ?? 'dot',
          days: -days,
        });
        row.hidden = true;
        return;
      }

      let band = 'far';
      if (days < 30) band = 'urgent';
      else if (days < 60) band = 'soon';
      else if (days < 90) band = 'later';
      slot.classList.add(`band-${band}`);
      slot.textContent = days === 0 ? 'today' : `${days}d`;
      slot.title = days === 0 ? 'due today' : `${days} days from today`;
    });

    // Strip the marking from days that have gone by, and mark today.
    document.querySelectorAll('.cal-cell[data-key]').forEach((cell) => {
      const [y, m, d] = cell.getAttribute('data-key').split('-').map(Number);
      if (Date.UTC(y, m, d) < today) {
        cell.classList.remove('is-due');
        cell.classList.add('is-gone');
        cell.removeAttribute('data-key');
      }
    });
    const todayCell = document.querySelector(
      `.cal-cell[data-today="${now.getFullYear()}-${now.getMonth()}-${now.getDate()}"]`,
    );
    if (todayCell) todayCell.classList.add('is-today');

    // A month whose rows have all gone by has nothing left to show.
    document.querySelectorAll('.month').forEach((month) => {
      const visible = [...month.querySelectorAll('.deadline')].some((row) => !row.hidden);
      if (!visible) month.hidden = true;
    });

    if (pastItems.length) {
      const list = document.getElementById('past-list');
      pastItems.forEach((item) => {
        const li = document.createElement('li');
        li.className = 'past-item';
        li.innerHTML = `<span class="${item.dotClass}"></span><span class="past-when">${item.label}</span><span>${item.name}</span>`;
        list.appendChild(li);
      });
      document.getElementById('past-card').hidden = false;
      document.getElementById('open-calls').classList.add('has-past');
    }
  </script>
</Layout>
<style>
  :root { --accent:#2563eb; --ink:#0f172a; --muted:#475569; }
  .container { max-width: min(95vw, 1600px); margin: 0 auto; padding: 20px; box-sizing: border-box; }
  .top-nav { margin-bottom: 14px; padding: 10px 0 14px; display:flex; flex-wrap:wrap; gap:8px; align-items:center; background:transparent; border:none; border-bottom:none; border-radius:0; box-shadow:none; }
  .top-nav a { text-decoration:none; color:var(--ink); font-family:'Montserrat',sans-serif; font-size:.9rem; padding:7px 10px; border-radius:999px; background:transparent; }
  .top-nav a:hover { background: #f1f5f9; color: #0f172a; }
  .top-nav a[aria-current="page"] { background: #e2e8f0; color: #0f172a; box-shadow: inset 0 1px 2px rgba(15,23,42,0.10); }
  .nav-ghost { font-size:.78rem; margin-left:4px; opacity:.85; }
  .nav-substack { vertical-align: -1px; opacity: .85; }

  .section { margin-top:6px; }

  .legend { list-style:none; margin:0 0 12px; padding:0; display:flex; flex-wrap:wrap; gap:14px; font-size:.8rem; color:#475569; }
  .legend li { display:inline-flex; align-items:center; gap:6px; }
  .legend-action { margin-right:auto; }
  .ics-link { display:inline-flex; align-items:center; gap:6px; padding:4px 11px; border:1px solid rgba(148,163,184,.35); border-radius:999px; background:#fff; color:var(--accent); font-weight:600; font-size:.78rem; text-decoration:none; transition:background .15s ease, border-color .15s ease; }
  .ics-link:hover { background:#eff6ff; border-color:rgba(37,99,235,.45); }
  .dot { width:9px; height:9px; border-radius:50%; display:inline-block; flex:none; }
  .dot-nsf { background:#2563eb; }
  .dot-nih { background:#0f766e; }
  .dot-other { background:#9d174d; }
  .dot-paper { background:#b45309; }
  .dot-review { background:#6d28d9; }
  .dot-est { background:transparent; border:1px dashed #94a3b8; }

  /* Three across on a page of its own, so each month gets roughly twice the
     width it had as a section inside Research. */
  .cals { display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:16px; margin-bottom:16px; }
  /* A hairline dashed frame separates the months without tinting anything. */
  .cal { padding:8px 8px 6px; border:1px dashed rgba(148,163,184,.42); border-radius:12px; }
  .cal h3 { font-family:'Montserrat',sans-serif; font-size:.76rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:#334155; margin:0 0 5px; text-align:center; }
  .cal-dow, .cal-week { display:grid; grid-template-columns:repeat(7, 1fr); gap:2px; }
  .cal-dow span { text-align:center; font-size:.64rem; font-weight:700; color:#94a3b8; padding-bottom:2px; }
  /* Squat cells: the point is to get the grids and the list onto one screen. */
  .cal-cell { position:relative; aspect-ratio:2.45; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1px; border-radius:5px; }
  .cal-cell.is-blank { visibility:hidden; }
  .cal-num { font-size:.74rem; color:#64748b; font-variant-numeric:tabular-nums; line-height:1; }
  .cal-cell.is-due { background:#e2e8f0; }
  .cal-cell.is-due .cal-num { font-weight:700; color:#0f172a; }
  .cal-dots { display:flex; gap:2px; }
  .cal-dots .dot { width:4px; height:4px; }
  /* Set by the script once it knows the viewer's today. */
  .cal-cell.is-today { box-shadow:inset 0 0 0 2px #b91c1c; }
  .cal-cell.is-today .cal-num { color:#b91c1c; font-weight:700; }
  .cal-cell.is-gone .cal-dots { display:none; }
  .cal-cell.is-gone .cal-num { color:#cbd5e1; }

  /* Detail panel, CSS-only so it needs no scripting and cannot drift. */
  .cal-pop { display:none; position:absolute; top:calc(100% + 5px); left:50%; transform:translateX(-50%); z-index:30; width:max-content; max-width:260px; padding:8px 10px; border-radius:10px; background:#0f172a; color:#e2e8f0; font-size:.74rem; line-height:1.35; text-align:left; box-shadow:0 12px 28px rgba(15,23,42,.28); }
  .cal-cell.is-due:hover .cal-pop { display:block; }
  .cal-cell.is-gone:hover .cal-pop { display:none; }
  .cal-pop-head { display:block; font-weight:700; color:#fff; margin-bottom:4px; }
  .cal-pop-item { display:flex; align-items:baseline; gap:6px; }
  .cal-pop-item + .cal-pop-item { margin-top:3px; }
  .cal-pop-item .dot { flex:none; transform:translateY(-1px); }
  .cal-pop .est-flag { border-color:#475569; color:#94a3b8; }

  .months { columns:4; column-gap:18px; }
  .month { break-inside:auto; margin-bottom:11px; }
  .month h3 { font-family:'Montserrat',sans-serif; font-size:.78rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#64748b; margin:0 0 7px; padding-bottom:4px; border-bottom:1px solid rgba(148,163,184,.2); break-after:avoid; }
  .deadline-list { list-style:none; margin:0; padding:0; display:grid; gap:3px; }
  /* No colour bar down the left edge — the category rides on a dot beside the
     name, and the right-hand pill carries the urgency. */
  .deadline { display:grid; grid-template-columns:52px minmax(0,1fr) auto; gap:8px; align-items:baseline; padding:3px 8px; border-radius:6px; background:#f8fafc; break-inside:avoid; }
  .deadline-date { font-size:.76rem; font-weight:700; color:#0f172a; font-variant-numeric:tabular-nums; }
  .deadline-name { font-size:.82rem; color:#334155; line-height:1.35; }
  .deadline-name .dot { margin-right:6px; transform:translateY(-1px); }
  .est-flag { margin-left:6px; font-size:.68rem; color:#94a3b8; border:1px dashed #cbd5e1; border-radius:4px; padding:0 4px; }

  /* White on a solid band, so the countdown is the loudest thing in the row. */
  .deadline-left { min-width:34px; text-align:center; padding:2px 6px; border-radius:999px; font-size:.72rem; font-weight:700; color:#fff; font-variant-numeric:tabular-nums; white-space:nowrap; background:#64748b; }
  .deadline-left.band-urgent { background:#b91c1c; }
  .deadline-left.band-soon { background:#fde68a; color:#92400e; }
  .deadline-left.band-later { background:#1d4ed8; }
  .deadline-left.band-far { background:#64748b; }
  .deadline-left.band-past { background:#e2e8f0; color:#94a3b8; }
  .deadline-left:empty { display:none; }

  .cal-cell.is-linked { background:#dbeafe; box-shadow:inset 0 0 0 1px rgba(37,99,235,.55); }
  .cal-cell.is-linked .cal-num { color:#1d4ed8; }
  .deadline.is-linked { background:#dbeafe; }
  .deadline.is-linked .deadline-name, .deadline.is-linked .deadline-date { color:#1d4ed8; }

  .cards { display:grid; gap:14px; }
  .cards.three { grid-template-columns:repeat(3, minmax(0,1fr)); }
  .card { border:1px solid rgba(148,163,184,.16); border-radius:16px; background:#fff; padding:16px; }
  .card h3 { font-family:'Montserrat',sans-serif; font-size:.95rem; margin:0 0 8px; }
  .topics { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:5px; align-items:flex-start; }
  .topics li { font-size:.84rem; color:#475569; line-height:1.45; }
  .open-calls { margin-top:20px; }
  .open-calls.has-past { grid-template-columns:repeat(4, minmax(0,1fr)); }
  .past-card { border-style:dashed; }
  .past-item { display:grid; grid-template-columns:auto 46px minmax(0,1fr); align-items:baseline; gap:6px; }
  .past-item .dot { transform:translateY(-1px); }
  .past-when { font-weight:700; color:#94a3b8; font-variant-numeric:tabular-nums; }
  .past-card .topics li { color:#94a3b8; }
  .fineprint { margin:16px 0 0; font-size:.76rem; color:#94a3b8; line-height:1.5; }

  @media (max-width: 1100px) {
    .cals { grid-template-columns:repeat(2, minmax(0,1fr)); }
    .months { columns:2; }
    .cards.three, .open-calls.has-past { grid-template-columns:repeat(2, minmax(0,1fr)); }
  }
  @media (max-width: 720px) {
    .cals { grid-template-columns:1fr; }
    .months { columns:1; }
    .cards.three, .open-calls.has-past { grid-template-columns:1fr; }
  }
</style>
