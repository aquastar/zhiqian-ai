                  </tr>
                </thead>
                <tbody>
            {d.tableRows.map((c, i) => {
              const last = c.rates.length ? c.rates[c.rates.length - 1] : null;
              const stale = last && last.y < FRESH_FROM;
              return (<>
              <tr class={`tier-${c.tier}${c.live.expired ? ' is-spent' : ''}`}>
                <td class="c-name">
                  {/* Four lines, not six. The tier badge used to take a row of
                      its own and so did the two archive links, which left the
                      name competing with five siblings for attention. Name
                      first, then what it is, then when and where, then the
                      city note. */}
                  <span class="name-line">
                    {c.link
                      ? <a class="conf-name" href={c.link} target="_blank" rel="noopener">{c.title}</a>
                      : <span class="conf-name">{c.title}</span>}
                    {c.cycles > 1 && <span class="rounds-tag" title={c.roundLabels.join(' · ')}>{c.cycles}&times;</span>}
                    {c.notable && !c.society && c.badge && <span class="new-tag">{c.badge}</span>}
                    {c.society && <span class={`proc proc-${c.proceedings}`}>{PROC_TAG[c.proceedings] || PROC_TAG.none}</span>}
                  </span>
                  <span class="conf-desc">{c.desc}</span>
                  {c.note && <p class="why">{c.note}</p>}
                  <span class="ed-line">
                    {c.nextYear && !(c.date || '').includes(String(c.nextYear)) ? <span class="ed">{c.nextYear}</span> : null}
                    {c.date ? <span class="when">{c.date}</span> : <span class="none">not yet scheduled</span>}
                    {c.place && (
                      <a class="where" href={`https://www.tripadvisor.com/Search?q=${encodeURIComponent(c.place)}`}
                         target="_blank" rel="noopener" title={`Things to do in ${c.place}, on Tripadvisor`}>
                        {c.cc && <span class={`fi fi-${c.cc}`} aria-hidden="true"></span>}{c.place}
                        <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                      </a>
                    )}
                  </span>
                  {(c.dblp || c.best) && (
                    <span class="links">
                      {c.dblp && <a href={`${DBLP}/${c.dblp}/index.html`} target="_blank" rel="noopener" title="Every past edition's proceedings, on DBLP">proceedings</a>}
                      {c.best && <a href={`${BEST}#${c.best}`} target="_blank" rel="noopener" title="Best-paper awards since 1996, Jeff Huang's compilation">best papers</a>}
                    </span>
                  )}
                </td>
                <td class="c-date" data-label="Next deadline">
                  {/* Every cycle here has closed. The next one is a year on
                      from the last call, which is an estimate and is drawn as
                      one. Rendered on the server even when the row is still
                      live, so the browser can reveal it later in the week
                      without losing the scoped styles. */}
                  {c.live.key && (
                  <div class="round rolled" hidden={!c.live.expired}>
                    <span class="dl is-est">{c.live.key}</span>
                    <span class="dl-days" data-deadline={c.live.key}></span>
                    <span class="est-tag" title="This cycle has closed. Estimated by rolling the last call a year forward.">est.<i class="fas fa-circle-question" aria-hidden="true"></i></span>
                    <span class="round-label">next cycle, a year on from the last call</span>
                  </div>
                  )}
                  {c.rounds && c.rounds.some((r) => r.d >= TODAY)
                    ? <>
                        {roundWindow(c.rounds).map((r) => (
                          <div class="round">
                            {r.abs && (
                              <span class={`abs-line ${r.abs < TODAY ? 'is-past' : ''}`} data-abs={r.abs}
                                    title={`Abstract due ${r.abs}, ${Math.round((Date.parse(r.d) - Date.parse(r.abs)) / 86400000)} days before the paper`}>
                                <b>abstract</b><span class="abs-date">{r.abs}</span><span class="abs-days"></span>
                              </span>
                            )}
                            <span class={`dl ${r.est ? 'is-est' : ''}`}>{r.d}</span>
                            <span class="dl-days" data-deadline={r.d}></span>
                            {r.est && <span class="est-tag" title={`Not announced yet. Estimated by rolling last year's deadline (${r.from}) forward.`}>est.<i class="fas fa-circle-question" aria-hidden="true"></i></span>}
                            {r.label && !/^round\s*\d+$/i.test(r.label.trim()) &&
                              <span class="round-label">{r.label}</span>}
                          </div>
                        ))}
                        {c.rounds.filter((r) => r.d >= TODAY).length > roundWindow(c.rounds).length && (
                          <span class="round-more" title={c.rounds.filter((r) => r.d >= TODAY && !roundWindow(c.rounds).includes(r)).map((r) => r.d).join(', ')}>
                            +{c.rounds.filter((r) => r.d >= TODAY).length - roundWindow(c.rounds).length} more
                          </span>
                        )}
                      </>
                    : c.rounds && c.rounds.length
                    ? null
                    : c.nextDeadline
                    ? <div class="round">
                        <span class={`dl ${c.estimated ? 'is-est' : ''}`}>{c.nextDeadline}</span>
                        <span class="dl-days" data-deadline={c.nextDeadline}></span>
                        {c.estimated && <span class="est-tag" title={`Not announced yet. Estimated by rolling last year's deadline (${c.estFrom}) forward.`}>est.<i class="fas fa-circle-question" aria-hidden="true"></i></span>}
                      </div>
                    : <span class="none">date unavailable</span>}
                </td>
                {d.hasRate && (<td class="c-rate" data-label="Acceptance">
                  {last
                    ? <div class={`rate ${stale ? 'is-stale' : ''}`}>
                        <div class="rate-side">
                          <a class="rate-more" href={`${CSC}/${c.rateSlug}/`} target="_blank" rel="noopener" title="Full year-by-year history at the source">
                            {c.rates.length} yrs <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                          </a>
                          {stale && <span class="rate-stale-note">ends {last.y}</span>}
                        </div>
                        {/* The scale moves to the left margin. Five labels
                            need the whole right-hand side, and the axis
                            numbers were sitting in it. */}
                        {c.chart && (
                          <svg class="spark" viewBox={`-26 ${LABEL_ROWS[0] - 11} ${CHART.w + 60} ${CHART.h - LABEL_ROWS[0] + 24}`} role="img" aria-label={`Acceptance rate ${c.chart.span}`}>
                            <line x1="0" x2={CHART.w} y1={CHART.h} y2={CHART.h} class="base" />
                            {c.chart.grid.map((g) => (
                              <>
                                <line x1="0" x2={CHART.w} y1={g.y} y2={g.y} class="grid" />
                                <text x="-4" y={g.y + 3} class="glab" text-anchor="end">{g.v}</text>
                              </>
                            ))}
                            <path class="line" d={c.chart.d}
                                  style={`--len:${c.chart.len}; --delay:${(i % 7) * 0.45}s`} />
                            <circle class="dot" r="2.6"
                                    style={`offset-path:path('${c.chart.d}'); --delay:${(i % 7) * 0.45}s`} />
                            <circle class="dot-end" cx={c.chart.last.x} cy={c.chart.last.y} r="2.6" />
                            {c.chart.marks.map((m) => (
                              <>
                                <path class="mlead" d={`M${m.lx.toFixed(1)},${(m.ly + 2.5).toFixed(1)} L${m.x.toFixed(1)},${(m.y - 3.5).toFixed(1)}`} />
                                <circle class="mdot" cx={m.x} cy={m.y} r="2" />
                                <text class="mlab" x={m.lx} y={m.ly} text-anchor="middle">
                                  <tspan class="myr">'{m.yr}</tspan> {m.v}%
                                </text>
                              </>
                            ))}
                          </svg>
                        )}

                      </div>
                    : <span class="none">no published rate</span>}
                </td>)}
                {/* Same hand as the rate chart, its own axis. A rate cannot
                    tell a harder bar from a bigger pile. */}
                {d.hasSubs && (<td class="c-subs" data-label="Submissions">
                  {c.vol
                    ? <div class="rate">
                        <div class="rate-side">
                          <a class="rate-more" href={`${CSC}/${c.rateSlug}/`} target="_blank" rel="noopener" title="Submission counts year by year at the source, the same page the acceptance rate comes from">
                            {c.subs.length} yrs <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                          </a>
                        </div>
                        <svg class="spark spark-vol" viewBox={`-26 ${LABEL_ROWS[0] - 11} ${CHART.w + 60} ${CHART.h - LABEL_ROWS[0] + 24}`} role="img" aria-label={`Submissions ${c.vol.span}`}>
                          <line x1="0" x2={CHART.w} y1={CHART.h} y2={CHART.h} class="base" />
                          {c.vol.grid.map((g) => (
                            <>
                              <line x1="0" x2={CHART.w} y1={g.y} y2={g.y} class="grid" />
                              <text x="-4" y={g.y + 3} class="glab" text-anchor="end">{g.v}</text>
                            </>
                          ))}
                          <path class="line" d={c.vol.d}
                                style={`--len:${c.vol.len}; --delay:${(i % 7) * 0.45 + 0.2}s`} />
                          <circle class="dot" r="2.6"
                                  style={`offset-path:path('${c.vol.d}'); --delay:${(i % 7) * 0.45 + 0.2}s`} />
                          <circle class="dot-end" cx={c.vol.last.x} cy={c.vol.last.y} r="2.6" />
                          {c.vol.marks.map((m) => (
                            <>
                              <path class="mlead" d={`M${m.lx.toFixed(1)},${(m.ly + 2.5).toFixed(1)} L${m.x.toFixed(1)},${(m.y - 3.5).toFixed(1)}`} />
                              <circle class="mdot" cx={m.x} cy={m.y} r="2" />
                              <text class="mlab" x={m.lx} y={m.ly} text-anchor="middle">
                                <tspan class="myr">'{m.yr}</tspan> {m.v}
                              </text>
                            </>
                          ))}
                        </svg>
                      </div>
                    : <span class="none">no published count</span>}
                </td>)}
                {d.rankCol && (<td class="c-rank" data-label="Ranking">{d.rank === 'ccf' ? (<>
                  {c.society
                    ? <span class="eqv eqv-none">{PROC_WHY[c.proceedings] || PROC_WHY.none}</span>
                    : c.notable && c.area === 'Control'
                    ? <span class="none" title="CCF and CORE catalogue computing, not control">outside<br />CCF and CORE</span>
                    : c.notable
                    ? <span class="none">not ranked</span>
                    : <span class="ranks">
                        <span class={`pill ccf-${c.ccf.toLowerCase()}`} title="CCF catalogue">CCF {c.ccf === 'N' ? 'n/a' : c.ccf}</span>
                        <span class={`pill ${coreClass(c.core)}`} title={c.coreVerified ? 'Confirmed against the official CORE2023 export' : 'Not found in the official CORE2023 export'}>CORE {coreLabel[c.core]}</span>
                        {c.csr
                          ? <a class="pill csr-yes" href={CSR} target="_blank" rel="noopener" title={`Counted by CSRankings, under ${c.csr}`}>CSRanking</a>
                          : <span class="pill csr-no" title="Not on the CSRankings venue list">no CSRanking</span>}
                      </span>}
                </>) : (<>
                  <span class="ranks">
                    {c.frank && <span class="pill frank" title="How the field itself ranks it">{c.frank}</span>}
                    {c.ccf !== 'N' && <span class={`pill ccf-${c.ccf.toLowerCase()}`} title="CCF catalogue">CCF {c.ccf}</span>}
                    {c.core !== 'N' && c.core !== 'TBR' && <span class={`pill ${coreClass(c.core)}`} title="CORE2023">CORE {coreLabel[c.core]}</span>}
                    {!c.frank && c.ccf === 'N' && (c.core === 'N' || c.core === 'TBR') && <span class="none">unranked</span>}
                  </span>
                </>)}</td>)}
              </tr>
              {c.title === 'ICLR' && topicBlocks.map((b) => (
                <tr class="sub-row">
                  <td class="sub-cell" colspan={2 + (d.hasRate ? 1 : 0) + (d.hasSubs ? 1 : 0) + (d.rankCol ? 1 : 0)}>
                    <details class="rest topics lead">
          <summary>
            <h2>Which topics get in</h2>
            <span class="rest-count">{b.venue} {b.year}</span>
            <span class="rest-note">
            {b.submitted.toLocaleString()} submitted, {b.accepted.toLocaleString()} accepted, {b.headline}% overall
          </span>
          </summary>
          <div class="tchart-wrap">
            <div class="tchart-scroll">
            <svg class="tchart" viewBox={`0 0 ${TC.w} ${TC.base + 26}`} role="img"
                 aria-label={`Acceptance rate by topic, ${b.venue} ${b.year}`}>
              {b.chart.grid.map((g) => (
                <>
                  <line x1={TC.left} x2={TC.w - 6} y1={g.y} y2={g.y} class={g.v === 0 ? 'tc-base' : 'tc-grid'} />
                  <text x={TC.left - 6} y={g.y + 3} class="tc-glab" text-anchor="end">{g.v}%</text>
                </>
              ))}
              {b.chart.bars.map((t, k) => (
                <g class={`tc-bar tone-${t.tone}`} data-topic={k} tabindex="0" role="button"
                   aria-label={`${t.area}, ${t.rate} percent of ${t.n} submissions accepted`}>
                  <title>{`${t.area}
${t.rate}% accepted, ${t.n.toLocaleString()} submissions, ${t.share}% of the edition`}</title>
                  {/* The hit area covers the label too, so a one percent
                      topic is still something you can point at. */}
                  <rect class="tc-hit" x={t.x} y={TC.top} width={t.w} height={TC.base - TC.top} />
                  <rect class="tc-fill" x={t.x} y={t.y} width={t.w} height={t.h} rx="2" />
                  <path class="tc-lead" d={`M${(t.anchor === 'end' ? t.lx - 2 : t.lx + 2).toFixed(1)},${(t.ly + 4).toFixed(1)} L${t.cx.toFixed(1)},${(t.y - 3).toFixed(1)}`} />
                  <text class="tc-lab" x={t.lx} y={t.ly} text-anchor={t.anchor}>
                    <tspan class="tc-pct">{t.head}</tspan>{t.name}<tspan class="tc-sub">{t.tail}</tspan>
                  </text>
                </g>
              ))}
              <text class="tc-axis" x={TC.left} y={TC.base + 20}>bar width is the topic's share of submissions, so a bar's area is the papers it took. Each label reads rate, topic, submissions.</text>
            </svg>
            </div>
            {b.rows.map((t) => (
              t.papers && (
                <div class="tpop" data-pop hidden>
                  <div class="tpop-head">
                    <b>{t.area}</b>
                    <span>{t.rate}% of {t.n.toLocaleString()} &middot; {t.papers.length} most cited</span>
                    <button type="button" class="tpop-x" aria-label="Close">&times;</button>
                  </div>
                  <ol class="t-papers tpop-list">
                    {t.papers.map((pp) => (
                      <li>
                        <span class="pp-n"></span>
                        <span class="pp-c" title="Google Scholar citations">{pp.c}</span>
                        <span class={`pp-k pp-${pp.k.toLowerCase()}`}>{pp.k}</span>
                        <span class="pp-y">{pp.y}</span>
                        {pp.u ? <a href={pp.u} target="_blank" rel="noopener">{pp.t}</a> : <span>{pp.t}</span>}
                      </li>
                    ))}
                  </ol>
                </div>
              )
            ))}
            <p class="tchart-note">Click a topic for its {b.rows[0] && b.rows[0].papers ? b.rows[0].papers.length : 10} most cited papers.</p>
          </div>
        </details>
                  </td>
                </tr>
              ))}
              </>
            );})}
                </tbody>
              </table>
            </div>
            {d.id === 'ai' && (
              <p class="area-note">
                Acceptance rates: {totalRated} of {rows.length} venues publish one, and {freshRated} of those are {FRESH_FROM} or later.
                The rest are labeled with the year they stop. Main track only, with Findings and workshops excluded.
              </p>
            )}
          </div>
        ) : (
          <div class="section">
            <h2 class="kind-head">Meetings</h2>
            <div class="society-grid">
              {d.cards.map((c) => (
          <article class="soc-card">
            <header class="soc-head">
              <h3>
                {c.link ? <a href={c.link} target="_blank" rel="noopener">{c.title}</a> : c.title}
              </h3>
              <span class={`proc proc-${c.proceedings}`}>{PROC_TAG[c.proceedings] || PROC_TAG.none}</span>
            </header>
            <p class="soc-desc">{c.desc}</p>
            {/* Three labels in place of the paragraph that used to sit here:
                the field, how often it runs and whether it leads that field,
                and why it is on this list at all. The paragraph is still
                written, and is the tooltip on the third one. */}
            <ul class="soc-tags">
              {c.field && <li class="st-field">{c.field}</li>}
              {c.kind && <li class={`st-kind ${/flagship/.test(c.kind) ? 'is-top' : ''}`}>{c.kind}</li>}
              {c.why && <li class="st-why" title={c.note || ''}>{c.why}</li>}
            </ul>
            <dl class="soc-facts">
              <div>
                <dt>Deadline</dt>
                <dd>
                  {c.live.key
                    ? <span class="soc-when">
                        <span class={`dl ${c.estimated ? 'is-est' : ''}`}>{c.live.key}</span>
                        <span class="dl-days" data-deadline={c.live.key}></span>
                      </span>
                    : <span class="none">not announced</span>}
                </dd>
              </div>
              <div>
                <dt>Meeting</dt>
                <dd>{c.date || <span class="none">not scheduled</span>}</dd>
              </div>
              <div>
                <dt>Where</dt>
                <dd>{c.place
                  ? <span class="soc-place">{c.cc && <span class={`fi fi-${c.cc}`} aria-hidden="true"></span>}{c.place}</span>
                  : <span class="none">not announced</span>}</dd>
              </div>
            </dl>
          </article>
        ))}
            </div>
          </div>
        )}

        {d.journals.length > 0 && (d.format === 'table' ? (
          <div class="section jrnl-section">
            <h2 class="kind-head">Journals</h2>
            <div class="table-wrap">
              <table class="confs jrnl-table">
                <thead>
                  <tr>
                    <th class="j-name">Journal</th>
                    <th class="j-why">What it is for</th>
                    <th class="j-subs">Papers per year</th>
                    <th class="j-cite" title="Mean citations in the last two years to papers from the two years before, on OpenAlex. The impact factor's formula on an open index.">Citations / paper</th>
                    <th class="j-h">h-index</th>
                    {d.jRank && <th class="c-rank">Rank</th>}
                  </tr>
                </thead>
                <tbody>
            {d.journals.map((j, i) => (
              <tr>
                <td class="j-name">
                  <span class="name-line">
                    {j.link
                      ? <a class="conf-name" href={j.link} target="_blank" rel="noopener" title="Every volume, on DBLP">{j.title}</a>
                      : <span class="conf-name">{j.title}</span>}
                  </span>
                  <span class="conf-desc">{j.name}</span>
                  <span class="conf-desc j-pub">{j.pub}</span>
                </td>
                <td class="j-why" data-label="What it is for">{j.why}</td>
                <td class="j-subs" data-label="Papers per year">
                  {j.vol
                    ? <svg class="spark spark-vol" viewBox={`-26 ${LABEL_ROWS[0] - 11} ${CHART.w + 60} ${CHART.h - LABEL_ROWS[0] + 24}`} role="img" aria-label={`Papers per year ${j.vol.span}`}>
                        <line x1="0" x2={CHART.w} y1={CHART.h} y2={CHART.h} class="base" />
                        {j.vol.grid.map((g) => (
                          <>
                            <line x1="0" x2={CHART.w} y1={g.y} y2={g.y} class="grid" />
                            <text x="-4" y={g.y + 3} class="glab" text-anchor="end">{g.v}</text>
                          </>
                        ))}
                        <path class="line" d={j.vol.d} style={`--len:${j.vol.len}; --delay:${(i % 7) * 0.45}s`} />
                        <circle class="dot" r="2.6" style={`offset-path:path('${j.vol.d}'); --delay:${(i % 7) * 0.45}s`} />
                        <circle class="dot-end" cx={j.vol.last.x} cy={j.vol.last.y} r="2.6" />
                        {j.vol.marks.map((m) => (
                          <>
                            <path class="mlead" d={`M${m.lx.toFixed(1)},${(m.ly + 2.5).toFixed(1)} L${m.x.toFixed(1)},${(m.y - 3.5).toFixed(1)}`} />
                            <circle class="mdot" cx={m.x} cy={m.y} r="2" />
                            <text class="mlab" x={m.lx} y={m.ly} text-anchor="middle"><tspan class="myr">'{m.yr}</tspan> {m.v}</text>
                          </>
                        ))}
                      </svg>
                    : <span class="none">not indexed by OpenAlex</span>}
                </td>
                <td class="j-cite" data-label="Citations / paper">
                  {j.cites != null ? <span class="j-num">{j.cites.toFixed(1)}</span> : <span class="none">n/a</span>}
                </td>
                <td class="j-h" data-label="h-index">
                  {j.h != null ? <span class="j-num j-num-soft">{j.h}</span> : <span class="none">n/a</span>}
                </td>
                {d.jRank && (<td class="c-rank" data-label="Ranking">
                  <span class="ranks">
                    {j.rank && <span class="pill frank">{j.rank}</span>}
                    {(d.rank === 'ccf' || j.ccf !== 'N') && <span class={`pill ccf-${j.ccf.toLowerCase()}`} title="CCF catalogue, journal list">CCF {j.ccf === 'N' ? 'n/a' : j.ccf}</span>}
                  </span>
                </td>)}
              </tr>
            ))}
                </tbody>
              </table>
            </div>
          </div>
        ) : (
          <div class="section jrnl-section">
            <h2 class="kind-head">Journals</h2>
            {/* In these fields the journal is the paper that counts, so the
                list leads with what each one is for and how much it is cited,
                in a compact grid rather than a wide table. */}
            <ul class="jlist">
              {d.journals.map((j) => (
                <li>
                  <div class="jl-top">
                    {j.link ? <a class="jl-name" href={j.link} target="_blank" rel="noopener">{j.title}</a> : <span class="jl-name">{j.title}</span>}
                    {j.rank && <span class="pill frank">{j.rank}</span>}
                    {d.citations !== false && j.cites != null && <span class="jl-cite" title="Two-year citations per paper, OpenAlex">{j.cites.toFixed(1)}<small>cites / paper</small></span>}
                  </div>
                  <span class="jl-full">{j.name} &middot; {j.pub}</span>
                  <span class="jl-why">{j.why}</span>
                  {j.subs.length > 0 && <span class="jl-out">{j.subs[j.subs.length - 1].n.toLocaleString()} papers in {j.subs[j.subs.length - 1].y}{d.citations !== false && j.h != null && <> &middot; h-index {j.h}</>}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}
    <p class="area-note jrnl-foot">
      Journal output and citations from OpenAlex, refreshed weekly. Citations per paper is the impact factor's formula on an
      open index, so it runs close to the JCR figure without being it; survey journals score high by construction.
      Meeting dates are read off each venue's own site; a date marked est. is last year's rolled forward.
    </p>

    <section class="section sources">
      <h2 class="area-head">Where all of this comes from</h2>
      <ul class="src-list">
        <li>
          <a href="https://github.com/ccfddl/ccf-deadlines" target="_blank" rel="noopener">ccf-deadlines</a>
          <span>CCF ranks, deadlines, rounds, dates, cities</span>
        </li>
        <li>
          <a href="https://portal.core.edu.au/conf-ranks/" target="_blank" rel="noopener">CORE Portal</a>
          <span>CORE ranks, from the official CORE2023 export</span>
        </li>
        <li>
          <a href="https://csconfstats.xoveexu.com/conferences/" target="_blank" rel="noopener">CS Conf Stats</a>
          <span>Acceptance rates, accepted and submitted counts</span>
        </li>
        <li>
          <a href="https://openalex.org/" target="_blank" rel="noopener">OpenAlex</a>
          <span>Journal output and citations, and the most published topics per field</span>
        </li>
        <li>
          <a href="https://github.com/papercopilot/paperlists" target="_blank" rel="noopener">paperlists</a>
          <span>Per-topic acceptance, from every ICLR submission</span>
        </li>
        <li>
          <a href="https://csrankings.org/" target="_blank" rel="noopener">CSRankings</a>
          <span>Which venues it counts, and under which area</span>
        </li>
        <li>
          <a href="https://jeffhuang.com/best_paper_awards/" target="_blank" rel="noopener">Best Paper Awards</a>
          <span>Award winners since 1996, for 16 of these venues</span>
        </li>
        <li>
          <a href="https://dblp.org/" target="_blank" rel="noopener">DBLP</a>
          <span>Every past edition's proceedings</span>
        </li>
        <li>
          <a href="https://scholar.google.com/citations?view_op=top_venues&hl=en" target="_blank" rel="noopener">Scholar Metrics</a>
          <span>h5-index per field, linked not imported</span>
        </li>
        <li>
          <span class="src-plain">Official conference sites</span>
          <span>The venues neither ranking table covers, kept by hand</span>
        </li>
      </ul>
      <p class="src-note">
        <b>Updated automatically every day.</b> At 06:17 UTC a GitHub Action re-fetches all of the above and
        rebuilds the ranks, deadlines, rounds and acceptance rates, committing only when something changed; on
        Mondays it also checks each venue's own site and audits the hand-kept dates. The most published topics and
        their papers rotate, one field a day, so each is refreshed about monthly. The venues neither ranking table
        covers, the journal lists and the field notes are kept by hand.
      </p>
    </section>
  </main>
</Layout>

<style>
.container { max-width: min(95vw, 1600px); margin: 0 auto; padding: 20px; box-sizing: border-box; }
  /* The right-hand group of the nav starts here. Conferences only joins it on
     the agenda side of the site, where it is the thing a reader wants next. */
  /* Only this item moves. margin-left:auto pushes it to the far right
     and leaves every other nav link exactly where it was. */
  .head { margin-bottom: 12px; }
  .head-row { display:flex; align-items:flex-start; justify-content:space-between; gap:28px; flex-wrap:wrap; }
  .head-text { flex:1 1 440px; min-width:0; }
  h1 { font-size: 1.9rem; margin: 0 0 6px; letter-spacing: -.02em; }
  .sub { margin: 0; color: #475569; font-size: .92rem; line-height: 1.6; max-width: 62ch; }

  /* Field filter, top-right. */
  /* One straight row. The labels are short enough to fit, and wrapping them
     into three ragged lines made the header look heavier than the table. */
  .filter { display:flex; flex-wrap:nowrap; gap:6px; align-items:center;
    justify-content:flex-start; overflow-x:auto; scrollbar-width:none; }
  .filter::-webkit-scrollbar { display:none; }
  .scholar-link[hidden] { display:none; }
  .scholar-link { flex:0 0 auto; display:inline-flex; align-items:center; gap:5px;
    font-size:.72rem; font-weight:700; color:#475569; text-decoration:none; white-space:nowrap;
    border:1px solid rgba(148,163,184,.45); border-radius:999px; padding:5px 11px; background:#fff; }
  .scholar-link:hover { color:var(--accent); border-color:rgba(37,99,235,.5); }
  .fbtn { flex:0 0 auto; display:inline-flex; white-space:nowrap; align-items:center; gap:6px; padding:5px 11px; border-radius:999px; cursor:pointer;
    border:1px solid rgba(148,163,184,.4); background:#fff; color:#475569; font:inherit; font-size:.76rem; font-weight:600;
    transition:background .15s ease, border-color .15s ease, color .15s ease; }
  .fbtn:hover { border-color:rgba(37,99,235,.45); color:var(--accent); }
  .fbtn.is-on { background:#1e293b; border-color:#1e293b; color:#fff; }
  .fcount { font-size:.68rem; font-weight:700; opacity:.6; }
  .fbtn.is-on .fcount { opacity:.75; }

  .legend-wrap { position:relative; display:inline-block; margin-top:8px; }
  .legend-wrap[hidden] { display:none; }
  .legend-btn { display:inline-flex; align-items:center; gap:6px; cursor:help; font:inherit;
    font-size:.7rem; font-weight:600; color:#64748b; background:#fff; padding:3px 10px;
    border:1px solid rgba(148,163,184,.4); border-radius:999px; }
  .legend-btn i { font-size:.72rem; color:#94a3b8; }
  .legend-wrap:hover .legend-btn, .legend-wrap:focus-within .legend-btn { color:var(--accent); border-color:rgba(37,99,235,.45); }
  .legend { list-style:none; margin:0; padding:9px 13px; display:none; flex-wrap:wrap; gap:9px 16px;
    font-size:.74rem; color:#475569;
    position:absolute; z-index:25; top:calc(100% + 6px); left:0; width:max-content; max-width:min(560px, 86vw);
    background:#fff; border:1px solid rgba(148,163,184,.45); border-radius:11px;
    box-shadow:0 12px 28px rgba(15,23,42,.16); }
  .legend-wrap:hover .legend, .legend-wrap:focus-within .legend, .legend-wrap.is-open .legend { display:flex; }
  .legend li { display:inline-flex; align-items:center; gap:6px; }
  .legend .abs-line { flex:0 0 auto; margin:0; }
  .legend strong { font-weight:700; color:#1e293b; }
  .legend-gap { margin-left:10px; }
    .chip { width:11px; height:11px; border-radius:3px; display:inline-block; }
  .chip.band-urgent { background:#dc2626; } .chip.band-soon { background:#1d4ed8; }
  .chip.band-far { background:#64748b; }

  .section { margin-top: 16px; }

  /* Groups, then fields. The group row is quiet; the field chips carry the
     field's own hue, which also tints its section. */
  /* The field directory. Captions are quiet, fields are light text buttons
     with their hue on the icon, and only the open field is filled. */
  .picker { position:relative; margin-bottom:12px; }
  .dir { display:flex; flex-direction:column; gap:4px; min-width:0; }
  .dir-group { display:flex; align-items:baseline; gap:2px; }
  /* Wrapped fields stay in the fields column instead of running back under
     the captions. */
  .dir-chips { flex:1; min-width:0; display:flex; flex-wrap:wrap; gap:2px; }
  .dir-label { flex:0 0 128px; font-family:'Montserrat',sans-serif; font-size:.6rem; font-weight:700; letter-spacing:.09em;
    text-transform:uppercase; color:#94a3b8; white-space:nowrap; }
  .dchip { display:inline-flex; align-items:center; gap:5px; padding:4px 9px; border:0; border-radius:999px;
    background:transparent; color:#334155; font-size:.8rem; font-weight:600; white-space:nowrap; cursor:pointer; }
  .dchip i { color:var(--hue); font-size:.76rem; }
  .dchip .fcount { color:#a3adbb; font-size:.66rem; font-weight:700; }
  .dchip:hover { background:#f1f5f9; }
  .dchip.is-on { background:var(--hue); color:#fff; }
  .dchip.is-on i, .dchip.is-on .fcount { color:rgba(255,255,255,.85); }
  /* Their own line under the directory, right-aligned: no row is reliably
     short enough to host them, and floating them over one hid a field. */
  .side { display:flex; gap:6px; align-items:center; justify-content:flex-end; margin-top:6px; }
  @media (max-width: 900px) {
    .side { justify-content:flex-start; margin-top:10px; }
    .dir-group { flex-wrap:wrap; }
    .dir-label { flex-basis:100%; margin:6px 0 1px; }
  }
  .dom[hidden], .jrnl-foot[hidden] { display:none !important; }
  .pill.honor { background:#fefce8; color:#854d0e; border:1px solid #fde68a; min-width:0; white-space:normal; text-align:left; }
  .dest-field { display:inline-block; margin-top:3px; font-size:.64rem; font-weight:700; letter-spacing:.04em; color:#64748b;
    background:#f1f5f9; border-radius:4px; padding:1px 6px; }
  .dest-table .c-rank { white-space:normal; width:16%; }
  .dom .field-note { border-left-color:var(--hue); }
  .pill.frank { background:color-mix(in srgb, var(--hue, #334155) 14%, white); color:var(--hue, #334155);
    border:1px solid color-mix(in srgb, var(--hue, #334155) 35%, white); min-width:0; text-transform:none; }

  /* Security: a year of cycles at a glance. */
  .cycles { margin-bottom:14px; }
  .cyc-grid { display:grid; grid-template-columns:120px repeat(var(--n), minmax(0,1fr)); gap:3px; align-items:center; }
  .cyc-m { font-size:.66rem; font-weight:700; color:#94a3b8; text-align:center; text-transform:uppercase; letter-spacing:.05em; }
  .m-short { display:none; }
  .cyc-m em { display:block; font-style:normal; font-weight:600; color:#cbd5e1; }
  .cyc-v { font-size:.82rem; font-weight:700; color:#0f172a; }
  .cyc-cell { min-height:28px; border-radius:6px; background:#f8fafc; display:flex; gap:3px; align-items:center; justify-content:center; }
  .cyc-dot { min-width:22px; height:22px; border-radius:999px; background:var(--hue); color:#fff; font-size:.68rem; font-weight:800;
    display:inline-flex; align-items:center; justify-content:center; padding:0 4px; }
  .cyc-dot.is-est { background:#fff; color:var(--hue); border:1.5px dashed var(--hue); }

  .trends { margin-bottom:16px; }
  .trend-list { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); column-gap:28px; row-gap:4px; counter-reset:tr;
    grid-auto-flow:column; grid-template-rows:repeat(10, auto); }
  .trend-list button.tr-name { border:0; background:none; padding:0; font:inherit; font-size:.8rem; cursor:pointer; }
  .trend-list button.tr-name:disabled { cursor:default; color:#64748b; }
  .trend-list li.is-on button.tr-name { color:var(--hue); font-weight:700; }
  .area-note.trends-note { max-width:none; }
  .tr-papers { margin:12px 0 4px; border:1px solid color-mix(in srgb, var(--hue) 30%, white); border-radius:12px; padding:10px 14px; background:#fff; }
  .tr-papers[hidden] { display:none; }
  .trp-head { display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; margin-bottom:6px; }
  .trp-title { font-size:.92rem; color:#0f172a; }
  .trp-sub { font-size:.7rem; color:#94a3b8; }
  .trp-oa { margin-left:auto; font-size:.72rem; color:var(--accent); text-decoration:none; }
  .trp-x { border:0; background:none; font-size:1.2rem; line-height:1; color:#94a3b8; cursor:pointer; }
  .trp-list { margin:0; padding:0 0 0 22px; display:grid; gap:6px; }
  /* The list items are made by the script, so they carry no scope attribute
     and these rules have to reach them as global. */
  .trp-list :global(li) { font-size:.8rem; color:#334155; line-height:1.4; text-align:left; }
  .trp-list :global(a) { color:#0f172a; font-weight:600; text-decoration:none; }
  .trp-list :global(a:hover) { color:var(--accent); text-decoration:underline; }
  .trp-list :global(.trp-meta) { display:block; font-size:.7rem; color:#94a3b8; }
  .sub-row td.sub-cell { padding:0 8px 10px; }
  .sub-row .rest.topics { margin:0; }
  .trend-list li { display:grid; grid-template-columns:18px minmax(0,1.4fr) minmax(60px,1fr) 44px 46px; align-items:center; gap:8px; counter-increment:tr; }
  .trend-list li::before { content:counter(tr); font-size:.68rem; font-weight:800; color:#a3adbb; text-align:right; }
  .tr-name { font-size:.8rem; color:#1e293b; text-decoration:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; text-align:left; }
  .tr-name:hover { color:var(--accent); text-decoration:underline; }
  .tr-bar { height:8px; border-radius:999px; background:#f1f5f9; overflow:hidden; }
  .tr-bar span { display:block; height:100%; border-radius:999px; background:var(--hue); opacity:.75; }
  .tr-n { font-size:.74rem; font-weight:700; color:#334155; text-align:right; font-variant-numeric:tabular-nums; }
  .tr-g { font-size:.66rem; font-weight:800; text-align:center; border-radius:999px; padding:1px 0; color:#64748b; background:#f1f5f9; font-variant-numeric:tabular-nums; }
  .tr-g.is-up { color:#166534; background:#dcfce7; }
  .tr-g.is-down { color:#991b1b; background:#fee2e2; }
  .tr-g.is-new { color:#1d4ed8; background:#dbeafe; }
  @media (max-width: 900px) {
    .trend-list { grid-template-columns:1fr; grid-auto-flow:row; grid-template-rows:none; row-gap:8px; }
    .trp-oa { margin-left:0; }
    .trend-list li { grid-template-columns:18px minmax(0,1fr) 44px 46px; grid-template-areas:'num name name name' '. bar n g'; row-gap:3px; }
    .trend-list li::before { grid-area:num; }
    .tr-name { grid-area:name; white-space:normal; }
    .tr-bar { grid-area:bar; } .tr-n { grid-area:n; } .tr-g { grid-area:g; }
  }
  .ts-stat { margin-bottom:14px; }
  .ts-line { margin:0; font-size:.88rem; color:#334155; line-height:1.6; text-align:left; }
  .ts-line b { font-size:1.15rem; color:var(--hue); }

  /* Journals in the journal-led fields: a compact grid of cards. */
  .jlist { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:10px; }
  .jlist li { border:1px solid rgba(148,163,184,.3); border-radius:12px; padding:10px 12px; background:#fff; display:flex; flex-direction:column; gap:3px; text-align:left; }
  .jl-top { display:flex; align-items:center; gap:7px; }
  .jl-name { font-weight:800; color:#0f172a; text-decoration:none; font-size:.92rem; }
  a.jl-name:hover { color:var(--accent); text-decoration:underline; }
  .jl-cite { margin-left:auto; font-weight:800; font-size:1rem; color:#0f172a; font-variant-numeric:tabular-nums; text-align:right; line-height:1.1; }
  .jl-cite small { display:block; font-size:.58rem; font-weight:600; color:#94a3b8; }
